{
  "name": "knirv-controller",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-speech-recognition": "^8.1.7",
    "@hono/zod-validator": "^0.5.0",
    "@knirv/sdk": "file:../KNIRVSDK/ts/unified",
    "capacitor-barcode-scanner": "^8.0.0",
    "hono": "4.7.7",
    "html5-qrcode": "^2.3.8",
    "knirvwallet-module": "file:core/packages/knirvwallet-module",
    "lucide-react": "^0.510.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^7.5.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@cloudflare/vite-plugin": "^1.9.6",
    "@eslint/js": "9.25.1",
    "@getmocha/users-service": "^0.0.4",
    "@getmocha/vite-plugins": "latest",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.14.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/testing-library__react": "^10.0.1",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "9.25.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "selfsigned": "^5.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.0",
    "vite": "6.3.2",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.25.0"
  },
  "scripts": {
    "start": "vite",
    "start:pwa": "vite --host 0.0.0.0 --port 4173",
    "start:pwa:https": "node scripts/start-pwa-https.mjs",
    "start:mobile": "node scripts/start-pwa-https.mjs",
    "preview:pwa": "vite preview --host 0.0.0.0 --port 4173",
    "preview:pwa:https": "node scripts/preview-pwa-https.mjs",
    "build": "tsc -b && vite build",
    "release:mobile": "node scripts/release-native.mjs",
    "release:mobile:upload": "node scripts/release-native.mjs --upload-only",
    "release:mobile:upload:android": "node scripts/release-native.mjs --upload-only --android-only",
    "release:mobile:upload:ios": "node scripts/release-native.mjs --upload-only --ios-only",
    "release:android": "node scripts/release-native.mjs --android-only",
    "release:ios": "node scripts/release-native.mjs --ios-only",
    "release:ios:unsigned": "node scripts/release-native.mjs --ios-only --no-upload --skip-sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync && node scripts/fix-android-java-target.mjs",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cf-typegen": "wrangler types",
    "check": "tsc && vite build && wrangler deploy --dry-run",
    "dev": "vite",
    "lint": "eslint ."
  }
}
