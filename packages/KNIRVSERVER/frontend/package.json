{
  "name": "nexus_portal",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.cjs",
    "dev:watch": "nodemon server.cjs",
    "build": "npm run build:log:start && next build && npm run build:log:success",
    "start": "NODE_ENV=production node server.cjs 2>&1 | tee server.log",
    "build:log:start": "node scripts/build-log-start.mjs",
    "build:log:success": "node scripts/build-log-success.mjs",
    "lint": "next lint",
    "analyze": "ANALYZE=true next build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run lint && npm run type-check && npm run test:ci && npm run test:e2e",
    "type-check": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
