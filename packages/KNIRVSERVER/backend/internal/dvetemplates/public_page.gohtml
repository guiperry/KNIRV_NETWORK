{{ define "public_page.gohtml" }}{{ template "header" . }}{{ template "content" . }}{{ end }}

{{ define "header" }}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DVE File Manager — {{ .DVEID }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            height: 100%;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0a0e17;
            color: #e0e0ff;
        }
        .dve-file-manager {
            display: flex;
            flex-direction: column;
            height: 100%;
            background-color: #0a0e17;
            color: #e0e0ff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        /* Header */
        .header {
            background: rgba(16, 24, 48, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(100, 130, 255, 0.2);
            padding: 12px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            z-index: 10;
        }
        .header-left { display: flex; align-items: center; gap: 15px; }
        .logo { display: flex; flex-direction: column; }
        .logo h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            background: linear-gradient(90deg, #64b5f6, #9575cd);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1px;
        }
        .subtitle {
            font-size: 12px;
            color: #a0a0d0;
            margin-top: 2px;
        }
        .badge-row { display: flex; gap: 6px; flex-wrap: wrap; }
        .badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 10px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .badge-online { background: rgba(76,175,80,0.15); color: #81c784; border: 1px solid rgba(76,175,80,0.3); }
        .badge-offline { background: rgba(244,67,54,0.15); color: #e57373; border: 1px solid rgba(244,67,54,0.3); }
        .badge-active { background: rgba(100,130,255,0.15); color: #90caf9; border: 1px solid rgba(100,130,255,0.3); }
        .badge-tee { background: rgba(156,39,176,0.15); color: #ce93d8; border: 1px solid rgba(156,39,176,0.3); }
        .nav-links { display: flex; gap: 6px; }
        .nav-links button {
            background: rgba(30, 40, 70, 0.5);
            border: 1px solid rgba(100, 130, 255, 0.3);
            color: #b0b0ff;
            padding: 7px 14px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 13px;
        }
        .nav-links button:hover {
            background: rgba(40, 60, 100, 0.7);
            border-color: rgba(120, 150, 255, 0.5);
        }
        .nav-links button.active {
            background: rgba(60, 80, 170, 0.7);
            border-color: rgba(140, 170, 255, 0.7);
            color: white;
        }
        /* HUD buttons for iframe navigation */
        .hud-buttons { display: flex; gap: 4px; }
        .hud-btn {
            background: rgba(60, 80, 170, 0.25);
            border: 1px solid rgba(100, 130, 255, 0.25);
            color: #b0b0ff;
            width: 30px;
            height: 30px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            line-height: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }
        .hud-btn:hover {
            background: rgba(80, 110, 220, 0.4);
            border-color: rgba(140, 170, 255, 0.5);
            color: white;
        }
        .hud-close:hover {
            background: rgba(220, 60, 60, 0.3);
            border-color: rgba(255, 100, 100, 0.4);
            color: #ff6b6b;
        }
        .header-divider {
            width: 1px;
            height: 28px;
            background: rgba(100, 130, 255, 0.2);
            margin: 0 8px;
        }
        /* Main Content */
        .main-content {
            display: flex;
            flex: 1;
            overflow: hidden;
        }
        /* Sidebar */
        .sidebar {
            width: 320px;
            background: rgba(20, 30, 60, 0.7);
            backdrop-filter: blur(10px);
            border-right: 1px solid rgba(100, 130, 255, 0.2);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .sidebar-header {
            padding: 12px 15px;
            border-bottom: 1px solid rgba(100, 130, 255, 0.2);
        }
        .sidebar-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
            color: #d0d0ff;
        }
        .list-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 15px;
            border-bottom: 1px solid rgba(100, 130, 255, 0.1);
        }
        .list-header h4 {
            margin: 0;
            font-size: 14px;
            font-weight: 500;
        }
        .count {
            background: rgba(60, 80, 170, 0.3);
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11px;
            color: #b0b0ff;
        }
        .object-list, .transaction-list {
            display: flex;
            flex-direction: column;
            flex: 1;
            overflow: hidden;
        }
        .objects-container, .transactions-container, .records-container {
            overflow-y: auto;
            padding: 10px;
            flex: 1;
        }
        .object-item {
            background: rgba(30, 40, 80, 0.5);
            border: 1px solid rgba(100, 130, 255, 0.2);
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .object-item:hover {
            background: rgba(40, 60, 120, 0.6);
            border-color: rgba(120, 150, 255, 0.4);
            transform: translateY(-1px);
        }
        .object-item.active {
            background: rgba(60, 90, 200, 0.4);
            border-color: rgba(140, 170, 255, 0.6);
            box-shadow: 0 0 15px rgba(100, 130, 255, 0.3);
        }
        .object-name { font-weight: 500; display: block; margin-bottom: 3px; font-size: 13px; }
        .object-type {
            font-size: 11px;
            color: #8080c0;
            background: rgba(60, 80, 170, 0.2);
            padding: 2px 6px;
            border-radius: 4px;
            display: inline-block;
        }
        .object-meta { font-size: 11px; color: #7070a0; margin-top: 3px; display: block; }
        .empty-state {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 80px;
            color: #6060a0;
            font-style: italic;
            font-size: 13px;
        }
        /* Upload / Validation Section */
        .section {
            padding: 12px 15px;
            border-top: 1px solid rgba(100, 130, 255, 0.2);
            background: rgba(25, 35, 70, 0.5);
        }
        .section h4 { margin: 0 0 8px 0; font-size: 14px; font-weight: 500; }
        .section-form { display: flex; flex-direction: column; gap: 8px; }
        .section-input {
            padding: 7px 10px;
            border-radius: 6px;
            border: 1px solid rgba(100, 130, 255, 0.3);
            background: rgba(20, 30, 60, 0.5);
            color: #d0d0ff;
            font-size: 13px;
        }
        .section-input::placeholder { color: #6060a0; }
        .section-textarea {
            padding: 7px 10px;
            border-radius: 6px;
            border: 1px solid rgba(100, 130, 255, 0.3);
            background: rgba(20, 30, 60, 0.5);
            color: #d0d0ff;
            font-size: 13px;
            resize: vertical;
            min-height: 60px;
        }
        .section-textarea::placeholder { color: #6060a0; }
        .section-btn {
            padding: 8px;
            border-radius: 6px;
            border: none;
            background: linear-gradient(135deg, #4a6bff, #2845e0);
            color: white;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 13px;
        }
        .section-btn:hover {
            background: linear-gradient(135deg, #5a7bff, #3855f0);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(40, 69, 224, 0.4);
        }
        .section-btn:disabled {
            background: linear-gradient(135deg, #3a4a80, #2a3560);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
            opacity: 0.7;
        }
        .section-btn-success { background: linear-gradient(135deg, #4caf50, #388e3c); }
        .section-btn-success:hover { background: linear-gradient(135deg, #66bb6a, #43a047); }
        .wallet-addr {
            font-family: monospace;
            font-size: 11px;
            color: #81c784;
        }
        /* Content Area */
        .content-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            padding: 12px;
        }
        .viewport-container {
            flex: 2;
            display: flex;
            flex-direction: column;
            background: rgba(25, 35, 70, 0.5);
            border: 1px solid rgba(100, 130, 255, 0.2);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 12px;
        }
        .viewport-header {
            padding: 10px 15px;
            border-bottom: 1px solid rgba(100, 130, 255, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .viewport-header h3 { margin: 0; font-size: 16px; font-weight: 600; }
        .object-info { display: flex; gap: 8px; align-items: center; }
        .selected-name { font-weight: 500; color: #b0b0ff; font-size: 13px; }
        .selected-id { font-size: 11px; color: #8080c0; font-family: monospace; }
        .viewport {
            flex: 1;
            background: #0c1020;
            position: relative;
            overflow: hidden;
        }
        .viewport canvas { display: block; width: 100%; height: 100%; }
        .placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: #6060a0;
            font-size: 14px;
            flex-direction: column;
            gap: 10px;
        }
        .placeholder-icon { font-size: 40px; opacity: 0.3; }
        /* Bottom Section */
        .bottom-section {
            flex: 1;
            display: flex;
            gap: 12px;
            min-height: 160px;
        }
        .info-panel, .console-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: rgba(25, 35, 70, 0.5);
            border: 1px solid rgba(100, 130, 255, 0.2);
            border-radius: 10px;
            overflow: hidden;
        }
        .info-panel-header, .console-header {
            padding: 8px 15px;
            border-bottom: 1px solid rgba(100, 130, 255, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .info-panel-header h3, .console-header h3 { margin: 0; font-size: 14px; font-weight: 600; }
        .info-content {
            flex: 1;
            padding: 10px 15px;
            overflow-y: auto;
            font-size: 13px;
        }
        .info-row { display: flex; justify-content: space-between; padding: 3px 0; border-bottom: 1px solid rgba(100,130,255,0.05); }
        .info-label { color: #8080c0; }
        .info-value { color: #d0d0ff; font-family: monospace; font-size: 12px; }
        .console {
            flex: 1;
            padding: 8px 10px;
            overflow-y: auto;
            font-family: monospace;
            font-size: 12px;
            background: rgba(10, 15, 30, 0.7);
        }
        .log-line {
            padding: 2px 0;
            border-bottom: 1px solid rgba(100, 130, 255, 0.05);
            color: #a0a0d0;
        }
        .log-line.log-info { color: #90caf9; }
        .log-line.log-success { color: #81c784; }
        .log-line.log-warn { color: #ffb74d; }
        .log-line.log-error { color: #e57373; }
        .clear-btn {
            background: rgba(60, 80, 170, 0.3);
            border: 1px solid rgba(100, 130, 255, 0.3);
            color: #b0b0ff;
            padding: 3px 8px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 11px;
        }
        .clear-btn:hover { background: rgba(70, 90, 180, 0.4); }
        /* Validation Results */
        .proof-receipt {
            background: rgba(30, 60, 120, 0.4);
            border: 1px solid rgba(100, 150, 255, 0.4);
            border-radius: 8px;
            padding: 12px;
            margin-top: 8px;
        }
        .proof-receipt h4 { color: #90caf9; margin-bottom: 6px; font-size: 13px; }
        .proof-receipt p { font-family: monospace; font-size: 11px; margin: 3px 0; color: #b0b0ff; word-break: break-all; }
        /* Validation tab in sidebar */
        .tab-content { flex: 1; display: none; flex-direction: column; overflow: hidden; }
        .tab-content.active { display: flex; }
        /* Loading spinner */
        .spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid rgba(100,130,255,0.3); border-top-color: #90caf9; border-radius: 50%; animation: spin 0.6s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        /* DVE Metrics inline */
        .metric-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 6px; margin-bottom: 8px; }
        .metric-mini { background: rgba(30,40,80,0.5); border: 1px solid rgba(100,130,255,0.15); border-radius: 6px; padding: 8px; text-align: center; }
        .metric-mini-value { font-size: 18px; font-weight: 700; color: #d0d0ff; }
        .metric-mini-label { font-size: 9px; color: #8080c0; text-transform: uppercase; letter-spacing: 0.3px; margin-top: 2px; }
        /* Records table in validation */
        .records-table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .records-table th { text-align: left; padding: 6px 8px; border-bottom: 1px solid rgba(100,130,255,0.15); font-size: 10px; text-transform: uppercase; color: #8080c0; letter-spacing: 0.5px; }
        .records-table td { padding: 6px 8px; border-bottom: 1px solid rgba(100,130,255,0.05); }
        .status-badge { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 10px; font-weight: 600; text-transform: uppercase; }
        .status-badge.success { background: rgba(76,175,80,0.15); color: #81c784; }
        .status-badge.failure { background: rgba(244,67,54,0.15); color: #e57373; }
        .status-badge.pending { background: rgba(33,150,243,0.15); color: #90caf9; }
        .status-badge.error { background: rgba(255,152,0,0.15); color: #ffb74d; }
        .record-row:hover { background: rgba(40,60,120,0.3); }
        .mono { font-family: monospace; font-size: 11px; color: #8080c0; }
        .rec-title { font-weight: 500; }
        /* Wallet section */
        .connect-btn { background: rgba(76,175,80,0.2); border: 1px solid rgba(76,175,80,0.3); color: #81c784; padding: 6px 14px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s; }
        .connect-btn:hover { background: rgba(76,175,80,0.3); }
        .connect-btn.connected { background: rgba(33,150,243,0.2); border-color: rgba(33,150,243,0.3); color: #90caf9; }
        /* Badges tab styles */
        .badge-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(140px,1fr)); gap: 8px; }
        .badge-card { background: rgba(30,40,80,0.5); border: 1px solid rgba(100,130,255,0.2); border-radius: 8px; padding: 10px; text-align: center; cursor: pointer; transition: all 0.2s ease; position: relative; }
        .badge-card:hover { background: rgba(40,60,120,0.6); border-color: rgba(120,150,255,0.4); transform: translateY(-2px); }
        .badge-card.attached { border-color: rgba(76,175,80,0.4); box-shadow: 0 0 10px rgba(76,175,80,0.15); }
        .badge-card svg { width: 100%; max-width: 100px; height: auto; display: block; margin: 0 auto 6px; }
        .badge-name { font-size: 11px; font-weight: 600; color: #d0d0ff; margin-bottom: 2px; }
        .badge-type { font-size: 9px; color: #8080c0; text-transform: uppercase; letter-spacing: 0.3px; }
        .badge-attached-tag { position: absolute; top: 4px; right: 4px; font-size: 14px; }
        .badge-section-title { font-size: 13px; font-weight: 600; color: #b0b0ff; margin: 12px 0 8px; padding-bottom: 4px; border-bottom: 1px solid rgba(100,130,255,0.1); }
        .badge-section-title:first-of-type { margin-top: 0; }
        .badge-action-btn { font-size: 10px; background: rgba(76,175,80,0.2); border: 1px solid rgba(76,175,80,0.3); color: #81c784; padding: 3px 8px; border-radius: 4px; cursor: pointer; margin-top: 6px; transition: all 0.2s; }
        .badge-action-btn:hover { background: rgba(76,175,80,0.3); }
        .badge-action-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .badge-toast { position: fixed; bottom: 20px; right: 20px; background: rgba(25,35,70,0.95); border: 1px solid rgba(100,130,255,0.3); border-radius: 8px; padding: 10px 16px; font-size: 12px; color: #d0d0ff; z-index: 100; animation: fadeInUp 0.3s ease; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* ── Live FS Explorer Styles ── */
        .explorer-tree {
            flex: 1;
            overflow-y: auto;
            padding: 6px;
            font-size: 13px;
        }
        .explorer-btn {
            background: rgba(60, 80, 170, 0.25);
            border: 1px solid rgba(100, 130, 255, 0.25);
            color: #b0b0ff;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            line-height: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }
        .explorer-btn:hover {
            background: rgba(80, 110, 220, 0.4);
            border-color: rgba(140, 170, 255, 0.5);
            color: white;
        }
        .tree-node {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 3px 6px;
            border-radius: 4px;
            cursor: pointer;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: background 0.15s ease;
        }
        .tree-node:hover {
            background: rgba(60, 80, 170, 0.3);
        }
        .tree-node.selected {
            background: rgba(60, 90, 200, 0.4);
            border: 1px solid rgba(140, 170, 255, 0.4);
        }
        .tree-icon {
            width: 18px;
            text-align: center;
            flex-shrink: 0;
            font-size: 13px;
        }
        .tree-toggle {
            width: 16px;
            text-align: center;
            flex-shrink: 0;
            font-size: 10px;
            color: #7070a0;
            cursor: pointer;
            user-select: none;
        }
        .tree-toggle:hover { color: #b0b0ff; }
        .tree-children { margin-left: 18px; }
        .tree-children.collapsed { display: none; }
        .tree-label {
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 12px;
        }
        .tree-label.dir { color: #90caf9; font-weight: 500; }
        .tree-label.file { color: #c0c0e0; }
        .tree-label.file.txt { color: #a0d0a0; }
        .tree-label.file.js,
        .tree-label.file.ts,
        .tree-label.file.go,
        .tree-label.file.py,
        .tree-label.file.java,
        .tree-label.file.c,
        .tree-label.file.cpp,
        .tree-label.file.h { color: #ce93d8; }
        .tree-label.file.json,
        .tree-label.file.yaml,
        .tree-label.file.yml,
        .tree-label.file.toml,
        .tree-label.file.xml { color: #ffcc80; }
        .tree-label.file.md,
        .tree-label.file.html,
        .tree-label.file.css { color: #80cbc4; }
        .tree-label.file.sh,
        .tree-label.file.bash,
        .tree-label.file.zsh { color: #a5d6a7; }
        .tree-label.file.img,
        .tree-label.file.png,
        .tree-label.file.jpg,
        .tree-label.file.jpeg,
        .tree-label.file.gif,
        .tree-label.file.svg,
        .tree-label.file.webp { color: #ef9a9a; }
        .tree-label.file.bin,
        .tree-label.file.so,
        .tree-label.file.o,
        .tree-label.file.a { color: #b0bec5; }
        /* File viewer */
        .file-viewer {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: rgba(25, 35, 70, 0.5);
            border: 1px solid rgba(100, 130, 255, 0.2);
            border-radius: 10px;
            overflow: hidden;
        }
        .file-toolbar {
            padding: 8px 14px;
            border-bottom: 1px solid rgba(100, 130, 255, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(20, 30, 60, 0.4);
        }
        .file-info { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
        .file-name { font-weight: 600; font-size: 14px; color: #d0d0ff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .layer-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }
        .layer-badge.lower { background: rgba(244,67,54,0.15); color: #e57373; border: 1px solid rgba(244,67,54,0.3); }
        .layer-badge.upper { background: rgba(76,175,80,0.15); color: #81c784; border: 1px solid rgba(76,175,80,0.3); }
        .file-size { font-size: 12px; color: #8080c0; white-space: nowrap; }
        .file-actions { display: flex; gap: 6px; }
        .file-action-btn {
            background: rgba(60, 80, 170, 0.3);
            border: 1px solid rgba(100, 130, 255, 0.3);
            color: #b0b0ff;
            padding: 5px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.2s ease;
        }
        .file-action-btn:hover {
            background: rgba(80, 110, 220, 0.4);
            border-color: rgba(140, 170, 255, 0.5);
            color: white;
        }
        .file-action-danger { color: #e57373; border-color: rgba(244,67,54,0.3); }
        .file-action-danger:hover { background: rgba(220, 60, 60, 0.3); border-color: rgba(255,100,100,0.4); color: #ff6b6b; }
        .file-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }
        .file-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: #6060a0;
            font-size: 14px;
            flex-direction: column;
            gap: 10px;
        }
        .file-preview {
            flex: 1;
            margin: 0;
            padding: 14px 16px;
            overflow: auto;
            font-family: 'Cascadia Code', 'Fira Code', monospace;
            font-size: 12px;
            line-height: 1.6;
            color: #d0d0ff;
            background: rgba(10, 15, 30, 0.6);
            white-space: pre-wrap;
            word-break: break-all;
        }
        .file-error {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: #e57373;
            font-size: 13px;
            padding: 20px;
            text-align: center;
            flex-direction: column;
            gap: 8px;
        }
        /* Upload dialog overlay */
        .upload-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        .upload-dialog {
            background: rgba(20, 30, 60, 0.95);
            border: 1px solid rgba(100, 130, 255, 0.3);
            border-radius: 12px;
            padding: 24px;
            min-width: 340px;
            max-width: 500px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
        }
        .upload-dialog h3 { margin: 0 0 12px; font-size: 16px; color: #d0d0ff; }
        .upload-dialog input[type="file"] {
            display: block;
            width: 100%;
            margin: 8px 0;
            padding: 8px;
            background: rgba(30,40,80,0.5);
            border: 1px dashed rgba(100,130,255,0.3);
            border-radius: 6px;
            color: #b0b0ff;
            font-size: 12px;
        }
        .upload-dialog-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px; }
    </style>
</head>
<body>
{{ end }}

{{ define "content" }}
<div class="dve-file-manager" id="app">
    <!-- Header -->
    <div class="header">
        <div class="header-left">
            <div class="hud-buttons">
                <button class="hud-btn" onclick="goBack()" title="Back to Workspace">&#8592;</button>
                <button class="hud-btn hud-close" onclick="closeView()" title="Close">&#10005;</button>
            </div>
            <div class="header-divider"></div>
            <div class="logo">
                <h1>DVE File Manager</h1>
                <span class="subtitle">Secure Enclave: {{ .DVEID }}</span>
            </div>
            <div class="badge-row">
                <span class="badge badge-{{ if eq .Status "online" }}online{{ else }}offline{{ end }}">{{ .Status }}</span>
                {{ if .TEEType }}<span class="badge badge-tee">{{ .TEEType }}</span>{{ end }}
                <span class="badge badge-active">{{ .Metrics.TotalValidations }} validations</span>
            </div>
        </div>
        <div class="nav-links">
            <button class="active" data-tab="files" onclick="switchTab('files')">Files</button>
            <button data-tab="validation" onclick="switchTab('validation')">Validation</button>
            <button data-tab="console" onclick="switchTab('console')">Console</button>
            <button data-tab="badges" onclick="switchTab('badges'); loadBadges()">Badges</button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Sidebar -->
        <div class="sidebar">
            <!-- Tab: Files — Live FS Explorer -->
            <div class="tab-content active" id="tab-files">
                <div class="sidebar-header" style="display:flex;justify-content:space-between;align-items:center;">
                    <h3>File Explorer</h3>
                    <div class="explorer-toolbar" style="display:flex;gap:4px;">
                        <button class="explorer-btn" onclick="loadDir('/')" title="Refresh">&#x21BB;</button>
                        {{ if .ExplorerAllowWrite }}
                        <button class="explorer-btn" onclick="showUploadDialog()" title="Upload File">&#x2191;</button>
                        {{ end }}
                    </div>
                </div>
                <div class="explorer-tree" id="explorer-tree">
                    <div class="empty-state" id="explorer-loading">Loading file tree...</div>
                </div>
            </div>

            <!-- Tab: Validation -->
            <div class="tab-content" id="tab-validation">
                <div class="sidebar-header"><h3>Public Validation</h3></div>
                <div class="objects-container" style="overflow-y:auto;">
                    <div class="section" style="border:none;padding:10px;">
                        <h4>Connect Wallet</h4>
                        <p style="font-size:12px;color:#8080c0;margin-bottom:10px;">Verify DVE integrity &mdash; generate a signed validation report for <strong>1 NRN</strong></p>
                        <div style="display:flex;align-items:center;gap:8px;margin:8px 0;">
                            <button id="connect-btn" class="connect-btn" onclick="connectWallet()">Connect Wallet</button>
                            <span id="wallet-address" class="wallet-addr"></span>
                        </div>
                        <div style="margin:12px 0;">
                            <textarea id="validation-input" class="section-textarea" placeholder="Optional: context for validation..."></textarea>
                        </div>
                        <button id="validate-btn" class="section-btn" onclick="initiateValidation()" disabled>
                            Initiate Validation &mdash; 1 NRN
                        </button>
                        <div id="proof-result" style="margin-top:8px;"></div>
                    </div>
                    <div class="section" style="border-top:1px solid rgba(100,130,255,0.2);padding:10px;">
                        <h4>Validation Records</h4>
                        <div style="overflow-y:auto;max-height:200px;">
                            <table class="records-table">
                                <thead><tr><th>ID</th><th>Type</th><th>Status</th><th>Time</th></tr></thead>
                                <tbody>
                                {{ if .Records }}
                                    {{ range .Records }}
                                    <tr class="record-row"><td class="mono">{{ slicestr .ID 0 8 }}...</td><td class="rec-title">{{ .Type }}</td><td><span class="status-badge {{ .Status }}">{{ .Status }}</span></td><td class="mono">{{ slicestr .CreatedAt 0 10 }}</td></tr>
                                    {{ end }}
                                {{ else }}
                                    <tr><td colspan="4" style="text-align:center;color:#6060a0;padding:20px;font-size:12px;">No validation records yet</td></tr>
                                {{ end }}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab: Console -->
            <div class="tab-content" id="tab-console">
                <div class="sidebar-header">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <h3>Activity Log</h3>
                        <button class="clear-btn" onclick="clearConsole()">Clear</button>
                    </div>
                </div>
                <div class="console" id="console-sidebar" style="flex:1;">
                    <div class="log-line" id="log-init">[{{ GetTimestamp }}] DVE File Manager initialized for {{ .DVEID }}</div>
                </div>
            </div>

            <!-- Tab: Badges -->
            <div class="tab-content" id="tab-badges">
                <div class="sidebar-header"><h3>Badges</h3></div>
                <div class="objects-container" id="badges-container" style="overflow-y:auto;padding:10px;">
                    <div class="badge-section-title">Attached to DVE</div>
                    <div id="attached-badges">
                        <div class="empty-state" style="height:60px;">No badges attached yet</div>
                    </div>
                    <div class="badge-section-title">Available Templates</div>
                    <div id="available-badges">
                        <div class="empty-state" style="height:60px;">No badge templates available</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Area -->
        <div class="content-area">
            <!-- Tab Content: Files — Live FS Viewer -->
            <div id="content-files" style="display:flex;flex-direction:column;flex:1;overflow:hidden;">
                <div class="file-viewer">
                    <div class="file-toolbar" id="file-toolbar" style="display:none;">
                        <div class="file-info">
                            <span class="file-name" id="file-name">Select a file</span>
                            <span class="layer-badge" id="layer-badge"></span>
                            <span class="file-size" id="file-size"></span>
                        </div>
                        <div class="file-actions">
                            <button class="file-action-btn" onclick="downloadFile()" title="Download">&#x2B07; Download</button>
                            {{ if .ExplorerAllowWrite }}
                            <button class="file-action-btn file-action-danger" onclick="deleteFile()" title="Delete">&#x1F5D1; Delete</button>
                            {{ end }}
                        </div>
                    </div>
                    <div class="file-content" id="file-content">
                        <div class="file-placeholder" id="file-placeholder">
                            <div class="placeholder-icon">&#x1F4C1;</div>
                            <span>Select a file from the sidebar to view its contents</span>
                        </div>
                        <pre class="file-preview" id="file-preview" style="display:none;"></pre>
                        <div class="file-error" id="file-error" style="display:none;"></div>
                    </div>
                </div>
            </div>

            <!-- Tab Content: Validation -->
            <div id="content-validation" style="display:none;flex-direction:column;flex:1;overflow:hidden;padding:20px;">
                <div style="background:rgba(25,35,70,0.5);border:1px solid rgba(100,130,255,0.2);border-radius:10px;padding:20px;flex:1;overflow-y:auto;">
                    <h2 style="font-size:20px;margin-bottom:15px;background:linear-gradient(90deg,#64b5f6,#9575cd);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Validation Report</h2>
                    <p style="color:#a0a0d0;font-size:14px;margin-bottom:20px;">Generate a signed, timestamped integrity report for DVE <strong>{{ .DVEID }}</strong>.</p>
                    <div id="validation-report-area">
                        <div style="text-align:center;color:#6060a0;padding:40px;">
                            <p>Connect your wallet and initiate validation from the sidebar to generate a report.</p>
                            <p style="font-size:12px;margin-top:10px;">The report will include proof, session ID, and timestamp.</p>
                        </div>
                    </div>
                    <div id="report-output" style="display:none;"></div>
                </div>
            </div>

            <!-- Tab Content: Console (full) -->
            <div id="content-console" style="display:none;flex-direction:column;flex:1;overflow:hidden;padding:12px;">
                <div class="console-container" style="flex:1;">
                    <div class="console-header">
                        <h3>Full Console Log</h3>
                        <button class="clear-btn" onclick="clearMainConsole()">Clear</button>
                    </div>
                    <div class="console" id="console-full" style="flex:1;"></div>
                </div>
            </div>

            <!-- Tab Content: Badges -->
            <div id="content-badges" style="display:none;flex-direction:column;flex:1;overflow:hidden;padding:20px;">
                <div style="background:rgba(25,35,70,0.5);border:1px solid rgba(100,130,255,0.2);border-radius:10px;padding:20px;flex:1;overflow-y:auto;">
                    <h2 style="font-size:20px;margin-bottom:15px;background:linear-gradient(90deg,#64b5f6,#9575cd);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">DVE Badges</h2>
                    <p style="color:#a0a0d0;font-size:14px;margin-bottom:20px;">
                        Badges are attestation credentials that certify specific capabilities, skills, or properties of this DVE.
                        <strong style="color:#b0b0ff;">Attached badges</strong> are actively enforced by the guardrail system.
                    </p>
                    <div id="badge-detail-area">
                        <div style="text-align:center;color:#6060a0;padding:40px;">
                            <p>Select a badge from the sidebar to view its full details.</p>
                        </div>
                    </div>
                    <div id="badge-detail-output" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// ── HUD Navigation (iframe parent communication) ──
function escapeHtml(s) { if (!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }
function isInIframe() { try { return window.self !== window.top; } catch(e) { return true; } }
function goBack() {
    if (isInIframe()) {
        window.parent.postMessage({ type: 'dve:navigate:back', dveId: '{{ .DVEID }}' }, '*');
    } else {
        window.history.back();
    }
}
function closeView() {
    if (isInIframe()) {
        window.parent.postMessage({ type: 'dve:navigate:close', dveId: '{{ .DVEID }}' }, '*');
    } else {
        window.close();
    }
}

// ── Tab Switching ──
function switchTab(name) {
    document.querySelectorAll('.nav-links button').forEach(b => b.classList.remove('active'));
    document.querySelector(`.nav-links button[data-tab="${name}"]`).classList.add('active');
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    document.getElementById(`tab-${name}`).classList.add('active');
    ['content-files','content-validation','content-console','content-badges'].forEach(id => {
        document.getElementById(id).style.display = id === `content-${name}` ? 'flex' : 'none';
    });
}

// ── Console ──
function log(containerId, msg, level = 'info') {
    const ts = new Date().toLocaleTimeString();
    const el = document.getElementById(containerId);
    if (!el) return;
    const line = document.createElement('div');
    line.className = `log-line log-${level}`;
    line.textContent = `[${ts}] ${msg}`;
    el.appendChild(line);
    el.scrollTop = el.scrollHeight;
}
function logBoth(msg, level = 'info') {
    log('console-main', msg, level);
    log('console-sidebar', msg, level);
    const full = document.getElementById('console-full');
    if (full) { const line = document.createElement('div'); line.className = `log-line log-${level}`; line.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`; full.appendChild(line); full.scrollTop = full.scrollHeight; }
}
function clearConsole() { document.getElementById('console-sidebar').innerHTML = ''; log('console-sidebar', 'Console cleared', 'info'); }
function clearMainConsole() { document.getElementById('console-full').innerHTML = ''; }

// ── Three.js 3D Viewport ──
let scene, camera, renderer, currentModel;
let isViewerReady = false;

function initViewer() {
    const container = document.getElementById('three-container');
    if (!container) return;
    const rect = container.getBoundingClientRect();
    const width = rect.width || container.clientWidth || 600;
    const height = rect.height || container.clientHeight || 400;

    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0c1020);

    camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.set(5, 5, 5);
    camera.lookAt(0, 0, 0);

    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    container.appendChild(renderer.domElement);

    // Lighting
    const ambientLight = new THREE.AmbientLight(0x404060, 0.5);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 1);
    dirLight.position.set(5, 10, 7);
    dirLight.castShadow = true;
    scene.add(dirLight);

    const fillLight = new THREE.DirectionalLight(0x8888ff, 0.3);
    fillLight.position.set(-5, 0, 5);
    scene.add(fillLight);

    // Grid helper
    const gridHelper = new THREE.GridHelper(10, 20, 0x444488, 0x333366);
    scene.add(gridHelper);

    // Orbit controls
    const controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.autoRotate = false;
    controls.target.set(0, 0, 0);

    function animate() {
        requestAnimationFrame(animate);
        controls.update();
        renderer.render(scene, camera);
    }
    animate();

    // Handle resize
    window.addEventListener('resize', () => {
        const r = container.getBoundingClientRect();
        const w = r.width || container.clientWidth;
        const h = r.height || container.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
    });

    isViewerReady = true;
    container.style.display = 'block';
    document.getElementById('viewer-placeholder').style.display = 'none';
    logBoth('3D viewport initialized', 'success');
}

// Load a sample 3D object (geometric shapes as placeholder)
function loadSampleModel(type) {
    if (!isViewerReady) initViewer();
    const container = document.getElementById('three-container');
    container.style.display = 'block';
    document.getElementById('viewer-placeholder').style.display = 'none';

    // Remove previous model
    if (currentModel) { scene.remove(currentModel); currentModel = null; }

    let geometry, material;
    const group = new THREE.Group();

    switch(type) {
        case 'validation':
            // Shield-like object
            geometry = new THREE.CylinderGeometry(1.5, 1.8, 0.3, 32);
            material = new THREE.MeshPhongMaterial({ color: 0x4caf50, emissive: 0x1b5e20, emissiveIntensity: 0.2, metalness: 0.3, roughness: 0.4 });
            const shield = new THREE.Mesh(geometry, material);
            shield.rotation.x = Math.PI / 2;
            group.add(shield);
            // Ring
            const ringGeo = new THREE.TorusGeometry(1.8, 0.05, 16, 32);
            const ringMat = new THREE.MeshPhongMaterial({ color: 0x64b5f6, emissive: 0x1a237e, emissiveIntensity: 0.3 });
            const ring = new THREE.Mesh(ringGeo, ringMat);
            ring.rotation.x = Math.PI / 2;
            group.add(ring);
            break;
        case 'success':
            // Star/diamond
            geometry = new THREE.OctahedronGeometry(1.5, 0);
            material = new THREE.MeshPhongMaterial({ color: 0x64b5f6, emissive: 0x1565c0, emissiveIntensity: 0.3, metalness: 0.5, roughness: 0.3 });
            const star = new THREE.Mesh(geometry, material);
            group.add(star);
            // Glow ring
            const glowGeo = new THREE.TorusGeometry(1.8, 0.03, 16, 32);
            const glowMat = new THREE.MeshPhongMaterial({ color: 0x90caf9, transparent: true, opacity: 0.5 });
            const glow = new THREE.Mesh(glowGeo, glowMat);
            glow.rotation.x = Math.PI / 2;
            group.add(glow);
            break;
        case 'error':
            // Dodecahedron
            geometry = new THREE.DodecahedronGeometry(1.3, 0);
            material = new THREE.MeshPhongMaterial({ color: 0xe57373, emissive: 0xb71c1c, emissiveIntensity: 0.2, wireframe: false });
            const dode = new THREE.Mesh(geometry, material);
            group.add(dode);
            break;
        default:
            // Default cube
            geometry = new THREE.IcosahedronGeometry(1.2, 1);
            material = new THREE.MeshPhongMaterial({ color: 0x90caf9, emissive: 0x1a237e, emissiveIntensity: 0.15, metalness: 0.4, roughness: 0.3 });
            const ico = new THREE.Mesh(geometry, material);
            group.add(ico);
    }

    scene.add(group);
    currentModel = group;

    // Auto-rotate
    if (window.orbitControls) {
        window.orbitControls.autoRotate = true;
    }
}

// ── Record Selection ──
function selectRecord(id, type, status, score, validator) {
    document.querySelectorAll('.object-item').forEach(i => i.classList.remove('active'));
    event.currentTarget.classList.add('active');

    document.getElementById('selected-name').textContent = type;
    document.getElementById('selected-id').textContent = 'ID: ' + id.substring(0, 12) + '...';

    const details = document.getElementById('record-details');
    details.innerHTML = `
        <div class="info-row"><span class="info-label">Record ID</span><span class="info-value">${id}</span></div>
        <div class="info-row"><span class="info-label">Type</span><span class="info-value">${type}</span></div>
        <div class="info-row"><span class="info-label">Status</span><span class="info-value" style="color:${status === 'success' ? '#81c784' : status === 'error' ? '#e57373' : '#ffb74d'}">${status}</span></div>
        <div class="info-row"><span class="info-label">Score</span><span class="info-value">${score || '—'}</span></div>
        <div class="info-row"><span class="info-label">Validator</span><span class="info-value">${validator || '—'}</span></div>
    `;

    loadSampleModel(status);
    logBoth(`Selected: ${type} (${status})`, status === 'success' ? 'success' : status === 'error' ? 'error' : 'info');
}

// ── Wallet + Validation ──
let connectedWallet = '';
function truncateWallet(a) { if (!a || a.length < 10) return a; return a.substring(0,6) + '...' + a.substring(a.length-4); }
async function connectWallet() {
    if (!window.ethereum) { logBoth('MetaMask not detected — install MetaMask to validate', 'error'); alert('Please install MetaMask.'); return; }
    try {
        const acc = await window.ethereum.request({ method: 'eth_requestAccounts' });
        connectedWallet = acc[0];
        document.getElementById('wallet-address').textContent = truncateWallet(connectedWallet);
        const btn = document.getElementById('connect-btn');
        btn.textContent = 'Connected';
        btn.classList.add('connected');
        document.getElementById('validate-btn').disabled = false;
        logBoth(`Wallet connected: ${truncateWallet(connectedWallet)}`, 'success');
    } catch(e) { logBoth('Wallet connection failed: ' + e.message, 'error'); }
}
async function initiateValidation() {
    if (!connectedWallet || !window.ethereum) { logBoth('Connect wallet first', 'warn'); return; }
    const btn = document.getElementById('validate-btn');
    const pr = document.getElementById('proof-result');
    const input = document.getElementById('validation-input').value;
    btn.disabled = true; btn.textContent = 'Processing...';
    pr.innerHTML = '<p style="color:#8080c0;font-size:12px;"><span class="spinner"></span> Sending transaction...</p>';
    logBoth('Initiating validation transaction...', 'info');
    try {
        const txHash = await window.ethereum.request({
            method: 'eth_sendTransaction',
            params: [{ to: '{{ .RewardPoolAddress }}', value: '0x' + (1n * 10n**18n).toString(16), gas: '0x5208' }]
        });
        logBoth(`Transaction sent: ${txHash.substring(0,10)}...`, 'success');
        pr.innerHTML = '<p style="color:#8080c0;font-size:12px;"><span class="spinner"></span> Backend processing...</p>';
        const resp = await fetch('/dve/{{ .DVEID }}/validate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ signed_tx: txHash, wallet_address: connectedWallet, payload: input })
        });
        if (!resp.ok) { const e = await resp.json().catch(()=>({})); throw new Error(e.error || 'HTTP ' + resp.status); }
        const r = await resp.json();
        pr.innerHTML = `<div class="proof-receipt"><h4>✓ Validation Initiated</h4><p><strong>Session:</strong> ${r.session_id || ''}</p><p><strong>Proof:</strong> ${r.proof || 'generating...'}</p><p><strong>Timestamp:</strong> ${r.timestamp || new Date().toISOString()}</p></div>`;
        // Show report in content area too
        const reportArea = document.getElementById('validation-report-area');
        if (reportArea) {
            reportArea.style.display = 'none';
            document.getElementById('report-output').style.display = 'block';
            document.getElementById('report-output').innerHTML = `<div class="proof-receipt" style="margin-top:10px;"><h4>Validation Report</h4><p><strong>DVE ID:</strong> {{ .DVEID }}</p><p><strong>Session:</strong> ${r.session_id || ''}</p><p><strong>Proof:</strong> ${r.proof || ''}</p><p><strong>Timestamp:</strong> ${r.timestamp || ''}</p><p><strong>Status:</strong> ${r.status || 'pending'}</p></div>`;
        }
        logBoth('Validation initiated successfully', 'success');
        window.parent.postMessage({ type: 'dve:validation:complete', dveId: '{{ .DVEID }}', sessionId: r.session_id, proof: r.proof, timestamp: r.timestamp }, '*');
    } catch(e) {
        pr.innerHTML = `<p style="color:#e57373;font-size:12px;">Error: ${e.message}</p>`;
        logBoth('Validation failed: ' + e.message, 'error');
    } finally {
        btn.disabled = false; btn.textContent = 'Initiate Validation — 1 NRN';
    }
}
// Auto-connect if wallet already authorized
if (window.ethereum) {
    window.ethereum.request({ method: 'eth_accounts' }).then(function(a) {
        if (a.length > 0) {
            connectedWallet = a[0];
            document.getElementById('wallet-address').textContent = truncateWallet(connectedWallet);
            document.getElementById('connect-btn').textContent = 'Connected';
            document.getElementById('connect-btn').classList.add('connected');
            document.getElementById('validate-btn').disabled = false;
        }
    }).catch(function(){});
}

// ── Load Three.js from CDN ──
function loadThreeJS() {
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
    script.onload = function() {
        const orbitScript = document.createElement('script');
        orbitScript.src = 'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js';
        orbitScript.onload = function() {
            logBoth('Three.js viewer loaded', 'success');
        };
        document.head.appendChild(orbitScript);
    };
    document.head.appendChild(script);
}
loadThreeJS();

// ── Init ──
logBoth('DVE File Manager ready for {{ .DVEID }}', 'success');

// ── Badge Functions ──
let allBadgeTemplates = [];
let attachedBadgeIds = [];

function showBadgeToast(msg) {
    const existing = document.querySelector('.badge-toast');
    if (existing) existing.remove();
    const el = document.createElement('div');
    el.className = 'badge-toast';
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(() => { if (el.parentNode) el.remove(); }, 4000);
}

async function loadBadges() {
    const attachedEl = document.getElementById('attached-badges');
    const availableEl = document.getElementById('available-badges');
    if (!attachedEl || !availableEl) return;
    attachedEl.innerHTML = '<div class="spinner" style="margin:12px auto;"></div>';
    availableEl.innerHTML = '<div class="spinner" style="margin:12px auto;"></div>';
    try {
        // Fetch all active templates
        const tmplResp = await fetch('/api/badge/templates?active=true');
        const tmplData = await tmplResp.json();
        allBadgeTemplates = (tmplData.templates || tmplData || []);
        if (!Array.isArray(allBadgeTemplates)) allBadgeTemplates = [];

        // Fetch attached badges for this DVE
        const attachResp = await fetch('/api/badge/templates/dve/{{ .DVEID }}/badges');
        const attachData = await attachResp.json();
        attachedBadgeIds = (attachData.badge_ids || attachData.attached_badges || []);
        if (!Array.isArray(attachedBadgeIds)) attachedBadgeIds = [];

        renderBadges();
    } catch (e) {
        attachedEl.innerHTML = '<div class="empty-state" style="height:60px;">Error loading badges</div>';
        availableEl.innerHTML = '<div class="empty-state" style="height:60px;">Error loading templates</div>';
        logBoth('Failed to load badges: ' + e.message, 'error');
    }
}

function renderBadges() {
    const attachedEl = document.getElementById('attached-badges');
    const availableEl = document.getElementById('available-badges');

    // Separate attached vs available
    const attached = allBadgeTemplates.filter(t => attachedBadgeIds.includes(t.id));
    const available = allBadgeTemplates.filter(t => !attachedBadgeIds.includes(t.id));

    // Render attached
    if (attached.length === 0) {
        attachedEl.innerHTML = '<div class="empty-state" style="height:60px;">No badges attached yet</div>';
    } else {
        attachedEl.innerHTML = '<div class="badge-grid">' + attached.map(b => renderBadgeCard(b, true)).join('') + '</div>';
    }

    // Render available
    if (available.length === 0) {
        availableEl.innerHTML = '<div class="empty-state" style="height:60px;">' +
            (allBadgeTemplates.length > 0 ? 'All templates are already attached' : 'No badge templates available') +
            '</div>';
    } else {
        availableEl.innerHTML = '<div class="badge-grid">' + available.map(b => renderBadgeCard(b, false)).join('') + '</div>';
    }

    logBoth('Loaded ' + attached.length + ' attached badges, ' + available.length + ' available templates', 'info');
}

function renderBadgeCard(badge, isAttached) {
    const svg = badge.svg_design || '';
    const name = escapeHtml(badge.name || badge.id);
    const btype = escapeHtml(badge.badge_type || '');
    const primColor = badge.primary_color || '#64b5f6';
    return '<div class="badge-card' + (isAttached ? ' attached' : '') + '" onclick="showBadgeDetail(\'' + escapeHtml(badge.id) + '\')">' +
        (isAttached ? '<span class="badge-attached-tag">✅</span>' : '') +
        (svg ? svg : '<div style="width:60px;height:60px;margin:0 auto 6px;border-radius:8px;background:' + primColor + '20;border:1px solid ' + primColor + '40;display:flex;align-items:center;justify-content:center;font-size:24px;">🏅</div>') +
        '<div class="badge-name">' + name + '</div>' +
        '<div class="badge-type">' + btype + '</div>' +
        (isAttached ? '' : '<button class="badge-action-btn" onclick="event.stopPropagation();mintBadge(\'' + escapeHtml(badge.id) + '\')">Mint to DVE</button>') +
        '</div>';
}

function showBadgeDetail(id) {
    const badge = allBadgeTemplates.find(t => t.id === id);
    if (!badge) return;
    const isAttached = attachedBadgeIds.includes(id);
    const area = document.getElementById('badge-detail-area');
    const output = document.getElementById('badge-detail-output');
    if (area) area.style.display = 'none';
    if (output) {
        output.style.display = 'block';
        const svg = badge.svg_design || '';
        output.innerHTML = '<div class="proof-receipt" style="margin-top:0;">' +
            (svg ? '<div style="text-align:center;margin-bottom:12px;max-width:120px;margin-left:auto;margin-right:auto;">' + svg + '</div>' : '') +
            '<h4>' + escapeHtml(badge.name) + (isAttached ? ' <span style="font-size:11px;color:#81c784;">✅ Attached</span>' : '') + '</h4>' +
            '<p><strong>Type:</strong> ' + escapeHtml(badge.badge_type || '—') + '</p>' +
            '<p><strong>Description:</strong> ' + escapeHtml(badge.description || '—') + '</p>' +
            (badge.value_signals && badge.value_signals.length ? '<p><strong>Value Signals:</strong> ' + badge.value_signals.join(', ') + '</p>' : '') +
            (badge.ontology_signals && badge.ontology_signals.length ? '<p><strong>Ontology:</strong> ' + badge.ontology_signals.join(', ') + '</p>' : '') +
            (badge.ai_text_tag ? '<p><strong>AI Tag:</strong> ' + escapeHtml(badge.ai_text_tag) + '</p>' : '') +
            '<p><strong>Threshold:</strong> ' + (badge.alignment_threshold || '0.75') + '</p>' +
            '<p><strong>Created:</strong> ' + (badge.created_at ? new Date(badge.created_at).toLocaleDateString() : '—') + '</p>' +
            (!isAttached ? '<button class="badge-action-btn" onclick="mintBadge(\'' + escapeHtml(badge.id) + '\')" style="margin-top:10px;">Mint to DVE</button>' : '') +
            '</div>';
    }
}

async function mintBadge(templateId) {
    const btn = event && event.target ? event.target : null;
    if (btn) { btn.disabled = true; btn.textContent = 'Minting...'; }
    try {
        const resp = await fetch('/api/badge/templates/' + encodeURIComponent(templateId) + '/mint', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ dve_id: '{{ .DVEID }}' })
        });
        if (!resp.ok) { const e = await resp.json().catch(()=>({})); throw new Error(e.error || 'HTTP ' + resp.status); }
        const r = await resp.json();
        showBadgeToast('✓ Badge "' + (r.template_name || '') + '" minted to DVE');
        logBoth('Badge minted: ' + (r.template_name || templateId), 'success');
        // Reload badges
        await loadBadges();
    } catch (e) {
        showBadgeToast('✗ Mint failed: ' + e.message);
        logBoth('Badge mint failed: ' + e.message, 'error');
    } finally {
        if (btn) { btn.disabled = false; btn.textContent = 'Mint to DVE'; }
    }
}

// ── Live FS Explorer ──
let currentDir = '/';
let selectedFilePath = null;

// Auto-load explorer when switching to files tab
const origSwitchTab = switchTab;
window.switchTab = function(name) {
    origSwitchTab(name);
    if (name === 'files') {
        const treeEl = document.getElementById('explorer-tree');
        if (treeEl && !treeEl.querySelector('.tree-node')) {
            loadDir('/');
        }
    }
};

function humanSize(bytes) {
    if (bytes == null) return '';
    if (bytes === 0) return '0 B';
    const units = ['B', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.floor(Math.log(bytes) / Math.log(1024));
    const s = (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0);
    return s + ' ' + units[i];
}

function fileIcon(name, isDir) {
    if (isDir) return '📁';
    const ext = name.split('.').pop().toLowerCase();
    const map = {
        txt: '📄', md: '📝', html: '🌐', css: '🎨', js: '⚡', ts: '⚡',
        go: '🔷', py: '🐍', java: '☕', c: '⚙', cpp: '⚙', h: '⚙',
        json: '📋', yaml: '📋', yml: '📋', toml: '📋', xml: '📋',
        sh: '💻', bash: '💻', zsh: '💻',
        png: '🖼', jpg: '🖼', jpeg: '🖼', gif: '🖼', svg: '🖼', webp: '🖼',
        pdf: '📕', zip: '📦', tar: '📦', gz: '📦', tgz: '📦',
        bin: '⚫', so: '🔌', o: '🔧', a: '📚',
        log: '📊', csv: '📊',
        conf: '⚙', cfg: '⚙', ini: '⚙',
    };
    return map[ext] || '📄';
}

function getExtClass(name, isDir) {
    if (isDir) return 'dir';
    const ext = name.split('.').pop().toLowerCase();
    const textExts = ['txt','md','html','css','js','ts','go','py','java','c','cpp','h'];
    const dataExts = ['json','yaml','yml','toml','xml'];
    const webExts = ['md','html','css'];
    const shellExts = ['sh','bash','zsh'];
    const imgExts = ['png','jpg','jpeg','gif','svg','webp'];
    const binExts = ['bin','so','o','a'];
    if (textExts.includes(ext)) return 'file ' + ext;
    if (dataExts.includes(ext)) return 'file ' + ext;
    if (webExts.includes(ext)) return 'file ' + ext;
    if (shellExts.includes(ext)) return 'file ' + ext;
    if (imgExts.includes(ext)) return 'file img';
    if (binExts.includes(ext)) return 'file ' + ext;
    return 'file';
}

async function loadDir(dirPath) {
    currentDir = dirPath || '/';
    const tree = document.getElementById('explorer-tree');
    tree.innerHTML = '<div class="empty-state"><span class="spinner"></span> Loading...</div>';
    try {
        const resp = await fetch('/api/dve/{{ .DVEID }}/workspace/ls?path=' + encodeURIComponent(currentDir));
        if (!resp.ok) {
            const e = await resp.json().catch(()=>({}));
            throw new Error(e.error || 'HTTP ' + resp.status);
        }
        const data = await resp.json();
        renderTree(data);
    } catch (e) {
        tree.innerHTML = '<div class="file-error">Error: ' + escapeHtml(e.message) + '</div>';
        logBoth('FS explorer error: ' + e.message, 'error');
    }
}

function renderTree(data) {
    const tree = document.getElementById('explorer-tree');
    const entries = data.entries || data.files || data.children || [];
    const dirs = entries.filter(function(e) { return e.is_dir || e.type === 'dir'; });
    const files = entries.filter(function(e) { return !e.is_dir && e.type !== 'dir'; });

    dirs.sort(function(a,b) { return (a.name || '').localeCompare(b.name || ''); });
    files.sort(function(a,b) { return (a.name || '').localeCompare(b.name || ''); });

    let html = '';
    dirs.forEach(function(e) {
        const name = e.name || e.path || '';
        const fullPath = e.path || (currentDir === '/' ? '/' + name : currentDir.replace(/\/+$/, '') + '/' + name);
        html += '<div class="tree-node" onclick="toggleDir(this, \'' + escapeHtml(fullPath) + '\')" title="' + escapeHtml(fullPath) + '">' +
            '<span class="tree-toggle" id="toggle-' + escapeHtml(name) + '">&#x25B6;</span>' +
            '<span class="tree-icon">📁</span>' +
            '<span class="tree-label dir">' + escapeHtml(name) + '</span>' +
            '</div>' +
            '<div class="tree-children collapsed" id="children-' + escapeHtml(name) + '"></div>';
    });
    files.forEach(function(e) {
        const name = e.name || e.path || '';
        const fullPath = e.path || (currentDir === '/' ? '/' + name : currentDir.replace(/\/+$/, '') + '/' + name);
        const size = e.size || 0;
        html += '<div class="tree-node" onclick="openFile(\'' + escapeHtml(fullPath) + '\', this)" title="' + escapeHtml(fullPath) + '">' +
            '<span class="tree-icon">' + fileIcon(name, false) + '</span>' +
            '<span class="tree-label ' + getExtClass(name, false) + '">' + escapeHtml(name) + '</span>' +
            '</div>';
    });

    if (dirs.length === 0 && files.length === 0) {
        html = '<div class="empty-state">Empty directory</div>';
    }

    tree.innerHTML = html;
}

async function toggleDir(el, dirPath) {
    const name = dirPath.split('/').filter(Boolean).pop() || '';
    const childrenDiv = document.getElementById('children-' + escapeHtml(name));
    if (!childrenDiv) return;
    const toggleSpan = el.querySelector('.tree-toggle');

    if (childrenDiv.classList.contains('collapsed')) {
        // Load if empty
        if (childrenDiv.innerHTML.trim() === '') {
            childrenDiv.innerHTML = '<div style="padding:4px 0 4px 18px;font-size:11px;color:#6060a0;"><span class="spinner"></span></div>';
            try {
                const resp = await fetch('/api/dve/{{ .DVEID }}/workspace/ls?path=' + encodeURIComponent(dirPath));
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                const data = await resp.json();
                const entries = data.entries || data.files || data.children || [];
                let html = '';
                entries.forEach(function(e) {
                    const iname = e.name || e.path || '';
                    const ifullPath = e.path || (dirPath === '/' ? '/' + iname : dirPath.replace(/\/+$/, '') + '/' + iname);
                    if (e.is_dir || e.type === 'dir') {
                        html += '<div class="tree-node" onclick="toggleDir(this, \'' + escapeHtml(ifullPath) + '\')" title="' + escapeHtml(ifullPath) + '">' +
                            '<span class="tree-toggle" id="toggle-' + escapeHtml(iname) + '">&#x25B6;</span>' +
                            '<span class="tree-icon">📁</span>' +
                            '<span class="tree-label dir">' + escapeHtml(iname) + '</span>' +
                            '</div>' +
                            '<div class="tree-children collapsed" id="children-' + escapeHtml(iname) + '"></div>';
                    } else {
                        html += '<div class="tree-node" onclick="openFile(\'' + escapeHtml(ifullPath) + '\', this)" title="' + escapeHtml(ifullPath) + '">' +
                            '<span class="tree-icon">' + fileIcon(iname, false) + '</span>' +
                            '<span class="tree-label ' + getExtClass(iname, false) + '">' + escapeHtml(iname) + '</span>' +
                            '</div>';
                    }
                });
                if (!html) html = '<div class="empty-state" style="padding:6px 0 6px 18px;font-size:11px;">Empty directory</div>';
                childrenDiv.innerHTML = html;
            } catch (e) {
                childrenDiv.innerHTML = '<div style="padding:4px 0 4px 18px;font-size:11px;color:#e57373;">Error: ' + escapeHtml(e.message) + '</div>';
            }
        }
        childrenDiv.classList.remove('collapsed');
        if (toggleSpan) toggleSpan.innerHTML = '&#x25BC;';
    } else {
        childrenDiv.classList.add('collapsed');
        if (toggleSpan) toggleSpan.innerHTML = '&#x25B6;';
    }
}

async function openFile(filePath, el) {
    // Deselect previous
    document.querySelectorAll('.tree-node.selected').forEach(function(n) { n.classList.remove('selected'); });
    if (el) el.classList.add('selected');
    selectedFilePath = filePath;

    const toolbar = document.getElementById('file-toolbar');
    const nameEl = document.getElementById('file-name');
    const layerEl = document.getElementById('layer-badge');
    const sizeEl = document.getElementById('file-size');
    const preview = document.getElementById('file-preview');
    const placeholder = document.getElementById('file-placeholder');
    const errorEl = document.getElementById('file-error');

    toolbar.style.display = 'flex';
    nameEl.textContent = filePath.split('/').pop() || filePath;
    layerEl.textContent = '';
    layerEl.className = 'layer-badge';
    sizeEl.textContent = '';
    preview.style.display = 'none';
    errorEl.style.display = 'none';
    placeholder.style.display = 'flex';
    placeholder.innerHTML = '<span class="spinner"></span> Loading...';

    try {
        const resp = await fetch('/api/dve/{{ .DVEID }}/workspace/cat?path=' + encodeURIComponent(filePath));
        if (!resp.ok) {
            const e = await resp.json().catch(()=>({}));
            throw new Error(e.error || 'HTTP ' + resp.status);
        }
        const data = await resp.json();

        // Layer badge
        if (data.layer) {
            if (data.layer === 'lower' || data.layer === 'busybox' || data.layer === 'readonly') {
                layerEl.textContent = '🔒 ' + (data.layer || 'Lower');
                layerEl.className = 'layer-badge lower';
            } else {
                layerEl.textContent = '✏️ ' + (data.layer || 'Upper');
                layerEl.className = 'layer-badge upper';
            }
        } else if (data.readonly) {
            layerEl.textContent = '🔒 Lower';
            layerEl.className = 'layer-badge lower';
        } else {
            layerEl.textContent = '✏️ Upper';
            layerEl.className = 'layer-badge upper';
        }

        // Size
        sizeEl.textContent = data.size != null ? humanSize(data.size) : '';

        // Content
        if (data.content != null) {
            preview.textContent = data.content;
            preview.style.display = 'block';
            placeholder.style.display = 'none';
        } else if (data.error) {
            throw new Error(data.error);
        } else {
            preview.textContent = JSON.stringify(data, null, 2);
            preview.style.display = 'block';
            placeholder.style.display = 'none';
        }
    } catch (e) {
        errorEl.innerHTML = '&#x26A0; Error loading file: ' + escapeHtml(e.message);
        errorEl.style.display = 'flex';
        placeholder.style.display = 'none';
        logBoth('Failed to open ' + filePath + ': ' + e.message, 'error');
    }
}

async function downloadFile() {
    if (!selectedFilePath) return;
    const url = '/api/dve/{{ .DVEID }}/workspace/download?path=' + encodeURIComponent(selectedFilePath);
    try {
        const resp = await fetch(url);
        if (!resp.ok) throw new Error('Download failed');
        const blob = await resp.blob();
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = selectedFilePath.split('/').pop() || 'download';
        a.click();
        URL.revokeObjectURL(a.href);
        logBoth('Downloaded: ' + selectedFilePath, 'success');
    } catch (e) {
        logBoth('Download failed: ' + e.message, 'error');
    }
}

async function deleteFile() {
    if (!selectedFilePath) return;
    if (!confirm('Delete ' + selectedFilePath + '?')) return;
    try {
        const resp = await fetch('/api/dve/{{ .DVEID }}/workspace/rm?path=' + encodeURIComponent(selectedFilePath), {
            method: 'DELETE'
        });
        if (!resp.ok) {
            const e = await resp.json().catch(()=>({}));
            throw new Error(e.error || 'HTTP ' + resp.status);
        }
        logBoth('Deleted: ' + selectedFilePath, 'success');
        // Reload parent directory
        const parentDir = selectedFilePath.substring(0, selectedFilePath.lastIndexOf('/')) || '/';
        loadDir(parentDir);
        // Clear viewer
        document.getElementById('file-toolbar').style.display = 'none';
        document.getElementById('file-preview').style.display = 'none';
        document.getElementById('file-error').style.display = 'none';
        document.getElementById('file-placeholder').style.display = 'flex';
        document.getElementById('file-placeholder').innerHTML = '<div class="placeholder-icon">📁</div><span>Select a file from the sidebar to view its contents</span>';
        selectedFilePath = null;
    } catch (e) {
        logBoth('Delete failed: ' + e.message, 'error');
    }
}

function showUploadDialog() {
    const overlay = document.createElement('div');
    overlay.className = 'upload-overlay';
    overlay.innerHTML =
        '<div class="upload-dialog">' +
        '<h3>Upload File</h3>' +
        '<p style="font-size:12px;color:#8080c0;margin-bottom:8px;">Upload to: <code>' + escapeHtml(currentDir) + '</code></p>' +
        '<input type="file" id="upload-file-input" />' +
        '<div class="upload-dialog-actions">' +
        '<button class="file-action-btn" onclick="this.closest(\\'.upload-overlay\\').remove()">Cancel</button>' +
        '<button class="section-btn" onclick="doUpload()">Upload</button>' +
        '</div>' +
        '</div>';
    document.body.appendChild(overlay);
}

async function doUpload() {
    const input = document.getElementById('upload-file-input');
    if (!input || !input.files || !input.files[0]) {
        logBoth('No file selected for upload', 'warn');
        return;
    }
    const file = input.files[0];
    const formData = new FormData();
    formData.append('file', file);
    formData.append('path', currentDir);

    const overlay = document.querySelector('.upload-overlay');
    if (overlay) overlay.remove();

    logBoth('Uploading ' + file.name + '...', 'info');
    try {
        const resp = await fetch('/api/dve/{{ .DVEID }}/workspace/upload', {
            method: 'POST',
            body: formData
        });
        if (!resp.ok) {
            const e = await resp.json().catch(()=>({}));
            throw new Error(e.error || 'HTTP ' + resp.status);
        }
        logBoth('Uploaded: ' + file.name, 'success');
        loadDir(currentDir);
    } catch (e) {
        logBoth('Upload failed: ' + e.message, 'error');
    }
}

// Also auto-load explorer on page load since the files tab is active by default
document.addEventListener('DOMContentLoaded', function() {
    setTimeout(function() { loadDir('/'); }, 300);
});
</script>
</body>
</html>
{{ end }}
