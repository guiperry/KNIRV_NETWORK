{{/* validation_records.gohtml — standalone template for public DVE validation records page. */}}
{{ define "validation_records" }}
<div class="validation-records">
    <h2>Validation Records</h2>
    <p class="subtitle">Public audit trail for DVE {{ .DVEID }}</p>
    {{ template "search_form" . }}
    <div class="records-table">
        {{ if .Records }}
        <table>
            <thead>
                <tr>
                    <th>Validation ID</th>
                    <th>Task Type</th>
                    <th>Status</th>
                    <th>Score</th>
                    <th>Validator</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                {{ range .Records }}
                <tr class="record-row">
                    <td class="mono">{{ .ID }}</td>
                    <td>{{ .Type }}</td>
                    <td><span class="status-badge {{ .Status }}">{{ .Status }}</span></td>
                    <td class="score">{{ .Score }}</td>
                    <td class="mono">{{ .ValidatorNodeID }}</td>
                    <td>{{ .CreatedAt }}</td>
                </tr>
                {{ end }}
            </tbody>
        </table>
        {{ else }}
        <div class="empty-state">
            <p>No validation records found.</p>
            <p class="hint">Validation records appear here when tasks are executed and verified by DVE validators.</p>
        </div>
        {{ end }}
    </div>
    <div class="pagination">
        <span class="count">Showing {{ len .Records }} of {{ .Total }} records</span>
    </div>
</div>

<style>
    .validation-records { margin-top: 20px; }
    .subtitle { color: #666; font-size: 14px; margin-bottom: 20px; }
    .records-table table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    .records-table th { 
        text-align: left; 
        padding: 10px 8px; 
        border-bottom: 2px solid #e0e0e0; 
        font-size: 11px; 
        text-transform: uppercase; 
        color: #888; 
        letter-spacing: 0.5px;
    }
    .records-table td { 
        padding: 10px 8px; 
        border-bottom: 1px solid #f0f0f0; 
        font-size: 13px; 
    }
    .mono { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 12px; color: #555; }
    .status-badge { 
        display: inline-block;
        padding: 2px 8px; 
        border-radius: 10px; 
        font-size: 11px; 
        font-weight: 600;
        text-transform: uppercase;
    }
    .status-badge.success { background: #e6f4ea; color: #1e7e34; }
    .status-badge.failure { background: #fce8e6; color: #c62828; }
    .status-badge.error { background: #fff3e0; color: #e65100; }
    .status-badge.pending { background: #e3f2fd; color: #1565c0; }
    .score { font-weight: 600; color: #333; }
    .empty-state { text-align: center; padding: 40px 20px; color: #999; }
    .empty-state p { margin: 8px 0; }
    .hint { font-size: 13px; color: #bbb; }
    .pagination { margin-top: 16px; text-align: right; }
    .count { font-size: 13px; color: #888; }
    .record-row:hover { background: #fafafa; }
</style>
{{ end }}
