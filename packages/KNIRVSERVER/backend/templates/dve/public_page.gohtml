{{ define "header" }}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DVE {{ .DVEID }} - Public Validation Page</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f5f5f5; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        header { background: #fff; padding: 20px; border-bottom: 1px solid #e0e0e0; margin-bottom: 20px; }
        h1 { font-size: 24px; color: #333; }
        .badge { display: inline-block; background: #4CAF50; color: #fff; padding: 4px 12px; border-radius: 12px; font-size: 12px; margin-left: 10px; }
        .content { display: grid; grid-template-columns: 1fr 300px; gap: 20px; }
        .main-panel { background: #fff; padding: 20px; border-radius: 8px; }
        .sidebar { background: #fff; padding: 20px; border-radius: 8px; }
        @media (max-width: 768px) { .content { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
{{ end }}

{{ define "content" }}
<div class="container">
    <header>
        <h1>DVE: {{ .DVEID }} <span class="badge">{{ .Status }}</span></h1>
    </header>
    
    <div class="content">
        <div class="main-panel">
            {{ template "validation_records" . }}
        </div>
        <div class="sidebar">
            {{ template "metrics_panel" . }}
        </div>
    </div>
</div>
{{ end }}

{{ define "validation_records" }}
<h2>Validation Records</h2>
{{ template "search_form" . }}
<div id="validation-records">
    <p>No validation records found.</p>
</div>
{{ end }}

{{ define "search_form" }}
<form method="get" action="/dve/{{ .DVEID }}/search" style="margin: 20px 0;">
    <input type="text" name="q" placeholder="Search validations..." style="padding: 8px; width: 300px;">
    <button type="submit" style="padding: 8px 16px;">Search</button>
</form>
{{ end }}

{{ define "metrics_panel" }}
<h3>Metrics</h3>
<ul>
    <li>Total Validations: {{ .Metrics.TotalValidations }}</li>
    <li>Success Rate: {{ .Metrics.SuccessRate }}%</li>
    <li>Average Score: {{ .Metrics.AverageScore }}</li>
</ul>
{{ end }}