{
  "name": "@knirv/sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Unified TypeScript/JavaScript SDK for KNIRV Network - Gateway, Transaction, and Transmission APIs",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:rollup": "rollup -c",
    "build:all": "npm run build && npm run build:rollup",
    "build:watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "docs": "typedoc src/index.ts",
    "prepublishOnly": "npm run build",
    "dev": "npm run build:watch"
  },
  "keywords": [
    "knirv",
    "knirvchain",
    "gateway",
    "transaction",
    "transmission",
    "blockchain",
    "p2p",
    "sdk",
    "typescript",
    "javascript"
  ],
  "author": "KNIRV Network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/knirv-network/knirv-sdk.git",
    "directory": "ts/unified"
  },
  "bugs": {
    "url": "https://github.com/knirv-network/knirv-sdk/issues"
  },
  "homepage": "https://github.com/knirv-network/knirv-sdk#readme",
  "dependencies": {
    "@cosmjs/crypto": "^0.34.0",
    "@cosmjs/ledger-amino": "^0.34.0",
    "@gnolang/tm2-js-client": "^1.3.0",
    "@noble/hashes": "^1.3.3",
    "bech32": "^2.0.0",
    "libp2p": "^1.0.0",
    "multiformats": "^13.0.0",
    "uint8arrays": "^5.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "29.5.12",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.56.0",
    "jest": "29.7.0",
    "rollup": "4.34.8",
    "rollup-plugin-dts": "^6.1.0",
    "ts-jest": "29.1.2",
    "tslib": "^2.5.0",
    "typedoc": "^0.24.0",
    "typescript": "4.9.5"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./gateway": {
      "import": "./dist/gateway.esm.js",
      "require": "./dist/gateway.js",
      "types": "./dist/gateway.d.ts"
    },
    "./transaction": {
      "import": "./dist/transaction.esm.js",
      "require": "./dist/transaction.js",
      "types": "./dist/transaction.d.ts"
    },
    "./transmission": {
      "import": "./dist/transmission.esm.js",
      "require": "./dist/transmission.js",
      "types": "./dist/transmission.d.ts"
    },
    "./wallet": {
      "import": "./dist/wallet.esm.js",
      "require": "./dist/wallet.js",
      "types": "./dist/wallet.d.ts"
    },
    "./signing": {
      "import": "./dist/signing.js",
      "require": "./dist/signing.js",
      "types": "./dist/signing.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
