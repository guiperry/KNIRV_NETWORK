{
  "version": 1,
  "resource_types": [
    "chain", "nrn", "ulora", "mcpcontext", "resource", "tool", "prompt",
    "memoryservice", "memory", "capability", "dev", "errornode", "skillnode",
    "ideanode", "propertynode", "usdscene", "usdasset"
  ],
  "query_keys": ["tenant", "snapshot", "sha256"],
  "derive": [
    { "raw": "foo_bar", "id": "jeumv2ftpm6rce7v4apgbslh35wcxhuc" },
    { "raw": "a:b", "id": "m6b2ghvl62gmybta7e24batcqk65eja7" },
    { "raw": "a.b", "id": "fzztnxeoxkd66rzn6vumgvecvpzfoxod" },
    { "raw": "Foo_Bar", "id": "mhnt6iwqudwmfmzrxf4v3neftkvquyuk" },
    { "raw": "ab_c", "id": "g5rhsddefmb7inmnd4igobi5tp3wzqwb" },
    { "raw": "é", "id": "jkmvk7sagpbvhhpc5nsuoiaxzlk7svl7" }
  ],
  "cases": [
    {
      "name": "canonical roundtrip",
      "input": "knirv://abc.usdscene/?tenant=t1&snapshot=aa",
      "kind": "canonical",
      "canonical": "knirv://abc.usdscene/?snapshot=aa&tenant=t1",
      "id": "abc",
      "resource_type": "usdscene",
      "path": "/",
      "query": { "snapshot": "aa", "tenant": "t1" }
    },
    {
      "name": "unsorted query is sorted",
      "input": "knirv://abc.errornode/?tenant=t1&sha256=cc&snapshot=bb",
      "kind": "canonical",
      "canonical": "knirv://abc.errornode/?sha256=cc&snapshot=bb&tenant=t1",
      "id": "abc",
      "resource_type": "errornode",
      "path": "/",
      "query": { "sha256": "cc", "snapshot": "bb", "tenant": "t1" }
    },
    {
      "name": "uppercase host and scheme are lowercased",
      "input": "KNIRV://ABC.USDSCENE/?tenant=t1",
      "kind": "canonical",
      "canonical": "knirv://abc.usdscene/?tenant=t1",
      "id": "abc",
      "resource_type": "usdscene",
      "path": "/",
      "query": { "tenant": "t1" }
    },
    {
      "name": "bad host with three labels",
      "input": "knirv://a.b.c/",
      "kind": "invalid",
      "reason": "host must have exactly two labels"
    },
    {
      "name": "legacy plain dve id",
      "input": "knirv://dve123",
      "kind": "legacy_dve",
      "canonical": "knirv://dve123",
      "legacy_dve": { "form": "id", "id": "dve123" }
    },
    {
      "name": "legacy hash and dve id",
      "input": "knirv://abcdef123456/dve123",
      "kind": "legacy_dve",
      "canonical": "knirv://abcdef123456/dve123",
      "legacy_dve": { "form": "hash/id", "id": "dve123", "hash": "abcdef123456" }
    },
    {
      "name": "legacy dve path form",
      "input": "knirv://dve/dve123/scene-name",
      "kind": "legacy_dve",
      "canonical": "knirv://dve/dve123/scene-name",
      "legacy_dve": { "form": "dve/id/name", "id": "dve123", "name": "scene-name" }
    },
    {
      "name": "content pointer",
      "input": "knirv://network/skill_ab12",
      "kind": "content_pointer",
      "canonical": "knirv://network/skill_ab12",
      "content_pointer": { "kind": "skill", "hash": "ab12" }
    },
    {
      "name": "auth action",
      "input": "knirv://auth?token=abc&z=1",
      "kind": "action",
      "canonical": "knirv://auth?token=abc&z=1",
      "action": { "name": "auth", "query": { "token": "abc", "z": "1" }, "canonical": "knirv://auth?token=abc&z=1" }
    },
    {
      "name": "sign action",
      "input": "knirv://sign?tenant=t&intent=login",
      "kind": "action",
      "canonical": "knirv://sign?intent=login&tenant=t",
      "action": { "name": "sign", "query": { "intent": "login", "tenant": "t" }, "canonical": "knirv://sign?intent=login&tenant=t" }
    },
    {
      "name": "unknown resource type",
      "input": "knirv://abc.foo/",
      "kind": "invalid",
      "reason": "unknown resource type: foo"
    },
    {
      "name": "derived id for underscore",
      "input": "knirv://foo_bar.usdscene/",
      "kind": "canonical",
      "canonical": "knirv://jeumv2ftpm6rce7v4apgbslh35wcxhuc.usdscene/",
      "id": "jeumv2ftpm6rce7v4apgbslh35wcxhuc",
      "resource_type": "usdscene",
      "path": "/",
      "query": {}
    },
    {
      "name": "empty path gets trailing slash",
      "input": "knirv://abc.chain",
      "kind": "canonical",
      "canonical": "knirv://abc.chain/",
      "id": "abc",
      "resource_type": "chain",
      "path": "/",
      "query": {}
    },
    {
      "name": "query values are percent encoded",
      "input": "knirv://abc.chain/?tenant=a%20b%2Fc",
      "kind": "canonical",
      "canonical": "knirv://abc.chain/?tenant=a%20b%2Fc",
      "id": "abc",
      "resource_type": "chain",
      "path": "/",
      "query": { "tenant": "a b/c" }
    },
    {
      "name": "usdasset id is a sha256 prefix",
      "input": "knirv://0123456789abcdef0123456789abcdef.usdasset/?sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "kind": "canonical",
      "canonical": "knirv://0123456789abcdef0123456789abcdef.usdasset/?sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "id": "0123456789abcdef0123456789abcdef",
      "resource_type": "usdasset",
      "path": "/",
      "query": { "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" }
    },
    {
      "name": "usdasset id is not a sha256 prefix",
      "input": "knirv://deadbeef.usdasset/?sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "kind": "invalid",
      "reason": "usdasset id must be a prefix of sha256"
    },
    {
      "name": "userinfo is rejected",
      "input": "knirv://user@abc.chain/",
      "kind": "invalid",
      "reason": "userinfo is not allowed"
    },
    {
      "name": "port is rejected",
      "input": "knirv://abc.chain:8080/",
      "kind": "invalid",
      "reason": "host must be a single DNS label"
    },
    {
      "name": "fragment is rejected",
      "input": "knirv://abc.chain/#frag",
      "kind": "invalid",
      "reason": "fragment is not allowed"
    },
    {
      "name": "empty id is rejected",
      "input": "knirv://.chain/",
      "kind": "invalid",
      "reason": "id must not be empty"
    },
    {
      "name": "other scheme is rejected",
      "input": "http://abc.chain/",
      "kind": "invalid",
      "reason": "scheme must be knirv://"
    },
    {
      "name": "empty input is malformed",
      "input": "",
      "kind": "invalid",
      "reason": "malformed URI"
    },
    {
      "name": "surrounding whitespace is trimmed",
      "input": "  knirv://abc.chain/  ",
      "kind": "canonical",
      "canonical": "knirv://abc.chain/",
      "id": "abc",
      "resource_type": "chain",
      "path": "/",
      "query": {}
    },
    {
      "name": "sub path and its case are preserved",
      "input": "knirv://ABC-123.Chain/X/Y?x=1",
      "kind": "canonical",
      "canonical": "knirv://abc-123.chain/X/Y?x=1",
      "id": "abc-123",
      "resource_type": "chain",
      "path": "/X/Y",
      "query": {
        "x": "1"
      }
    },
    {
      "name": "percent encoded path is preserved",
      "input": "knirv://abc.chain/a%20b",
      "kind": "canonical",
      "canonical": "knirv://abc.chain/a%20b",
      "id": "abc",
      "resource_type": "chain",
      "path": "/a%20b",
      "query": {}
    },
    {
      "name": "dot segments are resolved",
      "input": "knirv://abc.chain/../x",
      "kind": "canonical",
      "canonical": "knirv://abc.chain/x",
      "id": "abc",
      "resource_type": "chain",
      "path": "/x",
      "query": {}
    },
    {
      "name": "id longer than 63 is derived",
      "input": "knirv://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.chain/",
      "kind": "canonical",
      "canonical": "knirv://rl4idpeirfn5twgovf22pudnyatv3hnz.chain/",
      "id": "rl4idpeirfn5twgovf22pudnyatv3hnz",
      "resource_type": "chain",
      "path": "/",
      "query": {}
    },
    {
      "name": "empty query marker is dropped",
      "input": "knirv://abc.chain?",
      "kind": "canonical",
      "canonical": "knirv://abc.chain/",
      "id": "abc",
      "resource_type": "chain",
      "path": "/",
      "query": {}
    },
    {
      "name": "content pointer hash may contain underscores",
      "input": "knirv://network/skill_a_b",
      "kind": "content_pointer",
      "canonical": "knirv://network/skill_a_b",
      "content_pointer": {
        "kind": "skill",
        "hash": "a_b"
      }
    },
    {
      "name": "content pointer without underscore",
      "input": "knirv://network/skill",
      "kind": "invalid",
      "reason": "content pointer must be network/<kind>_<hash>"
    },
    {
      "name": "content pointer without path",
      "input": "knirv://network/",
      "kind": "invalid",
      "reason": "content pointer must be network/<kind>_<hash>"
    },
    {
      "name": "content pointer with extra segment",
      "input": "knirv://network/a/b_c",
      "kind": "invalid",
      "reason": "content pointer must be network/<kind>_<hash>"
    },
    {
      "name": "legacy host with extra path segments is not a legacy shape",
      "input": "knirv://abc/def/ghi",
      "kind": "invalid",
      "reason": "unrecognised legacy URI shape"
    },
    {
      "name": "auth action without query",
      "input": "knirv://auth",
      "kind": "action",
      "canonical": "knirv://auth",
      "action": {
        "name": "auth",
        "query": {},
        "canonical": "knirv://auth"
      }
    }
  ]
}
