// HEART Processing Element Kernel
// Implements transformer inference on a single PE of the Cerebras WSE
//
// Each PE processes a portion of the sequence and embedding dimensions
// Collaborates with other PEs via routing colors for attention computation

param memcpy_params: comptime_struct;
param px: u16;  // PE x-coordinate
param py: u16;  // PE y-coordinate

// Grid dimensions
param GRID_WIDTH: u16;
param GRID_HEIGHT: u16;

// Per-PE workload
param SEQ_PER_PE: u16;      // Sequence positions handled by this PE
param EMBED_PER_PE: u16;    // Embedding dimensions handled by this PE

// Model parameters
param SEQUENCE_LENGTH: u16;
param NUM_NODES: u16;
param EMBEDDING_DIM: u16;
param NUM_HEADS: u16;
param NUM_LAYERS: u16;
param MEASURE_VEC_SIZE: u16;
param CONTROL_VEC_SIZE: u16;

// Colors for communication
param attn_color_0: color;
param attn_color_1: color;
param embed_color: color;
param seq_color: color;
param data_in_color: color;
param data_out_color: color;

// Task IDs
param main_entrypt: local_task_id;
param ffn_entrypt: local_task_id;
param norm_entrypt: local_task_id;
param output_entrypt: local_task_id;
param EXIT: local_task_id;
param compute_task_id: local_task_id;
param attn_task_id: local_task_id;
param ffn_task_id: local_task_id;
param norm_task_id: local_task_id;
param output_task_id: local_task_id;

// Import memcpy module
const sys_mod = @import_module("&lt;memcpy/memcpy&gt;", memcpy_params);

// Calculate HEAD_DIM
const HEAD_DIM: u16 = EMBEDDING_DIM / NUM_HEADS;
const FFN_HIDDEN_DIM: u16 = EMBEDDING_DIM * 4;

// ============================================================================
// LOCAL MEMORY BUFFERS
// ============================================================================

// Input data for this PE's portion of the sequence
var measurement_buffer = @zeros([SEQ_PER_PE * MEASURE_VEC_SIZE]f32);
var node_id_buffer = @zeros([SEQ_PER_PE]u32);
var t_slice_buffer = @zeros([SEQ_PER_PE]u32);

// Embedding layer output (SEQ_PER_PE x EMBED_PER_PE)
var embedded_seq = @zeros([SEQ_PER_PE * EMBED_PER_PE]f32);

// Attention computation buffers
var query_buffer = @zeros([SEQ_PER_PE * HEAD_DIM]f32);
var key_buffer = @zeros([SEQ_PER_PE * HEAD_DIM]f32);
var value_buffer = @zeros([SEQ_PER_PE * HEAD_DIM]f32);
var attn_scores = @zeros([SEQ_PER_PE * SEQUENCE_LENGTH]f32);
var attn_output = @zeros([SEQ_PER_PE * EMBED_PER_PE]f32);

// Feed-forward network buffers
var ffn_hidden = @zeros([SEQ_PER_PE * (FFN_HIDDEN_DIM / GRID_HEIGHT)]f32);
var ffn_output = @zeros([SEQ_PER_PE * EMBED_PER_PE]f32);

// Layer normalization buffers
var norm_mean = @zeros([SEQ_PER_PE]f32);
var norm_var = @zeros([SEQ_PER_PE]f32);

// Output buffer (CONTROL_VEC_SIZE per sequence position)
var output_buffer = @zeros([SEQ_PER_PE * CONTROL_VEC_SIZE]f32);

// Model weights (shared across all PEs via weight sharing)
// Weights are loaded once and reused for all inference
var embedding_weights_local = @zeros([MEASURE_VEC_SIZE * EMBEDDING_DIM]f32);
var positional_encoding_local = @zeros([SEQUENCE_LENGTH * EMBEDDING_DIM]f32);

// Attention weights per layer and head
// Simplified: we'll store weights for the portion this PE handles
var wq_weights = @zeros([NUM_LAYERS * EMBED_PER_PE * HEAD_DIM]f32);
var wk_weights = @zeros([NUM_LAYERS * EMBED_PER_PE * HEAD_DIM]f32);
var wv_weights = @zeros([NUM_LAYERS * EMBED_PER_PE * HEAD_DIM]f32);
var wo_weights = @zeros([NUM_LAYERS * HEAD_DIM * EMBED_PER_PE]f32);

// Feed-forward weights
var w1_weights = @zeros([NUM_LAYERS * EMBED_PER_PE * (FFN_HIDDEN_DIM / GRID_HEIGHT)]f32);
var w2_weights = @zeros([NUM_LAYERS * (FFN_HIDDEN_DIM / GRID_HEIGHT) * EMBED_PER_PE]f32);

// Output projection weights
var output_proj_weights = @zeros([EMBED_PER_PE * CONTROL_VEC_SIZE]f32);

// Pointers for host access
var ptr_measurement_in: [*]f32 = &measurement_buffer;
var ptr_node_id_in: [*]u32 = &node_id_buffer;
var ptr_t_slice_in: [*]u32 = &t_slice_buffer;
var ptr_output: [*]f32 = &output_buffer;
var ptr_embedding_weights: [*]f32 = &embedding_weights_local;
var ptr_positional_encoding: [*]f32 = &positional_encoding_local;

// State variables
var current_layer: u16 = 0;
var current_head: u16 = 0;
var processing_complete: bool = false;

// ============================================================================
// COMPUTATION KERNELS
// ============================================================================

// Embedding layer: maps measurement vectors to embedding space
fn compute_embedding() void {
  var seq_idx: u16 = 0;
  while (seq_idx < SEQ_PER_PE) : (seq_idx += 1) {
    var emb_idx: u16 = 0;
    while (emb_idx < EMBED_PER_PE) : (emb_idx += 1) {
      const global_emb_idx = py * EMBED_PER_PE + emb_idx;
      var sum: f32 = 0.0;

      // Linear projection from measurement vector
      var measure_idx: u16 = 0;
      while (measure_idx < MEASURE_VEC_SIZE) : (measure_idx += 1) {
        const measurement = measurement_buffer[seq_idx * MEASURE_VEC_SIZE + measure_idx];
        const weight = embedding_weights_local[measure_idx * EMBEDDING_DIM + global_emb_idx];
        sum += measurement * weight;
      }

      // Add positional encoding
      const global_seq_idx = px * SEQ_PER_PE + seq_idx;
      const pos_enc = positional_encoding_local[global_seq_idx * EMBEDDING_DIM + global_emb_idx];
      sum += pos_enc;

      embedded_seq[seq_idx * EMBED_PER_PE + emb_idx] = sum;
    }
  }
}

// Layer normalization
fn layer_norm(input: [*]f32, output: [*]f32) void {
  var seq_idx: u16 = 0;
  while (seq_idx < SEQ_PER_PE) : (seq_idx += 1) {
    // Compute mean
    var sum: f32 = 0.0;
    var emb_idx: u16 = 0;
    while (emb_idx < EMBED_PER_PE) : (emb_idx += 1) {
      sum += input[seq_idx * EMBED_PER_PE + emb_idx];
    }
    const mean = sum / @int2float(EMBED_PER_PE);
    norm_mean[seq_idx] = mean;

    // Compute variance
    var var_sum: f32 = 0.0;
    emb_idx = 0;
    while (emb_idx < EMBED_PER_PE) : (emb_idx += 1) {
      const diff = input[seq_idx * EMBED_PER_PE + emb_idx] - mean;
      var_sum += diff * diff;
    }
    const variance = var_sum / @int2float(EMBED_PER_PE);
    norm_var[seq_idx] = variance;

    // Normalize
    const eps: f32 = 1.0e-5;
    const std_inv = 1.0 / @sqrt(variance + eps);
    emb_idx = 0;
    while (emb_idx < EMBED_PER_PE) : (emb_idx += 1) {
      const normalized = (input[seq_idx * EMBED_PER_PE + emb_idx] - mean) * std_inv;
      output[seq_idx * EMBED_PER_PE + emb_idx] = normalized;
    }
  }
}

// Multi-head self-attention (simplified for single PE)
fn compute_attention(layer: u16, input: [*]f32, output: [*]f32) void {
  const weight_offset = layer * EMBED_PER_PE * HEAD_DIM;

  // Compute Q, K, V projections
  var seq_idx: u16 = 0;
  while (seq_idx < SEQ_PER_PE) : (seq_idx += 1) {
    var head_idx: u16 = 0;
    while (head_idx < HEAD_DIM) : (head_idx += 1) {
      var sum_q: f32 = 0.0;
      var sum_k: f32 = 0.0;
      var sum_v: f32 = 0.0;

      var emb_idx: u16 = 0;
      while (emb_idx < EMBED_PER_PE) : (emb_idx += 1) {
        const inp = input[seq_idx * EMBED_PER_PE + emb_idx];
        sum_q += inp * wq_weights[weight_offset + emb_idx * HEAD_DIM + head_idx];
        sum_k += inp * wk_weights[weight_offset + emb_idx * HEAD_DIM + head_idx];
        sum_v += inp * wv_weights[weight_offset + emb_idx * HEAD_DIM + head_idx];
      }

      query_buffer[seq_idx * HEAD_DIM + head_idx] = sum_q;
      key_buffer[seq_idx * HEAD_DIM + head_idx] = sum_k;
      value_buffer[seq_idx * HEAD_DIM + head_idx] = sum_v;
    }
  }

  // Compute attention scores (Q @ K^T / sqrt(HEAD_DIM))
  const scale = 1.0 / @sqrt(@int2float(HEAD_DIM));
  var seq_i: u16 = 0;
  while (seq_i < SEQ_PER_PE) : (seq_i += 1) {
    var seq_j: u16 = 0;
    while (seq_j < SEQ_PER_PE) : (seq_j += 1) {
      var dot: f32 = 0.0;
      var head_idx: u16 = 0;
      while (head_idx < HEAD_DIM) : (head_idx += 1) {
        dot += query_buffer[seq_i * HEAD_DIM + head_idx] *
               key_buffer[seq_j * HEAD_DIM + head_idx];
      }
      attn_scores[seq_i * SEQUENCE_LENGTH + (px * SEQ_PER_PE + seq_j)] = dot * scale;
    }
  }

  // Apply softmax (simplified - within PE only)
  seq_i = 0;
  while (seq_i < SEQ_PER_PE) : (seq_i += 1) {
    // Find max for numerical stability
    var max_score: f32 = attn_scores[seq_i * SEQUENCE_LENGTH];
    var j: u16 = 1;
    while (j < SEQ_PER_PE) : (j += 1) {
      const score = attn_scores[seq_i * SEQUENCE_LENGTH + (px * SEQ_PER_PE + j)];
      if (score > max_score) {
        max_score = score;
      }
    }

    // Compute exp and sum
    var exp_sum: f32 = 0.0;
    j = 0;
    while (j < SEQ_PER_PE) : (j += 1) {
      const idx = seq_i * SEQUENCE_LENGTH + (px * SEQ_PER_PE + j);
      const exp_val = @exp2(attn_scores[idx] - max_score);  // exp2 for efficiency
      attn_scores[idx] = exp_val;
      exp_sum += exp_val;
    }

    // Normalize
    j = 0;
    while (j < SEQ_PER_PE) : (j += 1) {
      const idx = seq_i * SEQUENCE_LENGTH + (px * SEQ_PER_PE + j);
      attn_scores[idx] /= exp_sum;
    }
  }

  // Compute attention output (scores @ V)
  seq_i = 0;
  while (seq_i < SEQ_PER_PE) : (seq_i += 1) {
    var head_idx: u16 = 0;
    while (head_idx < HEAD_DIM) : (head_idx += 1) {
      var weighted_sum: f32 = 0.0;
      var seq_j: u16 = 0;
      while (seq_j < SEQ_PER_PE) : (seq_j += 1) {
        const score = attn_scores[seq_i * SEQUENCE_LENGTH + (px * SEQ_PER_PE + seq_j)];
        weighted_sum += score * value_buffer[seq_j * HEAD_DIM + head_idx];
      }
      attn_output[seq_i * EMBED_PER_PE + head_idx] = weighted_sum;
    }
  }

  // Output projection
  const out_weight_offset = layer * HEAD_DIM * EMBED_PER_PE;
  seq_idx = 0;
  while (seq_idx < SEQ_PER_PE) : (seq_idx += 1) {
    var emb_idx: u16 = 0;
    while (emb_idx < EMBED_PER_PE) : (emb_idx += 1) {
      var sum: f32 = 0.0;
      var head_idx: u16 = 0;
      while (head_idx < HEAD_DIM) : (head_idx += 1) {
        sum += attn_output[seq_idx * EMBED_PER_PE + head_idx] *
               wo_weights[out_weight_offset + head_idx * EMBED_PER_PE + emb_idx];
      }
      output[seq_idx * EMBED_PER_PE + emb_idx] = sum;
    }
  }
}

// Feed-forward network with GELU activation
fn compute_ffn(layer: u16, input: [*]f32, output: [*]f32) void {
  const w1_offset = layer * EMBED_PER_PE * (FFN_HIDDEN_DIM / GRID_HEIGHT);
  const w2_offset = layer * (FFN_HIDDEN_DIM / GRID_HEIGHT) * EMBED_PER_PE;
  const hidden_per_pe = FFN_HIDDEN_DIM / GRID_HEIGHT;

  // First linear layer
  var seq_idx: u16 = 0;
  while (seq_idx < SEQ_PER_PE) : (seq_idx += 1) {
    var hidden_idx: u16 = 0;
    while (hidden_idx < hidden_per_pe) : (hidden_idx += 1) {
      var sum: f32 = 0.0;
      var emb_idx: u16 = 0;
      while (emb_idx < EMBED_PER_PE) : (emb_idx += 1) {
        sum += input[seq_idx * EMBED_PER_PE + emb_idx] *
               w1_weights[w1_offset + emb_idx * hidden_per_pe + hidden_idx];
      }

      // GELU activation (approximated with tanh)
      const x = sum;
      const sqrt_2_pi: f32 = 0.7978845608;  // sqrt(2/pi)
      const coeff: f32 = 0.044715;
      const tanh_arg = sqrt_2_pi * (x + coeff * x * x * x);
      const gelu = 0.5 * x * (1.0 + @tanh(tanh_arg));

      ffn_hidden[seq_idx * hidden_per_pe + hidden_idx] = gelu;
    }
  }

  // Second linear layer
  seq_idx = 0;
  while (seq_idx < SEQ_PER_PE) : (seq_idx += 1) {
    var emb_idx: u16 = 0;
    while (emb_idx < EMBED_PER_PE) : (emb_idx += 1) {
      var sum: f32 = 0.0;
      var hidden_idx: u16 = 0;
      while (hidden_idx < hidden_per_pe) : (hidden_idx += 1) {
        sum += ffn_hidden[seq_idx * hidden_per_pe + hidden_idx] *
               w2_weights[w2_offset + hidden_idx * EMBED_PER_PE + emb_idx];
      }
      output[seq_idx * EMBED_PER_PE + emb_idx] = sum;
    }
  }
}

// Output projection to control vector
fn compute_output() void {
  var seq_idx: u16 = 0;
  while (seq_idx < SEQ_PER_PE) : (seq_idx += 1) {
    var ctrl_idx: u16 = 0;
    while (ctrl_idx < CONTROL_VEC_SIZE) : (ctrl_idx += 1) {
      var sum: f32 = 0.0;
      var emb_idx: u16 = 0;
      while (emb_idx < EMBED_PER_PE) : (emb_idx += 1) {
        sum += embedded_seq[seq_idx * EMBED_PER_PE + emb_idx] *
               output_proj_weights[emb_idx * CONTROL_VEC_SIZE + ctrl_idx];
      }
      output_buffer[seq_idx * CONTROL_VEC_SIZE + ctrl_idx] = sum;
    }
  }

  // Copy node IDs and time slices to output (for synchronization)
  seq_idx = 0;
  while (seq_idx < SEQ_PER_PE) : (seq_idx += 1) {
    ptr_node_id_in[seq_idx] = node_id_buffer[seq_idx];
    ptr_t_slice_in[seq_idx] = t_slice_buffer[seq_idx];
  }
}

// ============================================================================
// TASK DEFINITIONS
// ============================================================================

// Main computation task - orchestrates the full transformer forward pass
task compute_main() void {
  // 1. Embedding layer
  compute_embedding();

  // 2. Process through transformer layers
  current_layer = 0;
  while (current_layer < NUM_LAYERS) : (current_layer += 1) {
    // Pre-norm: Layer normalization before attention
    var norm_input: [*]f32 = &embedded_seq;
    var norm_output: [*]f32 = &attn_output;
    layer_norm(norm_input, norm_output);

    // Multi-head self-attention
    compute_attention(current_layer, norm_output, attn_output);

    // Residual connection
    var seq_idx: u16 = 0;
    while (seq_idx < SEQ_PER_PE * EMBED_PER_PE) : (seq_idx += 1) {
      embedded_seq[seq_idx] += attn_output[seq_idx];
    }

    // Pre-norm: Layer normalization before FFN
    layer_norm(&embedded_seq, &attn_output);

    // Feed-forward network
    compute_ffn(current_layer, &attn_output, &ffn_output);

    // Residual connection
    seq_idx = 0;
    while (seq_idx < SEQ_PER_PE * EMBED_PER_PE) : (seq_idx += 1) {
      embedded_seq[seq_idx] += ffn_output[seq_idx];
    }
  }

  // 3. Final layer norm
  layer_norm(&embedded_seq, &attn_output);
  var i: u16 = 0;
  while (i < SEQ_PER_PE * EMBED_PER_PE) : (i += 1) {
    embedded_seq[i] = attn_output[i];
  }

  // 4. Output projection
  compute_output();

  processing_complete = true;
  @activate(EXIT);
}

// Main entry point called by host
fn main() void {
  processing_complete = false;
  @activate(compute_task_id);
}

// Exit task
task f_exit() void {
  sys_mod.unblock_cmd_stream();
}

comptime {
  @bind_local_task(f_exit, EXIT);
  @bind_local_task(compute_main, compute_task_id);

  @export_symbol(ptr_measurement_in, "measurement_vec_in");
  @export_symbol(ptr_node_id_in, "node_id_in");
  @export_symbol(ptr_t_slice_in, "t_slice_in");
  @export_symbol(ptr_output, "heuristic_commands_out");
  @export_symbol(ptr_embedding_weights, "embedding_weights");
  @export_symbol(ptr_positional_encoding, "positional_encoding");
  @export_symbol(main);
}
