  },
  "engines": {
    "node": ">=20.0.0",
    "rust": ">=1.70.0"
  },
  "keywords": [
    "error",
    "resolution",
    "ai",
    "blockchain",
    "lora",
    "cognitive-shell",
    "wasm",
    "agent-core",
    "neural-networks",
    "unified",
    "frontend",
    "slideout",
    "manager",
    "qr-scanner"
  ],
  "scripts": {
    "analyze-bundle": "ANALYZE=true vite build",
    "build": "tsc --noEmit && vite build",
    "build:android": "npm run build:eas -- --platform android",
    "build:eas": "sh scripts/build-with-eas.sh",
    "build:flatbuffers": "mkdir -p src/flatbuffers && flatc --ts -o src/flatbuffers/ schemas/player.fbs schemas/agent.fbs",
    "build:flatbuffers:all": "mkdir -p src/flatbuffers && flatc --ts -o src/flatbuffers/ schemas/*.fbs",
    "build:frontend": "vite build",
    "build:ios": "npm run build:eas -- --platform ios",
    "build:pwa": "node scripts/build-pwa.js",
    "build:pwa:android": "npm run build && npx cap sync android",
    "build:pwa:ios": "npm run build && npx cap sync ios",
    "build:server": "tsc src/server/api-server.ts --outDir dist/server",
    "build:simple": "./scripts/simple-wasm-build.sh",
    "build:unified": "npm run build",
    "build:wasm": "./scripts/build-wasm-assemblyscript.sh",
    "build:wasm:as": "npm run build:wasm:assemblyscript",
    "build:wasm:assemblyscript": "asc assembly/index.ts --target release --outFile build/knirv-controller.wasm --bindings esm --config config/asconfig.json",
    "build:wasm:rust": "./scripts/build-wasm.sh",
    "clean": "npm run clean && npm run build",
    "db:backup": "node -e \"console.log('Creating database backup...'); require('fs').copyFileSync('./data/ergo.db', `./data/backup-${new Date().toISOString().replace(/[:.]/g, '-')}.db`); console.log('Backup created successfully');\"",
    "db:migrate": "node scripts/migrate-to-nebuladb.cjs",
    "db:restore": "echo 'Usage: npm run db:restore -- <backup-file-path>'",
    "db:seed": "node scripts/seed-database.js",
    "actuarial:seed": "node --loader ts-node/esm scripts/seed-actuarial-challenges.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:status": "node -e \"const fs = require('fs'); const path = './data/ergo.db'; console.log(fs.existsSync(path) ? 'Database exists: ' + fs.statSync(path).size + ' bytes' : 'Database not found');\"",
    "deploy": "node scripts/deploy.js",
    "deploy:dns": "node scripts/deploy-cloudflare.js dns-only",
    "deploy:verify": "node scripts/deploy-cloudflare.js verify",
    "dev": "npx vite@6.3.2 --host 0.0.0.0 --port 3000 --force",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "install:all": "npm install",
    "lint": "eslint . --config config/eslint.config.js --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --config config/eslint.config.js --report-unused-disable-directives --max-warnings 0 --fix",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "reset": "rm -rf dist node_modules && npm install",
    "serve": "npm run preview",
    "server": "node src/server/simple-server.js",
    "start": "node scripts/serve-static.js",
    "start:prod": "node dist/server/api-server.js",
    "start:production": "node scripts/serve-static.js",
    "test": "jest --config config/jest.config.cjs",
    "test:accessibility": "jest --config config/jest.config.cjs --testPathPattern=accessibility",
    "test:all": "jest --config config/jest.config.cjs --testPathPattern='(unit|integration)'",
    "test:coverage": "jest --config config/jest.config.cjs --coverage",
    "test:e2e": "playwright test",
    "test:integration": "jest --config config/jest.integration.config.cjs --testPathPattern=integration",
    "test:knirvrouter": "jest --config config/jest.integration.config.cjs --testPathPattern=integration/knirvrouter-integration.test.ts",
    "test:unit": "jest --config config/jest.config.cjs --testPathPattern=unit",
    "test:watch": "jest --config config/jest.config.cjs --watch"
  },
