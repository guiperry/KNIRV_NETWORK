# KNIRV Gateway Testnet Configuration

# Cloudflare DNS configuration
CLOUDFLARE_API_TOKEN=REDACTED_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ZONE_ID=REDACTED_CLOUDFLARE_ZONE_ID


# Testnet Mode
TESTNET_MODE=true
NODE_ENV=testnet

# Service URLs - Testnet services (updated by deployment)
KNIRVCHAIN_API=https://testnet.knirv.network:8080
KNIRVGRAPH_API=https://testnet.knirv.network:8081
KNIRVNEXUS_API=https://testnet.knirv.network:8082
KNIRVORACLE_API=https://testnet-gateway-oracle.knirv.network
KNIRVROUTER_API=https://testnet.knirv.network:8086
KNIRVANA_API=https://testnet.knirv.network:3000
KNIRVANA_INTERACTIVE_GRAPH=https://testnet.knirv.network:3000

# Legacy URLs (for backward compatibility)
KNIRVORACLE_URL=https://testnet-gateway-oracle.knirv.network
KNIRVCHAIN_URL=https://testnet.knirv.network:8080
KNIRVGRAPH_URL=https://testnet.knirv.network:8081
KNIRVNEXUS_URL=https://testnet.knirv.network:8082
KNIRVROUTER_URL=https://testnet.knirv.network:8086

# NEXUS Service URLs (specific services)
KNIRVNEXUS_DVE_URL=http://localhost:8080
KNIRVNEXUS_VALIDATION_URL=http://localhost:8081

# Gateway Configuration
GATEWAY_PORT=8888
GATEWAY_HOST=localhost

# Authentication
AUTH_SIMPLIFIED=true
AUTH_TESTNET_TOKENS=true

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Rate Limiting (disabled for testnet)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60000

# Logging
LOG_LEVEL=debug
LOG_REQUESTS=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# SSE Configuration
SSE_ENABLED=true
SSE_HEARTBEAT_INTERVAL=30000

# Development Features
DEV_MODE=true
DEBUG_ENABLED=true
MOCK_RESPONSES=true

# Testnet Authentication Tokens
TESTNET_ADMIN_TOKEN=TESTNET_ADMIN_TOKEN
TESTNET_VALIDATOR_TOKEN=TESTNET_VALIDATOR_TOKEN
TESTNET_OBSERVER_TOKEN=TESTNET_OBSERVER_TOKEN

# JWT Configuration for testnet
JWT_SECRET=REDACTED_JWT_SECRET

ORACLE_OWNER_KEY="your_private_key_here"
