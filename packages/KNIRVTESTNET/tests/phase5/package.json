{
  "name": "phase5-tests",
  "version": "1.0.0",
  "description": "Phase 5 Test Suite for KNIRV Network Synchronization and Optimization",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:typescript": "jest typescript-wasm-compiler.test.ts",
    "test:sync": "./run-phase5-tests.sh sync",
    "test:agent-builder": "./run-phase5-tests.sh agent-builder",
    "test:integration": "./run-phase5-tests.sh integration",
    "test:all": "./run-phase5-tests.sh",
    "build": "tsc --noEmit",
    "lint": "eslint *.ts",
    "clean": "rm -rf coverage reports logs node_modules/.cache"
  },
  "dependencies": {
    "@types/node": "^20.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [".ts"],
    "globals": {
      "ts-jest": {
        "useESM": true
      }
    },
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.test.ts",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 30000,
    "verbose": true
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": ["@typescript-eslint"],
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended"
    ],
    "env": {
      "node": true,
      "jest": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "@typescript-eslint/no-unused-vars": "warn",
      "@typescript-eslint/no-explicit-any": "off",
      "no-console": "warn"
    }
  },
  "keywords": [
    "knirv",
    "phase5",
    "synchronization",
    "optimization",
    "typescript",
    "wasm",
    "lora",
    "agent-builder",
    "testing"
  ],
  "author": "KNIRV Network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guiperry/KNIRV_NETWORK.git",
    "directory": "KNIRVTESTNET/tests/phase5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
