package database

import (
	"context"
	"database/sql"
	"encoding/json"
	"fmt"
	"log"
	"os"
	"path/filepath"
	"time"

	"github.com/google/uuid"
	"github.com/philippgille/chromem-go"
)

// AuthMigrator handles migration from SQLite to chromem-go authentication
type AuthMigrator struct {
	sqliteDB  *AuthDB
	chromemDB *ChromemAuthDB
}

// MigrationReport contains the results of the migration
type MigrationReport struct {
	StartTime      time.Time     `json:"start_time"`
	EndTime        time.Time     `json:"end_time"`
	Duration       time.Duration `json:"duration"`
	UsersTotal     int           `json:"users_total"`
	UsersMigrated  int           `json:"users_migrated"`
	UsersFailed    int           `json:"users_failed"`
	RolesTotal     int           `json:"roles_total"`
	RolesMigrated  int           `json:"roles_migrated"`
	TokensTotal    int           `json:"tokens_total"`
	TokensMigrated int           `json:"tokens_migrated"`
	Errors         []string      `json:"errors"`
	FailedUsers    []string      `json:"failed_users"`
	BackupPath     string        `json:"backup_path"`
	Success        bool          `json:"success"`
}

// NewAuthMigrator creates a new authentication migrator
func NewAuthMigrator(sqliteDBPath, chromemDBPath string) (*AuthMigrator, error) {
	// Open SQLite database
	sqliteDB, err := NewAuthDB(sqliteDBPath)
	if err != nil {
		return nil, fmt.Errorf("failed to open SQLite auth database: %v", err)
	}

	// Create chromem-go database
	chromemDB, err := NewChromemAuthDB(chromemDBPath)
	if err != nil {
		sqliteDB.Close()
		return nil, fmt.Errorf("failed to create chromem-go auth database: %v", err)
	}

	return &AuthMigrator{
		sqliteDB:  sqliteDB,
		chromemDB: chromemDB,
	}, nil
}

// CreateBackup creates a backup of the SQLite database
func (m *AuthMigrator) CreateBackup() (string, error) {
	timestamp := time.Now().Format("20060102_150405")
	backupDir := filepath.Join("backups", "auth_migration")

	if err := os.MkdirAll(backupDir, 0755); err != nil {
		return "", fmt.Errorf("failed to create backup directory: %v", err)
	}

	backupPath := filepath.Join(backupDir, fmt.Sprintf("auth_backup_%s.json", timestamp))

	// Export all data to JSON
	backup := make(map[string]interface{})

	// Export users
	users, err := m.exportUsers()
	if err != nil {
		return "", fmt.Errorf("failed to export users: %v", err)
	}
	backup["users"] = users

	// Export roles
	roles, err := m.exportRoles()
	if err != nil {
		return "", fmt.Errorf("failed to export roles: %v", err)
	}
	backup["roles"] = roles

	// Export tokens
	tokens, err := m.exportTokens()
	if err != nil {
		return "", fmt.Errorf("failed to export tokens: %v", err)
	}
	backup["tokens"] = tokens

	backup["timestamp"] = time.Now()
	backup["version"] = "1.0"

	// Write backup file
	backupJSON, err := json.MarshalIndent(backup, "", "  ")
	if err != nil {
		return "", fmt.Errorf("failed to marshal backup data: %v", err)
	}

	if err := os.WriteFile(backupPath, backupJSON, 0644); err != nil {
		return "", fmt.Errorf("failed to write backup file: %v", err)
	}

	log.Printf("Backup created at: %s", backupPath)
	return backupPath, nil
}

// exportUsers exports all users from SQLite
func (m *AuthMigrator) exportUsers() ([]map[string]interface{}, error) {
	query := `
		SELECT u.id, u.username, u.email, u.role, u.created_at, u.updated_at, p.password_hash
		FROM users u
		LEFT JOIN user_passwords p ON u.id = p.user_id
	`

	rows, err := m.sqliteDB.GetDB().Query(query)
	if err != nil {
		return nil, fmt.Errorf("failed to query users: %v", err)
	}
	defer rows.Close()

	var users []map[string]interface{}
	for rows.Next() {
		var id int64
		var username, email, role, passwordHash string
		var createdAt, updatedAt time.Time

		err := rows.Scan(&id, &username, &email, &role, &createdAt, &updatedAt, &passwordHash)
		if err != nil {
			return nil, fmt.Errorf("failed to scan user row: %v", err)
		}

		user := map[string]interface{}{
			"id":            id,
			"username":      username,
			"email":         email,
			"role":          role,
			"password_hash": passwordHash,
			"created_at":    createdAt,
			"updated_at":    updatedAt,
		}
		users = append(users, user)
	}

	return users, nil
}

// exportRoles exports all roles from SQLite
func (m *AuthMigrator) exportRoles() ([]map[string]interface{}, error) {
	query := `SELECT name, description, created_at FROM roles`

	rows, err := m.sqliteDB.GetDB().Query(query)
	if err != nil {
		return nil, fmt.Errorf("failed to query roles: %v", err)
	}
	defer rows.Close()

	var roles []map[string]interface{}
	for rows.Next() {
		var name, description string
		var createdAt time.Time

		err := rows.Scan(&name, &description, &createdAt)
		if err != nil {
			return nil, fmt.Errorf("failed to scan role row: %v", err)
		}

		// Get permissions for this role
		permissions, err := m.getRolePermissions(name)
		if err != nil {
			return nil, fmt.Errorf("failed to get permissions for role %s: %v", name, err)
		}

		role := map[string]interface{}{
			"name":        name,
			"description": description,
			"permissions": permissions,
			"created_at":  createdAt,
		}
		roles = append(roles, role)
	}

	return roles, nil
}

// exportTokens exports all API tokens from SQLite
func (m *AuthMigrator) exportTokens() ([]map[string]interface{}, error) {
	query := `SELECT id, user_id, token, description, expires_at, created_at FROM api_tokens`

	rows, err := m.sqliteDB.GetDB().Query(query)
	if err != nil {
		return nil, fmt.Errorf("failed to query tokens: %v", err)
	}
	defer rows.Close()

	var tokens []map[string]interface{}
	for rows.Next() {
		var id, userID int64
		var token, description string
		var expiresAt sql.NullTime
		var createdAt time.Time

		err := rows.Scan(&id, &userID, &token, &description, &expiresAt, &createdAt)
		if err != nil {
			return nil, fmt.Errorf("failed to scan token row: %v", err)
		}

		tokenData := map[string]interface{}{
			"id":          id,
			"user_id":     userID,
			"token":       token,
			"description": description,
			"created_at":  createdAt,
		}

		if expiresAt.Valid {
			tokenData["expires_at"] = expiresAt.Time
		}

		tokens = append(tokens, tokenData)
	}

	return tokens, nil
}

// getRolePermissions gets all permissions for a role
func (m *AuthMigrator) getRolePermissions(roleName string) ([]string, error) {
	query := `
		SELECT p.name
		FROM permissions p
		JOIN role_permissions rp ON p.id = rp.permission_id
		WHERE rp.role_name = ?
	`

	rows, err := m.sqliteDB.GetDB().Query(query, roleName)
	if err != nil {
		return nil, fmt.Errorf("failed to query role permissions: %v", err)
	}
	defer rows.Close()

	var permissions []string
	for rows.Next() {
		var permission string
		if err := rows.Scan(&permission); err != nil {
			return nil, fmt.Errorf("failed to scan permission: %v", err)
		}
		permissions = append(permissions, permission)
	}

	return permissions, nil
}

// Migrate performs the complete migration
func (m *AuthMigrator) Migrate(ctx context.Context) (*MigrationReport, error) {
	report := &MigrationReport{
		StartTime:   time.Now(),
		Errors:      []string{},
		FailedUsers: []string{},
	}

	log.Println("Starting authentication migration...")

	// Create backup
	backupPath, err := m.CreateBackup()
	if err != nil {
		report.Errors = append(report.Errors, fmt.Sprintf("Backup failed: %v", err))
		return report, fmt.Errorf("backup failed: %v", err)
	}
	report.BackupPath = backupPath

	// Migrate users
	if err := m.migrateUsers(ctx, report); err != nil {
		report.Errors = append(report.Errors, fmt.Sprintf("User migration failed: %v", err))
		return report, fmt.Errorf("user migration failed: %v", err)
	}

	// Migrate tokens
	if err := m.migrateTokens(ctx, report); err != nil {
		report.Errors = append(report.Errors, fmt.Sprintf("Token migration failed: %v", err))
		// Don't fail the entire migration for token issues
		log.Printf("Warning: Token migration failed: %v", err)
	}

	report.EndTime = time.Now()
	report.Duration = report.EndTime.Sub(report.StartTime)
	report.Success = len(report.Errors) == 0 || (report.UsersMigrated > 0 && report.UsersFailed == 0)

	log.Printf("Migration completed in %v", report.Duration)
	log.Printf("Users: %d total, %d migrated, %d failed", report.UsersTotal, report.UsersMigrated, report.UsersFailed)
	log.Printf("Tokens: %d total, %d migrated", report.TokensTotal, report.TokensMigrated)

	return report, nil
}

// migrateUsers migrates all users from SQLite to chromem-go
func (m *AuthMigrator) migrateUsers(ctx context.Context, report *MigrationReport) error {
	users, err := m.exportUsers()
	if err != nil {
		return fmt.Errorf("failed to export users: %v", err)
	}

	report.UsersTotal = len(users)

	for _, userData := range users {
		username := userData["username"].(string)

		// Skip admin user if it already exists (created during initialization)
		if username == "admin" {
			existing, err := m.chromemDB.GetUserByUsername(ctx, username)
			if err == nil && existing != nil {
				report.UsersMigrated++
				continue
			}
		}

		// Create UserDocument
		userDoc := &UserDocument{
			ID:           fmt.Sprintf("user-%s", uuid.New().String()),
			Username:     username,
			Email:        userData["email"].(string),
			PasswordHash: userData["password_hash"].(string),
			Role:         userData["role"].(string),
			Sessions:     []SessionInfo{},
			APITokens:    []string{},
			CreatedAt:    userData["created_at"].(time.Time),
			UpdatedAt:    userData["updated_at"].(time.Time),
			Metadata:     make(map[string]interface{}),
		}

		// Get role permissions
		role, err := m.chromemDB.getRoleByName(ctx, userDoc.Role)
		if err != nil {
			log.Printf("Warning: Failed to get role permissions for user %s: %v", username, err)
			userDoc.Permissions = []string{} // Empty permissions as fallback
		} else {
			userDoc.Permissions = role.Permissions
		}

		// Create user in chromem-go (without password since it's already hashed)
		if err := m.createUserWithHashedPassword(ctx, userDoc); err != nil {
			report.UsersFailed++
			report.FailedUsers = append(report.FailedUsers, username)
			report.Errors = append(report.Errors, fmt.Sprintf("Failed to migrate user %s: %v", username, err))
			log.Printf("Failed to migrate user %s: %v", username, err)
			continue
		}

		report.UsersMigrated++
		log.Printf("Successfully migrated user: %s", username)
	}

	return nil
}

// createUserWithHashedPassword creates a user with an already hashed password
func (m *AuthMigrator) createUserWithHashedPassword(ctx context.Context, user *UserDocument) error {
	// Marshal user data
	userJSON, err := json.Marshal(user)
	if err != nil {
		return fmt.Errorf("failed to marshal user: %v", err)
	}

	// Create document
	doc := chromem.Document{
		ID:      user.ID,
		Content: fmt.Sprintf("User: %s (%s) - %s", user.Username, user.Email, user.Role),
		Metadata: map[string]string{
			"type":       "user",
			"username":   user.Username,
			"email":      user.Email,
			"role":       user.Role,
			"created_at": user.CreatedAt.Format(time.RFC3339),
			"updated_at": user.UpdatedAt.Format(time.RFC3339),
			"data":       string(userJSON),
		},
	}

	return m.chromemDB.usersCollection.AddDocuments(ctx, []chromem.Document{doc}, 1)
}

// migrateTokens migrates API tokens from SQLite to chromem-go
func (m *AuthMigrator) migrateTokens(ctx context.Context, report *MigrationReport) error {
	tokens, err := m.exportTokens()
	if err != nil {
		return fmt.Errorf("failed to export tokens: %v", err)
	}

	report.TokensTotal = len(tokens)

	for _, tokenData := range tokens {
		// Find the corresponding user in chromem-go
		sqliteUserID := tokenData["user_id"].(int64)

		// This is a simplified approach - in a real migration, you'd need to map SQLite user IDs to chromem-go user IDs
		// For now, we'll skip token migration and let users recreate them
		log.Printf("Skipping token migration for SQLite user ID %d - tokens should be recreated", sqliteUserID)
	}

	return nil
}

// Close closes the database connections
func (m *AuthMigrator) Close() error {
	if err := m.sqliteDB.Close(); err != nil {
		log.Printf("Error closing SQLite database: %v", err)
	}

	if err := m.chromemDB.Close(); err != nil {
		log.Printf("Error closing chromem-go database: %v", err)
	}

	return nil
}
