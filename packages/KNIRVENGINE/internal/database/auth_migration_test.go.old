package database

import (
	"context"
	"encoding/json"
	"os"
	"path/filepath"
	"testing"
	"time"
)

func TestAuthMigration(t *testing.T) {
	// Create temporary directories for test databases
	tempDir := t.TempDir()
	sqliteDBPath := filepath.Join(tempDir, "test_auth.db")
	chromemDBPath := filepath.Join(tempDir, "test_auth_chromem.db")

	// Setup test SQLite database with sample data
	sqliteDB, err := NewAuthDB(sqliteDBPath)
	if err != nil {
		t.Fatalf("Failed to create SQLite auth database: %v", err)
	}

	// Create additional test users
	userRepo := NewUserRepository(sqliteDB.GetDB())

	testUsers := []*User{
		{
			Username: "testuser1",
			Email:    "test1@example.com",
			Role:     "user",
		},
		{
			Username: "testuser2",
			Email:    "test2@example.com",
			Role:     "admin",
		},
	}

	for _, user := range testUsers {
		if err := userRepo.CreateUser(user, "testpass123"); err != nil {
			t.Fatalf("Failed to create test user %s: %v", user.Username, err)
		}
	}

	sqliteDB.Close()

	// Create migrator
	migrator, err := NewAuthMigrator(sqliteDBPath, chromemDBPath)
	if err != nil {
		t.Fatalf("Failed to create migrator: %v", err)
	}
	defer migrator.Close()

	// Test backup creation
	backupPath, err := migrator.CreateBackup()
	if err != nil {
		t.Fatalf("Failed to create backup: %v", err)
	}

	// Verify backup file exists
	if _, err := os.Stat(backupPath); os.IsNotExist(err) {
		t.Fatalf("Backup file was not created: %s", backupPath)
	}

	// Perform migration
	ctx := context.Background()
	report, err := migrator.Migrate(ctx)
	if err != nil {
		t.Fatalf("Migration failed: %v", err)
	}

	// Validate migration report
	if !report.Success {
		t.Fatalf("Migration reported as failed: %+v", report)
	}

	if report.UsersTotal != 3 { // admin + 2 test users
		t.Errorf("Expected 3 users total, got %d", report.UsersTotal)
	}

	if report.UsersMigrated != 3 {
		t.Errorf("Expected 3 users migrated, got %d", report.UsersMigrated)
	}

	if report.UsersFailed != 0 {
		t.Errorf("Expected 0 failed users, got %d", report.UsersFailed)
	}

	// Test chromem-go database functionality
	chromemDB, err := NewChromemAuthDB(chromemDBPath)
	if err != nil {
		t.Fatalf("Failed to open migrated chromem-go database: %v", err)
	}
	defer chromemDB.Close()

	// Test user retrieval
	adminUser, err := chromemDB.GetUserByUsername(ctx, "admin")
	if err != nil {
		t.Fatalf("Failed to get admin user: %v", err)
	}

	if adminUser.Username != "admin" {
		t.Errorf("Expected username 'admin', got '%s'", adminUser.Username)
	}

	if adminUser.Role != "admin" {
		t.Errorf("Expected role 'admin', got '%s'", adminUser.Role)
	}

	// Test password verification
	valid, err := chromemDB.VerifyPassword(ctx, "admin", "admin123")
	if err != nil {
		t.Fatalf("Failed to verify admin password: %v", err)
	}

	if !valid {
		t.Error("Admin password verification failed")
	}

	// Test invalid password
	valid, err = chromemDB.VerifyPassword(ctx, "admin", "wrongpassword")
	if err != nil {
		t.Fatalf("Failed to verify invalid password: %v", err)
	}

	if valid {
		t.Error("Invalid password was accepted")
	}

	// Test test user retrieval
	testUser1, err := chromemDB.GetUserByUsername(ctx, "testuser1")
	if err != nil {
		t.Fatalf("Failed to get testuser1: %v", err)
	}

	if testUser1.Email != "test1@example.com" {
		t.Errorf("Expected email 'test1@example.com', got '%s'", testUser1.Email)
	}

	// Test user permissions
	if len(testUser1.Permissions) == 0 {
		t.Error("User should have permissions assigned")
	}

	// Verify admin has more permissions than regular user
	if len(adminUser.Permissions) <= len(testUser1.Permissions) {
		t.Error("Admin should have more permissions than regular user")
	}
}

func TestChromemAuthDBBasicOperations(t *testing.T) {
	tempDir := t.TempDir()
	dbPath := filepath.Join(tempDir, "test_chromem_auth.db")

	// Create chromem-go auth database
	db, err := NewChromemAuthDB(dbPath)
	if err != nil {
		t.Fatalf("Failed to create chromem-go auth database: %v", err)
	}
	defer db.Close()

	ctx := context.Background()

	// Test user creation
	newUser := &UserDocument{
		ID:        "test-user-001",
		Username:  "newuser",
		Email:     "newuser@example.com",
		Role:      "user",
		Sessions:  []SessionInfo{},
		APITokens: []string{},
		CreatedAt: time.Now(),
		UpdatedAt: time.Now(),
		Metadata:  make(map[string]interface{}),
	}

	err = db.CreateUser(ctx, newUser, "newuserpass")
	if err != nil {
		t.Fatalf("Failed to create new user: %v", err)
	}

	t.Logf("User created successfully: %s", newUser.Username)

	// Test user retrieval by ID first (this should work)
	retrievedUserByID, err := db.GetUserByID(ctx, newUser.ID)
	if err != nil {
		t.Fatalf("Failed to retrieve user by ID: %v", err)
	}
	t.Logf("User retrieved by ID successfully: %s", retrievedUserByID.Username)

	// Test user retrieval by username
	retrievedUser, err := db.GetUserByUsername(ctx, "newuser")
	if err != nil {
		// Debug: Try to get admin user to see if query works at all
		adminUser, adminErr := db.GetUserByUsername(ctx, "admin")
		if adminErr != nil {
			t.Fatalf("Failed to retrieve admin user (query broken): %v", adminErr)
		}
		t.Logf("Admin user found: %s", adminUser.Username)
		t.Fatalf("Failed to retrieve user by username: %v", err)
	}

	if retrievedUser.Email != newUser.Email {
		t.Errorf("Expected email '%s', got '%s'", newUser.Email, retrievedUser.Email)
	}

	// Test user retrieval by ID
	retrievedUserByID, err = db.GetUserByID(ctx, newUser.ID)
	if err != nil {
		t.Fatalf("Failed to retrieve user by ID: %v", err)
	}

	if retrievedUserByID.Username != newUser.Username {
		t.Errorf("Expected username '%s', got '%s'", newUser.Username, retrievedUserByID.Username)
	}

	// Test password verification
	valid, err := db.VerifyPassword(ctx, "newuser", "newuserpass")
	if err != nil {
		t.Fatalf("Failed to verify password: %v", err)
	}

	if !valid {
		t.Error("Password verification failed for correct password")
	}

	// Test invalid password
	valid, err = db.VerifyPassword(ctx, "newuser", "wrongpass")
	if err != nil {
		t.Fatalf("Failed to verify invalid password: %v", err)
	}

	if valid {
		t.Error("Invalid password was accepted")
	}

	// Test non-existent user
	_, err = db.GetUserByUsername(ctx, "nonexistent")
	if err == nil {
		t.Error("Expected error for non-existent user")
	}
}

func TestBackupCreation(t *testing.T) {
	tempDir := t.TempDir()
	sqliteDBPath := filepath.Join(tempDir, "test_backup_auth.db")
	chromemDBPath := filepath.Join(tempDir, "test_backup_chromem.db")

	// Create SQLite database with test data
	sqliteDB, err := NewAuthDB(sqliteDBPath)
	if err != nil {
		t.Fatalf("Failed to create SQLite auth database: %v", err)
	}
	sqliteDB.Close()

	// Create migrator
	migrator, err := NewAuthMigrator(sqliteDBPath, chromemDBPath)
	if err != nil {
		t.Fatalf("Failed to create migrator: %v", err)
	}
	defer migrator.Close()

	// Create backup
	backupPath, err := migrator.CreateBackup()
	if err != nil {
		t.Fatalf("Failed to create backup: %v", err)
	}

	// Verify backup file exists and is not empty
	info, err := os.Stat(backupPath)
	if err != nil {
		t.Fatalf("Backup file does not exist: %v", err)
	}

	if info.Size() == 0 {
		t.Error("Backup file is empty")
	}

	// Verify backup is valid JSON
	backupData, err := os.ReadFile(backupPath)
	if err != nil {
		t.Fatalf("Failed to read backup file: %v", err)
	}

	// Basic JSON validation
	if len(backupData) < 10 {
		t.Error("Backup file appears to be too small")
	}

	if !isValidJSON(backupData) {
		t.Error("Backup file is not valid JSON")
	}
}

func isValidJSON(data []byte) bool {
	var js interface{}
	return json.Unmarshal(data, &js) == nil
}
