# KNIRVENGINE Development Environment Variables
# These variables are used by Vite and must be prefixed with VITE_

# KNIRVORACLE Service Configuration
VITE_KNIRVORACLE_URL=http://localhost:8080
VITE_KNIRVORACLE_API_KEY=

# WebSocket Configuration
# Leave this unset: the desktop launcher supplies the selected API port and
# normal browser development uses Vite's same-origin /api proxy.

# Development Mode
VITE_NODE_ENV=development
VITE_DEBUG=true

# Application Configuration
# Do not set VITE_API_BASE_URL here. A fixed port prevents the launcher from
# using the free port it selected at startup.
VITE_APP_VERSION=1.0.0
VITE_AGENTIC_ENGINE_DEMO_MODE=false
