{
  "name": "@knirvcorp/knirvbase-ts",
  "version": "2.0.0",
  "description": "TypeScript implementation of KNIRVBASE distributed database",
  "type": "module",
  "main": "dist/cjs/lib/index.js",
  "module": "dist/esm/lib/index.js",
  "types": "dist/esm/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/lib/index.d.ts",
      "node": "./dist/cjs/lib/index.js",
      "import": "./dist/esm/lib/index.js",
      "default": "./dist/cjs/lib/index.js"
    },
    "./node": {
      "types": "./dist/esm/lib/node.d.ts",
      "node": "./dist/cjs/lib/node.js",
      "import": "./dist/esm/lib/node.js",
      "default": "./dist/cjs/lib/node.js"
    },
    "./server": {
      "types": "./dist/esm/lib/server.d.ts",
      "node": "./dist/cjs/lib/server.js",
      "import": "./dist/esm/lib/server.js",
      "default": "./dist/cjs/lib/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "test:conformance": "NRVCONFORM_REQUIRED=1 jest src/conformance"
  },
  "keywords": [
    "database",
    "distributed",
    "pqc",
    "typescript"
  ],
  "author": "KNIRV Corp",
  "license": "MIT",
  "devDependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^16.1.5",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@libp2p/identify": "^3.0.39",
    "@libp2p/kad-dht": "^15.1.11",
    "@libp2p/ping": "^2.0.37",
    "@libp2p/tcp": "^10.1.19",
    "@multiformats/multiaddr": "^12.5.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "express": "^4.18.2",
    "jest": "^29.0.0",
    "jsonwebtoken": "^9.0.0",
    "libp2p": "^2.10.0",
    "multiformats": "^13.4.2",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/tests/**/*.ts",
      "**/tests/**/*.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "globalSetup": "<rootDir>/scripts/jest-global-setup.cjs",
    "globalTeardown": "<rootDir>/scripts/jest-global-teardown.cjs"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.2.1",
    "apache-arrow": "^21.2.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "peerDependencies": {
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "libp2p": "^2.10.0",
    "@libp2p/tcp": "^10.1.19",
    "@chainsafe/libp2p-noise": "^16.1.5",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@libp2p/identify": "^3.0.39",
    "@libp2p/ping": "^2.0.37",
    "@libp2p/kad-dht": "^15.1.11",
    "@multiformats/multiaddr": "^12.5.1",
    "multiformats": "^13.4.2"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "jsonwebtoken": {
      "optional": true
    },
    "libp2p": {
      "optional": true
    },
    "@libp2p/tcp": {
      "optional": true
    },
    "@chainsafe/libp2p-noise": {
      "optional": true
    },
    "@chainsafe/libp2p-yamux": {
      "optional": true
    },
    "@chainsafe/libp2p-gossipsub": {
      "optional": true
    },
    "@libp2p/identify": {
      "optional": true
    },
    "@libp2p/ping": {
      "optional": true
    },
    "@libp2p/kad-dht": {
      "optional": true
    },
    "@multiformats/multiaddr": {
      "optional": true
    },
    "multiformats": {
      "optional": true
    }
  }
}
