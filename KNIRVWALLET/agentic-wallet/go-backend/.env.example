ENVIRONMENT=development
PORT=8080
DATABASE_URL=postgres://username:password@localhost:5432/crypto_wallet?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-jwt-key-here
LOG_LEVEL=info

# Blockchain RPC URLs
ETHEREUM_RPC=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
BITCOIN_RPC=https://bitcoin-rpc.example.com
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Security
ENCRYPTION_KEY=32-byte-encryption-key-here!!!
HSM_ENDPOINT=https://your-hsm-endpoint.com

# AI Agent Configuration
MAX_AGENTS_PER_USER=10
AGENT_MEMORY_LIMIT=268435456
AGENT_CPU_LIMIT=0.5
AGENT_NETWORK_TIMEOUT=30

# External APIs
COINGECKO_API_KEY=your-coingecko-api-key
ALCHEMY_API_KEY=your-alchemy-api-key
INFURA_PROJECT_ID=your-infura-project-id