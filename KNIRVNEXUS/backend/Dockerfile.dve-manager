# Multi-stage build for KNIRV-NEXUS DVE Manager
# Based on Kali Linux as specified in KALI_LINUX_FOUNDATION.md

# Build stage
FROM kalilinux/kali-rolling:latest AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    golang-1.21 \
    git \
    ca-certificates \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set Go environment
ENV PATH="/usr/lib/go-1.21/bin:${PATH}"
ENV GOPATH="/go"
ENV GOCACHE="/tmp/go-cache"

# Create app directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=1 GOOS=linux go build -a -installsuffix cgo \
    -ldflags '-extldflags "-static" -s -w' \
    -o dve-manager ./cmd/dve-manager/

# Runtime stage
FROM kalilinux/kali-rolling:latest

# Install runtime dependencies and security tools
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    netcat-traditional \
    procps \
    net-tools \
    tcpdump \
    nmap \
    wireshark-common \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r knirv && useradd -r -g knirv -u 1000 knirv

# Create necessary directories
RUN mkdir -p /app/data /app/config /app/scripts /app/keys /app/logs /app/backups && \
    chown -R knirv:knirv /app

# Copy binary from builder stage
COPY --from=builder /app/dve-manager /app/dve-manager

# Copy configuration files
COPY --chown=knirv:knirv config/ /app/config/

# Set executable permissions
RUN chmod +x /app/dve-manager

# Switch to non-root user
USER knirv

# Set working directory
WORKDIR /app

# Expose ports
EXPOSE 8080 4001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Set default environment variables
ENV KNIRV_NODE_ROLE=dve-manager
ENV KNIRV_CHAIN_ID=knirv-nexus-mainnet
ENV KNIRV_DATABASE_PATH=/app/data/dve-manager.db
ENV KNIRV_API_PORT=8080
ENV KNIRV_P2P_PORT=4001
ENV KNIRV_LOG_LEVEL=info

# Run the application
CMD ["./dve-manager"]
