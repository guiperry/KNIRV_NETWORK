# Fail2Ban Configuration for KNIRV-NEXUS

[DEFAULT]
# Ban hosts for 1 hour
bantime = 3600

# A host is banned after 3 attempts
maxretry = 3

# "Findtime" is the time between failures
findtime = 600

# Destination email for notifications
destemail = {{ alert_email | default('admin@knirv.com') }}

# Sender email
sender = fail2ban@{{ ansible_fqdn }}

# Email actions
action = %(action_mwl)s

[sshd]
enabled = true
port = {{ ssh_port | default('22') }}
filter = sshd
logpath = /var/log/auth.log
maxretry = 3
bantime = 3600

[nginx-http-auth]
enabled = true
filter = nginx-http-auth
logpath = /var/log/nginx/error.log
maxretry = 3
bantime = 1800

[nginx-limit-req]
enabled = true
filter = nginx-limit-req
logpath = /var/log/nginx/error.log
maxretry = 5
bantime = 1800

[nginx-botsearch]
enabled = true
filter = nginx-botsearch
logpath = /var/log/nginx/access.log
maxretry = 2
bantime = 7200

# Custom filter for KNIRV-NEXUS API abuse
[knirv-nexus-api]
enabled = true
filter = knirv-nexus-api
logpath = /var/log/knirv-nexus/access.log
maxretry = 10
findtime = 300
bantime = 1800

# Recidive jail for repeat offenders
[recidive]
enabled = true
filter = recidive
logpath = /var/log/fail2ban.log
action = %(action_mwl)s
bantime = 86400
findtime = 86400
maxretry = 3
