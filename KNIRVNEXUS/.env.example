# Agentic Engine Environment Configuration
# Copy this file to .env and update with your API keys and settings

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash
# Optional custom endpoint
# GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL_NAME=deepseek-chat

# Cerebras API Configuration
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1/chat/completions
CEREBRAS_MODEL_NAME=llama-4-scout-17b-16e-instruct

# SQLite Database Path (optional, defaults to ./data/agentify.db)
# DB_PATH=./data/agentify.db

# JWT Secret for authentication (change in production)
# JWT_SECRET=your_secure_jwt_secret_here