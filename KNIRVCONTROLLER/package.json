  "description": "Unified KNIRV Controller - Frontend application with integrated manager interface and slideout functionality",
  "type": "module",
  "main": "dist/index.html",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run build:wasm && vite build",
    "build:wasm": "./scripts/build-wasm.sh",
    "build:frontend": "vite build",
    "start": "npm run preview",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start:production": "npm run preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist node_modules && npm install",
    "reset": "npm run clean && npm run build",
    "install:all": "npm install",
    "build:unified": "npm run build",
    "serve": "npm run preview"
  },
