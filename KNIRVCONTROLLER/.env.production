# KNIRV Controller Environment Variables - Production
VITE_APP_ENV=production
VITE_APP_NAME=KNIRV Controller
VITE_APP_VERSION=1.0.0

# Network Configuration - Production/Testnet
VITE_KNIRV_NETWORK_TYPE=testnet
VITE_KNIRV_RPC_URL=https://rpc.testnet.knirv.network
VITE_KNIRV_REST_URL=https://rest.testnet.knirv.network
VITE_KNIRV_WS_URL=wss://ws.testnet.knirv.network

# KNIRV Chain Configuration
VITE_KNIRV_CHAIN_ID=knirv-testnet
VITE_KNIRV_DENOM=uknirv
VITE_KNIRV_FEE_DENOM=uknirv

# XION Wallet Integration
VITE_XION_WALLET_ENABLED=true
VITE_XION_NETWORK=testnet

# Database Configuration
VITE_DATABASE_NAME=knirv-controller-prod
VITE_DATABASE_ENCRYPTION_KEY=strong-production-encryption-key

# API Keys - Set via deployment environment
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=

# Feature Flags
VITE_ENABLE_VOICE_CONTROL=true
VITE_ENABLE_AI_AGENTS=true
VITE_ENABLE_GRAPH_VISUALIZATION=true
VITE_ENABLE_NETWORK_MONITORING=true

# Wallet Integration - Production IDs
VITE_WALLET_CONNECT_PROJECT_ID=production-walletconnect-id
VITE_INFURA_ID=production-infura-id

# Logging
VITE_LOG_LEVEL=warn
VITE_ENABLE_ANALYTICS=true

# Error Reporting
VITE_SENTRY_DSN=your-sentry-dsn-here

# CDN Configuration
VITE_CDN_URL=https://cdn.knirv.network
VITE_ASSETS_URL=https://assets.knirv.network

# Build Configuration
BUNDLE_ANALYZE=false

# Error Monitoring
VITE_ENABLE_ERROR_REPORTING=true
