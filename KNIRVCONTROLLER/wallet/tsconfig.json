{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "commonjs",
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./test-utils/*"],
      "@test-utils/*": ["./test-utils/*"],
      "@browser-wallet/*": ["./browser-wallet/*"],
      "@agentic-wallet/*": ["./agentic-wallet/*"]
    },
    "types": ["jest", "node"]
  },
  "include": [
    "tests/**/*",
    "test-utils/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test-results",
    "agentic-wallet/go-backend"
  ]
}
