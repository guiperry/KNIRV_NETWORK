{
  "name": "knirv-controller",
  "version": "1.0.0",
  "description": "Unified KNIRV Controller with integrated manager, receiver, backend, and agent-core compiler",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run dev:unified",
    "dev:unified": "npm run build:receiver && npm run build:backend && nodemon --exec 'node dist/unifiedServer.js'",
    "dev:orchestrator": "node scripts/orchestrator.js",
    "dev:manager": "cd manager && npm run dev",
    "dev:receiver": "cd receiver && npm run dev",
    "dev:backend": "npm run build:backend && nodemon --exec 'node dist/index.js'",
    "build": "npm run build:unified",
    "build:unified": "npm run build:backend && npm run build:receiver",
    "build:all": "npm run build:backend && npm run build:manager && npm run build:receiver",
    "build:backend": "tsc -p tsconfig.json && node scripts/build-backend.js",
    "build:manager": "cd manager && npm run build",
    "build:receiver": "cd receiver && npm run build",
    "build:wasm": "./scripts/build-wasm.sh",
    "build:lora": "./scripts/build-lora-pipeline.sh",
    "test": "npm run test:all",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:manager && npm run test:receiver",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:backend": "jest --testPathPattern=backend",
    "test:manager": "cd manager && npm test",
    "test:receiver": "cd receiver && npm test",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:debug": "jest --detectOpenHandles --forceExit",
    "test:wasm": "./scripts/test-wasm.sh",
    "install:all": "npm run install:manager && npm run install:receiver",
    "install:manager": "cd manager && npm install",
    "install:receiver": "cd receiver && npm install",
    "lint": "npm run lint:all",
    "lint:all": "npm run lint:backend && npm run lint:tests && npm run lint:manager && npm run lint:receiver",
    "lint:backend": "eslint backend/ --ext .ts",
    "lint:tests": "eslint tests/ test-utils/ --ext .ts,.js",
    "lint:manager": "cd manager && npm run lint",
    "lint:receiver": "cd receiver && npm run lint",
    "lint:fix": "eslint backend/ tests/ test-utils/ --ext .ts,.js --fix",
    "start": "node dist/unifiedServer.js",
    "start:backend-only": "node dist/index.js",
    "start:orchestrator": "node scripts/orchestrator.js",
    "clean": "rm -rf dist/ pkg/ target/ coverage/ test-reports/",
    "deploy": "npm run build && npm run package",
    "package": "node scripts/package-backend.js",
    "wasm:install": "curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh",
    "protobuf:generate": "node scripts/generate-protobuf.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.3",
    "@gnolang/tm2-js-client": "^1.3.0",
    "@napi-rs/wasm-runtime": "^1.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "pino": "^8.21.0",
    "pino-pretty": "^10.2.3",
    "protobufjs": "^7.5.4",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-html-reporters": "^3.1.0",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.0",
    "nodemon": "^3.0.2",
    "playwright": "^1.40.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "workspaces": [
    "manager",
    "receiver"
  ],
  "engines": {
    "node": ">=20.0.0",
    "rust": ">=1.70.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guiperry/KNIRV_NETWORK.git",
    "directory": "KNIRVCONTROLLER"
  },
  "keywords": [
    "knirv",
    "controller",
    "ai",
    "blockchain",
    "lora",
    "cognitive-shell",
    "wasm",
    "agent-core",
    "neural-networks",
    "backend",
    "compilation"
  ],
  "author": "KNIRV Network",
  "license": "MIT",
  "files": [
    "dist/",
    "pkg/",
    "scripts/",
    "backend/",
    "manager/dist/",
    "receiver/dist/",
    "rust-wasm/",
    "protobuf/",
    "README.md"
  ],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*.spec.ts",
      "**/backend/**/*.test.ts",
      "**/backend/**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "backend/**/*.ts",
      "tests/**/*.ts",
      "test-utils/**/*.ts",
      "!**/*.d.ts",
      "!**/*.test.ts",
      "!**/*.spec.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test-utils/jest-setup-after-env.js"
    ],
    "setupFiles": [
      "<rootDir>/test-utils/jest-setup.js"
    ],
    "testTimeout": 30000
  },
  "eslintConfig": {
    "extends": [
      "@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "root": true,
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "rules": {
      "@typescript-eslint/no-unused-vars": "warn",
      "@typescript-eslint/no-explicit-any": "off"
    }
  }
}
