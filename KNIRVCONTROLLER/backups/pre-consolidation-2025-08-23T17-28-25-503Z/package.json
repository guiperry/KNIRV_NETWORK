{
  "name": "knirv-controller",
  "version": "1.0.0",
  "description": "Simplified KNIRV Controller - Vite-only architecture with integrated backend modules",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "start": "cd frontend && npm run preview",
    "test": "cd frontend && npm test",
    "test:frontend": "cd frontend && npm test",
    "lint": "cd frontend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:frontend",
    "clean": "cd frontend && rm -rf dist node_modules && npm install",
    "reset": "npm run clean && npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.3",
    "@gnolang/tm2-js-client": "^1.3.0",
    "@napi-rs/wasm-runtime": "^1.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "glob": "^10.4.5",
    "helmet": "^7.1.0",
    "pino": "^8.21.0",
    "pino-pretty": "^10.2.3",
    "protobufjs": "^7.5.4",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-html-reporters": "^3.1.0",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.0",
    "nodemon": "^3.0.2",
    "playwright": "^1.40.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "workspaces": [
    "manager",
    "receiver"
  ],
  "engines": {
    "node": ">=20.0.0",
    "rust": ">=1.70.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guiperry/KNIRV_NETWORK.git",
    "directory": "KNIRVCONTROLLER"
  },
  "keywords": [
    "knirv",
    "controller",
    "ai",
    "blockchain",
    "lora",
    "cognitive-shell",
    "wasm",
    "agent-core",
    "neural-networks",
    "backend",
    "compilation"
  ],
  "author": "KNIRV Network",
  "license": "MIT",
  "files": [
    "dist/",
    "pkg/",
    "scripts/",
    "backend/",
    "manager/dist/",
    "receiver/dist/",
    "rust-wasm/",
    "protobuf/",
    "README.md"
  ],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*.spec.ts",
      "**/backend/**/*.test.ts",
      "**/backend/**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "backend/**/*.ts",
      "tests/**/*.ts",
      "test-utils/**/*.ts",
      "!**/*.d.ts",
      "!**/*.test.ts",
      "!**/*.spec.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test-utils/jest-setup-after-env.js"
    ],
    "setupFiles": [
      "<rootDir>/test-utils/jest-setup.js"
    ],
    "testTimeout": 30000
  },
  "eslintConfig": {
    "extends": [
      "@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "root": true,
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "rules": {
      "@typescript-eslint/no-unused-vars": "warn",
      "@typescript-eslint/no-explicit-any": "off"
    }
  }
}
