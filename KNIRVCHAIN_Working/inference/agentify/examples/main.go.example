package main


import (
	"context"
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"os"
	"os/signal"
	"path/filepath"
	"syscall"
	"time"

	
)

func main() {
	// Get the plugins directory
	pluginsDir := filepath.Join(".", "plugins")
	if _, err := os.Stat(pluginsDir); os.IsNotExist(err) {
		if err := os.MkdirAll(pluginsDir, 0755); err != nil {
			log.Fatalf("Failed to create plugins directory: %v", err)
		}
	}

	// Create the Agent Inferencer Service
	service := NewAgentInferencerService(pluginsDir)

	// Start the service
	if err := service.Start(); err != nil {
		log.Fatalf("Failed to start Agent Inferencer Service: %v", err)
	}
	defer service.Stop()

	// Create an HTTP server
	mux := http.NewServeMux()
	
	// Create a handler with the auth middleware
	httpAPI := service.GetHTTPAPI()
	handler := httpAPI.authMiddleware.Middleware(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		// Pass the request to the appropriate handler
		mux.ServeHTTP(w, r)
	}))
	
	// Register the API handlers
	httpAPI.RegisterHandlers(mux)

	// Add a simple status endpoint
	mux.HandleFunc("/status", func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		json.NewEncoder(w).Encode(map[string]interface{}{
			"status":  "running",
			"service": service.GetName(),
			"time":    time.Now().Format(time.RFC3339),
		})
	})

	// Start the HTTP server
	server := &http.Server{
		Addr:    ":8080",
		Handler: handler, // Use the handler with auth middleware
	}

	// Start the server in a goroutine
	go func() {
		log.Printf("Starting HTTP server on %s", server.Addr)
		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			log.Fatalf("Failed to start HTTP server: %v", err)
		}
	}()

	// Wait for a signal to shutdown
	stop := make(chan os.Signal, 1)
	signal.Notify(stop, os.Interrupt, syscall.SIGTERM)
	<-stop

	// Shutdown the server
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := server.Shutdown(ctx); err != nil {
		log.Printf("Failed to shutdown HTTP server: %v", err)
	}

	log.Println("Server stopped")
}

// Example of using the Agent Inferencer directly
func exampleDirectUsage() {
	// Get the plugins directory
	pluginsDir := filepath.Join(".", "plugins")
	if _, err := os.Stat(pluginsDir); os.IsNotExist(err) {
		if err := os.MkdirAll(pluginsDir, 0755); err != nil {
			log.Fatalf("Failed to create plugins directory: %v", err)
		}
	}

	// Create the Agent Inferencer
	inferencer := NewAgentInferencer(pluginsDir)

	// Create a session
	sessionID := fmt.Sprintf("session-%d", time.Now().UnixNano())

	// Activate an agent
	ctx := context.Background()
	if err := inferencer.ActivateAgent(ctx, "example", "1.0", sessionID, nil); err != nil {
		log.Fatalf("Failed to activate agent: %v", err)
	}
	defer inferencer.DeactivateAgent(ctx, sessionID)

	// Process an inference request
	request := &InferenceRequest{
		Input:     "Hello, world!",
		SessionID: sessionID,
	}

	response, err := inferencer.ProcessInference(ctx, sessionID, request)
	if err != nil {
		log.Fatalf("Failed to process inference: %v", err)
	}

	fmt.Printf("Response: %s\n", response.Output)
}