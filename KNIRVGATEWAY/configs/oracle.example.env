# ========================================
# KNIRV Oracle Configuration
# ========================================
# This file contains configuration for the Oracle Engine embedded in KNIRVGATEWAY
# Copy to oracle.env and configure for your deployment

# ========================================
# Core Oracle Settings
# ========================================

# Chain identifier for this oracle instance
ORACLE_CHAIN_ID=knirvoracle-1

# Network identifier (testnet, mainnet, devnet)
ORACLE_NETWORK_ID=knirv-testnet

# Block production time in seconds (default: 5)
ORACLE_BLOCK_TIME=5

# Enable/disable validator mode (if true, participates in consensus)
ORACLE_VALIDATOR_MODE=false

# ========================================
# NRN Token Configuration
# ========================================

# Initial token supply (in base units, 1 NRN = 10^18 base units)
ORACLE_INITIAL_SUPPLY=1000000000

# Maximum token supply cap
ORACLE_MAX_SUPPLY=10000000000

# Owner private key (hex format, without 0x prefix)
# WARNING: Keep this secret! Used for minting and governance operations
ORACLE_OWNER_KEY=

# Contract address (if using XION integration, leave empty for native)
ORACLE_NRN_CONTRACT=

# XION RPC endpoint (for cross-chain integration)
ORACLE_XION_RPC=https://rpc.xion.testnet

# ========================================
# P2P Networking
# ========================================

# P2P listen address (libp2p multiaddr format)
ORACLE_P2P_ADDR=/ip4/0.0.0.0/tcp/26656

# Bootstrap peers (comma-separated multiaddrs)
ORACLE_BOOTSTRAP_PEERS=/ip4/bootstrap1.knirv.network/tcp/26656/p2p/12D3KooWPeerID1,/ip4/bootstrap2.knirv.network/tcp/26656/p2p/12D3KooWPeerID2

# Enable DHT for peer discovery
ORACLE_DHT_ENABLED=true

# Enable GossipSub for message propagation
ORACLE_GOSSIPSUB_ENABLED=true

# ========================================
# RPC & API
# ========================================

# RPC listen address (for consensus/ABCI)
ORACLE_RPC_ADDR=127.0.0.1:26657

# API listen address (HTTP REST API)
ORACLE_API_ADDR=0.0.0.0:8080

# Enable CORS (for web clients)
ORACLE_ENABLE_CORS=true

# ========================================
# IBC Configuration
# ========================================

# Enable IBC protocol
ORACLE_IBC_ENABLED=true

# IBC connection timeout (seconds)
ORACLE_IBC_TIMEOUT=60

# IBC packet retry attempts
ORACLE_IBC_RETRY_ATTEMPTS=3

# IBC packet retry delay (seconds)
ORACLE_IBC_RETRY_DELAY=5

# ========================================
# Governance
# ========================================

# Minimum deposit required to create a proposal (in NRN base units)
ORACLE_PROPOSAL_DEPOSIT=100000000

# Voting period in blocks (default: 50400 = ~7 days at 5s blocks)
ORACLE_VOTING_PERIOD=50400

# Quorum threshold (0.33 = 33% of voting power must vote)
ORACLE_QUORUM_THRESHOLD=0.33

# Pass threshold (0.50 = 50% of votes must be YES)
ORACLE_PASS_THRESHOLD=0.50

# Veto threshold (0.33 = 33% of votes as NO_WITH_VETO kills proposal)
ORACLE_VETO_THRESHOLD=0.33

# ========================================
# Token Economics
# ========================================

# Default fee percentage (0.001 = 0.1%)
ORACLE_DEFAULT_FEE_PERCENTAGE=0.001

# Minimum fee (in NRN base units)
ORACLE_MINIMUM_FEE=1000

# Burn percentage from fees (0.5 = 50% of fees are burned)
ORACLE_BURN_PERCENTAGE=0.5

# Reward distribution interval (seconds, default: 3600 = 1 hour)
ORACLE_REWARD_INTERVAL=3600

# Staking minimum amount (in NRN base units)
ORACLE_STAKING_MIN=1000000000

# Unbonding period (seconds, default: 2419200 = 28 days)
ORACLE_UNBONDING_PERIOD=2419200

# ========================================
# Storage
# ========================================

# Data directory for oracle state
ORACLE_DATA_DIR=./data/oracle

# Database backend (badger, memory)
ORACLE_DB_BACKEND=badger

# BadgerDB garbage collection interval (seconds)
ORACLE_DB_GC_INTERVAL=3600

# ========================================
# IPFS Integration
# ========================================

# IPFS API endpoint
ORACLE_IPFS_API=http://127.0.0.1:5001

# IPFS cache size (bytes, default: 1GB)
ORACLE_IPFS_CACHE_SIZE=1073741824

# IPFS pin models/skills on upload
ORACLE_IPFS_PIN=true

# ========================================
# Consensus
# ========================================

# Maximum block size (bytes, default: 1MB)
ORACLE_MAX_BLOCK_SIZE=1048576

# Maximum gas per block
ORACLE_MAX_GAS=10000000

# Evidence max age (blocks)
ORACLE_EVIDENCE_MAX_AGE=100000

# ========================================
# Logging
# ========================================

# Log level (debug, info, warn, error)
ORACLE_LOG_LEVEL=info

# Log format (json, text)
ORACLE_LOG_FORMAT=json

# Enable log file output
ORACLE_LOG_FILE_ENABLED=true

# Log file path
ORACLE_LOG_FILE_PATH=./logs/oracle.log

# ========================================
# Monitoring & Metrics
# ========================================

# Enable Prometheus metrics
ORACLE_METRICS_ENABLED=true

# Metrics listen address
ORACLE_METRICS_ADDR=127.0.0.1:9090

# Enable tracing
ORACLE_TRACING_ENABLED=false

# Tracing endpoint (Jaeger, etc.)
ORACLE_TRACING_ENDPOINT=http://localhost:14268/api/traces

# ========================================
# Security
# ========================================

# Enable TLS for RPC
ORACLE_TLS_ENABLED=false

# TLS certificate path
ORACLE_TLS_CERT_PATH=./certs/oracle.crt

# TLS key path
ORACLE_TLS_KEY_PATH=./certs/oracle.key

# Rate limit (requests per second per IP)
ORACLE_RATE_LIMIT=100

# Max concurrent connections
ORACLE_MAX_CONNECTIONS=1000
