# KNIRV Gateway Testnet Configuration

# Testnet Mode
TESTNET_MODE=true
NODE_ENV=testnet

# Service URLs - Local testnet services
KNIRVROOT_URL=http://localhost:1317
KNIRVCHAIN_URL=http://localhost:8080
KNIRVGRAPH_URL=http://localhost:8081
KNIRVNEXUS_URL=http://localhost:8082
KNIRVROUTER_URL=http://localhost:5001

# Gateway Configuration
GATEWAY_PORT=8888
GATEWAY_HOST=localhost

# Authentication
AUTH_SIMPLIFIED=true
AUTH_TESTNET_TOKENS=true

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Rate Limiting (disabled for testnet)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60000

# Logging
LOG_LEVEL=debug
LOG_REQUESTS=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# SSE Configuration
SSE_ENABLED=true
SSE_HEARTBEAT_INTERVAL=30000

# Development Features
DEV_MODE=true
DEBUG_ENABLED=true
MOCK_RESPONSES=true
