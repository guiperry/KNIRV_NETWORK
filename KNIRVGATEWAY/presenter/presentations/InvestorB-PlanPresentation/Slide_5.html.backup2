<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KNIRV Network: The Solution</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Montserrat', sans-serif;
            color: #ffffff;
            overflow: hidden;
            background-color: #0a192f;
        }
        .slide {
            width: 1280px;
            min-height: 720px;
            max-height: 720px;
            position: relative;
            background: linear-gradient(135deg, rgba(10, 25, 47, 0.95), rgba(10, 25, 47, 0.9));
            display: flex;
            flex-direction: column;
        }
        .header {
            padding: 40px 70px 20px;
        }
        .title {
            font-size: 56px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 10px;
            position: relative;
            letter-spacing: -1px;
        }
        .title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 80px;
            height: 4px;
            background-color: #7c3aed;
        }
        .content {
            flex-grow: 1;
            display: flex;
            padding: 20px 70px 40px;
        }
        .left-section {
            width: 45%;
            padding-right: 30px;
            display: flex;
            flex-direction: column;
        }
        .right-section {
            width: 55%;
            display: flex;
            flex-direction: column;
        }
        .description-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 20px;
            backdrop-filter: blur(5px);
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
        }
        .description-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .section-title {
            font-size: 32px;
            font-weight: 700;
            color: #7c3aed;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }
        .section-title i {
            margin-right: 12px;
            font-size: 28px;
        }
        .description-text {
            font-size: 20px;
            line-height: 1.5;
            color: #e0e0e0;
        }
        .features-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            backdrop-filter: blur(5px);
            flex-grow: 1;
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
        }
        .features-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .feature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            flex-grow: 1;
        }
        .feature-item {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }
        .feature-item:hover {
            background-color: rgba(124, 58, 237, 0.15);
            transform: translateY(-5px);
        }
        .feature-icon {
            color: #7c3aed;
            font-size: 32px;
            margin-bottom: 15px;
        }
        .feature-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 10px;
        }
        .feature-desc {
            font-size: 16px;
            color: #e0e0e0;
            line-height: 1.4;
        }
        .diagram-container {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            height: 100%;
            backdrop-filter: blur(5px);
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
        }
        .diagram-container:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .diagram {
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        .diagram-layers {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: center;
            margin-top: 20px;
        }
        .diagram-layer {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            padding: 15px;
            width: calc(33.33% - 10px);
            min-width: 150px;
            text-align: center;
            transition: all 0.3s ease;
        }
        .diagram-layer:hover {
            background-color: rgba(124, 58, 237, 0.15);
            transform: translateY(-5px);
        }
        .layer-icon {
            color: #7c3aed;
            font-size: 28px;
            margin-bottom: 10px;
        }
        .layer-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 5px;
        }
        .layer-desc {
            font-size: 14px;
            color: #e0e0e0;
        }
        .logo-placeholder {
            position: absolute;
            top: 30px;
            right: 70px;
            font-size: 20px;
            font-weight: 700;
            color: #7c3aed;
            display: flex;
            align-items: center;
        }
        .logo-placeholder i {
            margin-right: 8px;
        }
        .keyword {
            display: inline-block;
            background-color: rgba(124, 58, 237, 0.15);
            padding: 3px 8px;
            border-radius: 6px;
            margin: 2px;
            font-weight: 600;
            font-size: 16px;
        }
        .accent-circle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.15) 0%, rgba(124, 58, 237, 0) 70%);
            z-index: 0;
        }
        .accent-circle-1 {
            width: 400px;
            height: 400px;
            top: -150px;
            right: -100px;
        }
        .accent-circle-2 {
            width: 300px;
            height: 300px;
            bottom: -100px;
            left: -100px;
        }
        /* Mobile responsive breakpoints */
        @media (max-width: 768px) {
            .slide {
                padding: 3vh 4vw;
            }
            .content {
                flex-direction: column;
                gap: clamp(1.5rem, 3vh, 2rem);
            }
        }

        @media (max-width: 480px) {
            .slide {
                padding: 2vh 3vw;
            }
            .title {
                font-size: clamp(1.8rem, 6vw, 2.2rem);
            }
        }
    </style>
</head>
<body>
    <div class="slide">
        <div class="accent-circle accent-circle-1"></div>
        <div class="accent-circle accent-circle-2"></div>
        
        <div class="logo-placeholder">
            <i class="fas fa-cube"></i>
            KNIRV
        </div>
        
        <div class="header">
            <h1 class="title">The Solution: KNIRV D-TEN</h1>
        </div>
        
        <div class="content">
            <div class="left-section">
                <div class="description-box">
                    <div class="section-title">
                        <i class="fas fa-lightbulb"></i>
                        Overview
                    </div>
                    <div class="description-text">
                        <span class="keyword">Decentralized Trusted Execution Network</span>
                        transforms AI failures into collective knowledge
                        <div class="mt-3"></div>
                        <span class="keyword">Self-healing</span>
                        continuously evolving intelligence ecosystem
                    </div>
                </div>
                
                <div class="features-box">
                    <div class="section-title">
                        <i class="fas fa-star"></i>
                        Key Features
                    </div>
                    <div class="feature-grid">
                        <div class="feature-item">
                            <i class="fas fa-layer-group feature-icon"></i>
                            <div class="feature-title">Twelve Sovereign Layers</div>
                            <div class="feature-desc">Interconnected components working in harmony</div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-heartbeat feature-icon"></i>
                            <div class="feature-title">Self-Healing System</div>
                            <div class="feature-desc">Transforms failures into structured ErrorNodes</div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-coins feature-icon"></i>
                            <div class="feature-title">Economic Incentives</div>
                            <div class="feature-desc">Solutions become composable, monetizable Skills</div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-shield-alt feature-icon"></i>
                            <div class="feature-title">Cryptographic Security</div>
                            <div class="feature-desc">Powered by NRN token with verified proofs</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="right-section">
                <div class="diagram-container">
                    <div class="section-title">
                        <i class="fas fa-sitemap"></i>
                        D-TEN Ecosystem
                    </div>
                    <div class="diagram">
                        <div class="diagram-layers">
                            <div class="diagram-layer">
                                <i class="fas fa-cube layer-icon"></i>
                                <div class="layer-title">KNIRV-ROOT</div>
                                <div class="layer-desc">Foundational blockchain</div>
                            </div>
                            <div class="diagram-layer">
                                <i class="fas fa-network-wired layer-icon"></i>
                                <div class="layer-title">KNIRV-ROUTER</div>
                                <div class="layer-desc">Network integrity</div>
                            </div>
                            <div class="diagram-layer">
                                <i class="fas fa-project-diagram layer-icon"></i>
                                <div class="layer-title">KNIRVGRAPH</div>
                                <div class="layer-desc">Knowledge fabric</div>
                            </div>
                            <div class="diagram-layer">
                                <i class="fas fa-link layer-icon"></i>
                                <div class="layer-title">KNIRVCHAIN</div>
                                <div class="layer-desc">LLM & registry</div>
                            </div>
                            <div class="diagram-layer">
                                <i class="fas fa-user-shield layer-icon"></i>
                                <div class="layer-title">KNIRV-NEXUS</div>
                                <div class="layer-desc">Validation environments</div>
                            </div>
                            <div class="diagram-layer">
                                <i class="fas fa-robot layer-icon"></i>
                                <div class="layer-title">KNIRV-AGENTIFIER</div>
                                <div class="layer-desc">Self-improving agents</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>