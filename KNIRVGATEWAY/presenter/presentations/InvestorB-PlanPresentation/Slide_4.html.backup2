<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KNIRV Network: The Problem</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Montserrat', sans-serif;
            color: #ffffff;
            overflow: hidden;
            background-color: #0a192f;
        }
        .slide {
            width: 1280px;
            min-height: 720px;
            max-height: 720px;
            position: relative;
            background: linear-gradient(135deg, rgba(10, 25, 47, 0.95), rgba(10, 25, 47, 0.9));
            display: flex;
            flex-direction: column;
        }
        .header {
            padding: 40px 70px 20px;
        }
        .title {
            font-size: 56px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 10px;
            position: relative;
            letter-spacing: -1px;
        }
        .title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 80px;
            height: 4px;
            background-color: #7c3aed;
        }
        .content {
            flex-grow: 1;
            display: flex;
            padding: 20px 70px 40px;
        }
        .problem-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            width: 100%;
        }
        .problem-column {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        .problem-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            backdrop-filter: blur(5px);
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .problem-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-5px);
        }
        .section-title {
            font-size: 32px;
            font-weight: 700;
            color: #7c3aed;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }
        .section-title i {
            margin-right: 12px;
            font-size: 28px;
        }
        .problem-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
            flex-grow: 1;
        }
        .problem-item {
            display: flex;
            align-items: center;
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 16px;
            transition: all 0.3s ease;
        }
        .problem-item:hover {
            background-color: rgba(124, 58, 237, 0.15);
            transform: translateX(5px);
        }
        .problem-icon {
            background-color: rgba(124, 58, 237, 0.2);
            color: #7c3aed;
            border-radius: 50%;
            width: 48px;
            height: 48px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 16px;
            flex-shrink: 0;
            font-size: 20px;
        }
        .problem-text {
            font-size: 18px;
            font-weight: 600;
            line-height: 1.3;
        }
        .keyword {
            display: inline-block;
            background-color: rgba(124, 58, 237, 0.15);
            padding: 3px 8px;
            border-radius: 6px;
            margin: 2px;
            font-weight: 600;
            font-size: 16px;
        }
        .logo-placeholder {
            position: absolute;
            top: 30px;
            right: 70px;
            font-size: 20px;
            font-weight: 700;
            color: #7c3aed;
            display: flex;
            align-items: center;
        }
        .logo-placeholder i {
            margin-right: 8px;
        }
        .accent-circle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.15) 0%, rgba(124, 58, 237, 0) 70%);
            z-index: 0;
        }
        .accent-circle-1 {
            width: 400px;
            height: 400px;
            top: -150px;
            right: -100px;
        }
        .accent-circle-2 {
            width: 300px;
            height: 300px;
            bottom: -100px;
            left: -100px;
        }
        /* Mobile responsive breakpoints */
        @media (max-width: 768px) {
            .slide {
                padding: 3vh 4vw;
            }
            .content {
                flex-direction: column;
                gap: clamp(1.5rem, 3vh, 2rem);
            }
        }

        @media (max-width: 480px) {
            .slide {
                padding: 2vh 3vw;
            }
            .title {
                font-size: clamp(1.8rem, 6vw, 2.2rem);
            }
        }
    </style>
</head>
<body>
    <div class="slide">
        <div class="accent-circle accent-circle-1"></div>
        <div class="accent-circle accent-circle-2"></div>
        
        <div class="logo-placeholder">
            <i class="fas fa-cube"></i>
            KNIRV
        </div>
        
        <div class="header">
            <h1 class="title">The Problem</h1>
        </div>
        
        <div class="content">
            <div class="problem-grid">
                <div class="problem-column">
                    <div class="problem-box">
                        <div class="section-title">
                            <i class="fas fa-exclamation-triangle"></i>
                            Key Challenges
                        </div>
                        <div class="problem-list">
                            <div class="problem-item">
                                <div class="problem-icon">
                                    <i class="fas fa-eye-slash"></i>
                                </div>
                                <div class="problem-text">
                                    <span class="keyword">Lack of transparency</span> in AI decision-making
                                </div>
                            </div>
                            <div class="problem-item">
                                <div class="problem-icon">
                                    <i class="fas fa-server"></i>
                                </div>
                                <div class="problem-text">
                                    <span class="keyword">Centralized control</span> leading to single points of failure
                                </div>
                            </div>
                            <div class="problem-item">
                                <div class="problem-icon">
                                    <i class="fas fa-chart-line"></i>
                                </div>
                                <div class="problem-text">
                                    <span class="keyword">Limited economic incentives</span> for AI innovation
                                </div>
                            </div>
                            <div class="problem-item">
                                <div class="problem-icon">
                                    <i class="fas fa-shield-alt"></i>
                                </div>
                                <div class="problem-text">
                                    <span class="keyword">Security vulnerabilities</span> in AI systems
                                </div>
                            </div>
                            <div class="problem-item">
                                <div class="problem-icon">
                                    <i class="fas fa-check-double"></i>
                                </div>
                                <div class="problem-text">
                                    <span class="keyword">Difficulty in verifying</span> and auditing AI behavior
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="problem-column">
                    <div class="problem-box">
                        <div class="section-title">
                            <i class="fas fa-puzzle-piece"></i>
                            Market Gaps
                        </div>
                        <div class="problem-list">
                            <div class="problem-item">
                                <div class="problem-icon">
                                    <i class="fas fa-cogs"></i>
                                </div>
                                <div class="problem-text">
                                    <span class="keyword">No comprehensive solution</span> for decentralized AI execution
                                </div>
                            </div>
                            <div class="problem-item">
                                <div class="problem-icon">
                                    <i class="fas fa-project-diagram"></i>
                                </div>
                                <div class="problem-text">
                                    <span class="keyword">Fragmented ecosystem</span> with interoperability issues
                                </div>
                            </div>
                            <div class="problem-item">
                                <div class="problem-icon">
                                    <i class="fas fa-door-closed"></i>
                                </div>
                                <div class="problem-text">
                                    <span class="keyword">High barriers to entry</span> for AI developers
                                </div>
                            </div>
                            <div class="problem-item">
                                <div class="problem-icon">
                                    <i class="fas fa-user-shield"></i>
                                </div>
                                <div class="problem-text">
                                    <span class="keyword">Limited trust</span> in autonomous AI systems
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>