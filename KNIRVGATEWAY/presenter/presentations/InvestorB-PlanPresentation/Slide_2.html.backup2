<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KNIRV Network: Vision & Mission</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Montserrat', sans-serif;
            color: #ffffff;
            overflow: hidden;
            background-color: #0a192f;
        }
        .slide {
            width: 1280px;
            min-height: 720px;
            max-height: 720px;
            position: relative;
            background: linear-gradient(135deg, rgba(10, 25, 47, 0.95), rgba(10, 25, 47, 0.9));
            display: flex;
            flex-direction: column;
        }
        .header {
            padding: 40px 70px 20px;
        }
        .title {
            font-size: 56px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 10px;
            position: relative;
            letter-spacing: -1px;
        }
        .title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 80px;
            height: 4px;
            background-color: #7c3aed;
        }
        .content {
            flex-grow: 1;
            display: flex;
            padding: 20px 70px 40px;
        }
        .left-section {
            width: 55%;
            padding-right: 30px;
            display: flex;
            flex-direction: column;
        }
        .right-section {
            width: 45%;
            display: flex;
            flex-direction: column;
        }
        .vision-box, .mission-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 20px;
            backdrop-filter: blur(5px);
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
        }
        .vision-box:hover, .mission-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .section-title {
            font-size: 32px;
            font-weight: 700;
            color: #7c3aed;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }
        .section-title i {
            margin-right: 12px;
            font-size: 28px;
        }
        .section-content {
            font-size: 20px;
            line-height: 1.5;
            color: #e0e0e0;
        }
        .value-props {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 25px;
            height: 100%;
            backdrop-filter: blur(5px);
            border-left: 4px solid #7c3aed;
        }
        .value-prop-item {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            padding: 15px;
            border-radius: 10px;
            transition: all 0.3s ease;
        }
        .value-prop-item:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateX(5px);
        }
        .value-prop-item:last-child {
            margin-bottom: 0;
        }
        .value-prop-icon {
            background-color: rgba(124, 58, 237, 0.2);
            color: #7c3aed;
            border-radius: 50%;
            width: 56px;
            height: 56px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 20px;
            flex-shrink: 0;
            font-size: 24px;
        }
        .value-prop-text {
            font-size: 22px;
            font-weight: 600;
        }
        .highlight {
            color: #7c3aed;
            font-weight: 700;
        }
        .logo-placeholder {
            position: absolute;
            top: 30px;
            right: 70px;
            font-size: 20px;
            font-weight: 700;
            color: #7c3aed;
            display: flex;
            align-items: center;
        }
        .logo-placeholder i {
            margin-right: 8px;
        }
        .keyword {
            display: inline-block;
            background-color: rgba(124, 58, 237, 0.15);
            padding: 4px 10px;
            border-radius: 6px;
            margin: 2px;
            font-weight: 600;
            font-size: 18px;
        }
        .accent-circle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.15) 0%, rgba(124, 58, 237, 0) 70%);
            z-index: 0;
        }
        .accent-circle-1 {
            width: 400px;
            height: 400px;
            top: -150px;
            right: -100px;
        }
        .accent-circle-2 {
            width: 300px;
            height: 300px;
            bottom: -100px;
            left: -100px;
        }
        /* Mobile responsive breakpoints */
        @media (max-width: 768px) {
            .slide {
                padding: 3vh 4vw;
            }
            .content {
                flex-direction: column;
                gap: clamp(1.5rem, 3vh, 2rem);
            }
        }

        @media (max-width: 480px) {
            .slide {
                padding: 2vh 3vw;
            }
            .title {
                font-size: clamp(1.8rem, 6vw, 2.2rem);
            }
        }
    </style>
</head>
<body>
    <div class="slide">
        <div class="accent-circle accent-circle-1"></div>
        <div class="accent-circle accent-circle-2"></div>
        
        <div class="logo-placeholder">
            <i class="fas fa-cube"></i>
            KNIRV
        </div>
        
        <div class="header">
            <h1 class="title">Vision & Mission</h1>
        </div>
        
        <div class="content">
            <div class="left-section">
                <div class="vision-box">
                    <div class="section-title">
                        <i class="fas fa-bullseye"></i>
                        Vision
                    </div>
                    <div class="section-content">
                        <span class="keyword">World's premier</span> 
                        <span class="keyword">decentralized infrastructure</span> 
                        for autonomous AI agents
                        <div class="mt-3"></div>
                        <span class="keyword">Foundational layer</span> 
                        for next generation of 
                        <span class="keyword">verifiable</span>, 
                        <span class="keyword">self-improving</span> 
                        AI systems
                    </div>
                </div>
                
                <div class="mission-box">
                    <div class="section-title">
                        <i class="fas fa-rocket"></i>
                        Mission
                    </div>
                    <div class="section-content">
                        <span class="keyword">Democratize access</span> to 
                        <span class="keyword">secure</span>, 
                        <span class="keyword">scalable</span> AI infrastructure
                        <div class="mt-3"></div>
                        Ensure 
                        <span class="keyword">transparency</span>, 
                        <span class="keyword">verifiability</span>, 
                        <span class="keyword">economic incentivization</span> 
                        through multi-layered architecture
                    </div>
                </div>
            </div>
            
            <div class="right-section">
                <div class="value-props">
                    <div class="section-title">
                        <i class="fas fa-star"></i>
                        Key Value Propositions
                    </div>
                    
                    <div class="value-prop-item">
                        <div class="value-prop-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="value-prop-text">Verifiable AI Decision-Making</div>
                    </div>
                    
                    <div class="value-prop-item">
                        <div class="value-prop-icon">
                            <i class="fas fa-brain"></i>
                        </div>
                        <div class="value-prop-text">Self-Improving Agents</div>
                    </div>
                    
                    <div class="value-prop-item">
                        <div class="value-prop-icon">
                            <i class="fas fa-coins"></i>
                        </div>
                        <div class="value-prop-text">Economic Incentivization</div>
                    </div>
                    
                    <div class="value-prop-item">
                        <div class="value-prop-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div class="value-prop-text">Enterprise-Grade Security</div>
                    </div>
                    
                    <div class="value-prop-item">
                        <div class="value-prop-icon">
                            <i class="fas fa-code"></i>
                        </div>
                        <div class="value-prop-text">Developer-Friendly Ecosystem</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>