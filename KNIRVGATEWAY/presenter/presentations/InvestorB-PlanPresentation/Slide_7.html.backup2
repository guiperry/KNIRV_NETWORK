<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KNIRV Network: Leadership Team</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Montserrat', sans-serif;
            color: #ffffff;
            overflow: hidden;
            background-color: #0a192f;
        }
        .slide {
            width: 1280px;
            min-height: 720px;
            max-height: 720px;
            position: relative;
            background: linear-gradient(135deg, rgba(10, 25, 47, 0.95), rgba(10, 25, 47, 0.9));
            display: flex;
            flex-direction: column;
        }
        .header {
            padding: 40px 70px 20px;
        }
        .title {
            font-size: 56px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 10px;
            position: relative;
            letter-spacing: -1px;
        }
        .title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 80px;
            height: 4px;
            background-color: #7c3aed;
        }
        .content {
            flex-grow: 1;
            display: flex;
            padding: 20px 70px 40px;
        }
        .left-section {
            width: 55%;
            padding-right: 30px;
            display: flex;
            flex-direction: column;
        }
        .right-section {
            width: 45%;
            display: flex;
            flex-direction: column;
        }
        .team-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            backdrop-filter: blur(5px);
            flex-grow: 1;
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .team-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .section-title {
            font-size: 32px;
            font-weight: 700;
            color: #7c3aed;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }
        .section-title i {
            margin-right: 12px;
            font-size: 28px;
        }
        .team-members {
            display: flex;
            flex-direction: column;
            gap: 20px;
            flex-grow: 1;
        }
        .team-member {
            display: flex;
            align-items: center;
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 20px;
            transition: all 0.3s ease;
        }
        .team-member:hover {
            background-color: rgba(124, 58, 237, 0.15);
            transform: translateX(5px);
        }
        .member-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background-color: rgba(124, 58, 237, 0.2);
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 20px;
            flex-shrink: 0;
        }
        .member-avatar i {
            font-size: 36px;
            color: #7c3aed;
        }
        .member-info {
            flex-grow: 1;
        }
        .member-name {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 5px;
        }
        .member-title {
            font-size: 18px;
            color: #7c3aed;
            margin-bottom: 8px;
        }
        .member-desc {
            font-size: 16px;
            color: #e0e0e0;
            line-height: 1.4;
        }
        .expertise-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            backdrop-filter: blur(5px);
            margin-bottom: 20px;
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
        }
        .expertise-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .expertise-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        .expertise-item {
            display: flex;
            align-items: center;
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 15px;
            transition: all 0.3s ease;
        }
        .expertise-item:hover {
            background-color: rgba(124, 58, 237, 0.15);
            transform: translateY(-3px);
        }
        .expertise-icon {
            background-color: rgba(124, 58, 237, 0.2);
            color: #7c3aed;
            border-radius: 50%;
            width: 56px;
            height: 56px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 15px;
            flex-shrink: 0;
            font-size: 24px;
        }
        .expertise-text {
            font-size: 20px;
            font-weight: 600;
        }
        .hiring-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            backdrop-filter: blur(5px);
            flex-grow: 1;
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
        }
        .hiring-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .hiring-chart {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 20px;
        }
        .hiring-bar {
            display: flex;
            align-items: center;
        }
        .hiring-year {
            width: 80px;
            font-size: 18px;
            font-weight: 600;
            margin-right: 15px;
        }
        .hiring-bar-container {
            flex-grow: 1;
            height: 30px;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            overflow: hidden;
            position: relative;
        }
        .hiring-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #7c3aed, #6d28d9);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 15px;
            font-weight: 600;
            color: #ffffff;
            transition: width 1s ease-in-out;
        }
        .logo-placeholder {
            position: absolute;
            top: 30px;
            right: 70px;
            font-size: 20px;
            font-weight: 700;
            color: #7c3aed;
            display: flex;
            align-items: center;
        }
        .logo-placeholder i {
            margin-right: 8px;
        }
        .keyword {
            display: inline-block;
            background-color: rgba(124, 58, 237, 0.15);
            padding: 3px 8px;
            border-radius: 6px;
            margin: 2px;
            font-weight: 600;
            font-size: 16px;
        }
        .accent-circle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.15) 0%, rgba(124, 58, 237, 0) 70%);
            z-index: 0;
        }
        .accent-circle-1 {
            width: 400px;
            height: 400px;
            top: -150px;
            right: -100px;
        }
        .accent-circle-2 {
            width: 300px;
            height: 300px;
            bottom: -100px;
            left: -100px;
        }
        /* Mobile responsive breakpoints */
        @media (max-width: 768px) {
            .slide {
                padding: 3vh 4vw;
            }
            .content {
                flex-direction: column;
                gap: clamp(1.5rem, 3vh, 2rem);
            }
        }

        @media (max-width: 480px) {
            .slide {
                padding: 2vh 3vw;
            }
            .title {
                font-size: clamp(1.8rem, 6vw, 2.2rem);
            }
        }
    </style>
</head>
<body>
    <div class="slide">
        <div class="accent-circle accent-circle-1"></div>
        <div class="accent-circle accent-circle-2"></div>
        
        <div class="logo-placeholder">
            <i class="fas fa-cube"></i>
            KNIRV
        </div>
        
        <div class="header">
            <h1 class="title">Leadership Team</h1>
        </div>
        
        <div class="content">
            <div class="left-section">
                <div class="team-box">
                    <div class="section-title">
                        <i class="fas fa-users"></i>
                        Key Team Members
                    </div>
                    <div class="team-members">
                        <div class="team-member">
                            <div class="member-avatar">
                                <i class="fas fa-user-tie"></i>
                            </div>
                            <div class="member-info">
                                <div class="member-name">Guillermo Perry</div>
                                <div class="member-title">Chief Solutions Architect / Founder</div>
                                <div class="member-desc">
                                    <span class="keyword">Technical vision</span>
                                    <span class="keyword">architecture</span>
                                    <span class="keyword">decentralized systems</span>
                                </div>
                            </div>
                        </div>
                        <div class="team-member">
                            <div class="member-avatar">
                                <i class="fas fa-code"></i>
                            </div>
                            <div class="member-info">
                                <div class="member-name">Herman Duquerronette</div>
                                <div class="member-title">Sr. Software Developer</div>
                                <div class="member-desc">
                                    <span class="keyword">Distributed systems</span>
                                    <span class="keyword">blockchain</span>
                                    <span class="keyword">high-performance</span>
                                </div>
                            </div>
                        </div>
                        <div class="team-member">
                            <div class="member-avatar">
                                <i class="fas fa-tasks"></i>
                            </div>
                            <div class="member-info">
                                <div class="member-name">Kareem Bullard</div>
                                <div class="member-title">Project Manager</div>
                                <div class="member-desc">
                                    <span class="keyword">Coordination</span>
                                    <span class="keyword">agile</span>
                                    <span class="keyword">complex timelines</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="right-section">
                <div class="expertise-box">
                    <div class="section-title">
                        <i class="fas fa-brain"></i>
                        Team Expertise
                    </div>
                    <div class="expertise-grid">
                        <div class="expertise-item">
                            <div class="expertise-icon">
                                <i class="fab fa-bitcoin"></i>
                            </div>
                            <div class="expertise-text">Blockchain Technology</div>
                        </div>
                        <div class="expertise-item">
                            <div class="expertise-icon">
                                <i class="fas fa-robot"></i>
                            </div>
                            <div class="expertise-text">AI & Machine Learning</div>
                        </div>
                        <div class="expertise-item">
                            <div class="expertise-icon">
                                <i class="fas fa-network-wired"></i>
                            </div>
                            <div class="expertise-text">Decentralized Systems</div>
                        </div>
                        <div class="expertise-item">
                            <div class="expertise-icon">
                                <i class="fas fa-building"></i>
                            </div>
                            <div class="expertise-text">Enterprise Software</div>
                        </div>
                    </div>
                </div>
                
                <div class="hiring-box">
                    <div class="section-title">
                        <i class="fas fa-chart-line"></i>
                        Hiring Plan
                    </div>
                    <div class="hiring-chart">
                        <div class="hiring-bar">
                            <div class="hiring-year">Year 1</div>
                            <div class="hiring-bar-container">
                                <div class="hiring-bar-fill" style="width: 6%;">25</div>
                            </div>
                        </div>
                        <div class="hiring-bar">
                            <div class="hiring-year">Year 2</div>
                            <div class="hiring-bar-container">
                                <div class="hiring-bar-fill" style="width: 19%;">75</div>
                            </div>
                        </div>
                        <div class="hiring-bar">
                            <div class="hiring-year">Year 3</div>
                            <div class="hiring-bar-container">
                                <div class="hiring-bar-fill" style="width: 38%;">150</div>
                            </div>
                        </div>
                        <div class="hiring-bar">
                            <div class="hiring-year">Year 4</div>
                            <div class="hiring-bar-container">
                                <div class="hiring-bar-fill" style="width: 63%;">250</div>
                            </div>
                        </div>
                        <div class="hiring-bar">
                            <div class="hiring-year">Year 5</div>
                            <div class="hiring-bar-container">
                                <div class="hiring-bar-fill" style="width: 100%;">400</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>