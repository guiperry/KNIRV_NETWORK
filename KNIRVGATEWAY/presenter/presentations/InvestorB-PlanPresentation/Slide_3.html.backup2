<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KNIRV Network: Market Opportunity</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Montserrat', sans-serif;
            color: #ffffff;
            overflow: hidden;
            background-color: #0a192f;
        }
        .slide {
            width: 1280px;
            min-height: 720px;
            max-height: 720px;
            position: relative;
            background: linear-gradient(135deg, rgba(10, 25, 47, 0.95), rgba(10, 25, 47, 0.9));
            display: flex;
            flex-direction: column;
        }
        .header {
            padding: 40px 70px 20px;
        }
        .title {
            font-size: 56px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 10px;
            position: relative;
            letter-spacing: -1px;
        }
        .title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 80px;
            height: 4px;
            background-color: #7c3aed;
        }
        .content {
            flex-grow: 1;
            display: flex;
            padding: 20px 70px 40px;
        }
        .left-section {
            width: 55%;
            padding-right: 30px;
            display: flex;
            flex-direction: column;
        }
        .right-section {
            width: 45%;
            display: flex;
            flex-direction: column;
        }
        .market-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 25px;
            backdrop-filter: blur(5px);
            flex-grow: 1;
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
        }
        .market-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .section-title {
            font-size: 32px;
            font-weight: 700;
            color: #7c3aed;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }
        .section-title i {
            margin-right: 12px;
            font-size: 28px;
        }
        .market-item {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            padding: 15px;
            transition: all 0.3s ease;
        }
        .market-item:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateX(5px);
        }
        .market-item:last-child {
            margin-bottom: 0;
        }
        .market-icon {
            background-color: rgba(124, 58, 237, 0.2);
            color: #7c3aed;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 20px;
            flex-shrink: 0;
            font-size: 28px;
        }
        .market-details {
            flex-grow: 1;
        }
        .market-name {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 5px;
        }
        .market-value {
            font-size: 36px;
            font-weight: 800;
            color: #7c3aed;
            line-height: 1.1;
        }
        .market-growth {
            font-size: 18px;
            color: #e0e0e0;
            margin-top: 2px;
        }
        .chart-container {
            height: 320px;
            margin-bottom: 20px;
        }
        .drivers-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 25px;
            backdrop-filter: blur(5px);
            flex-grow: 1;
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
        }
        .drivers-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .driver-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 15px;
            padding: 15px;
            border-radius: 10px;
            transition: all 0.3s ease;
        }
        .driver-item:hover {
            background-color: rgba(124, 58, 237, 0.1);
        }
        .driver-item:last-child {
            margin-bottom: 0;
        }
        .driver-icon {
            color: #7c3aed;
            margin-right: 15px;
            flex-shrink: 0;
            font-size: 24px;
        }
        .driver-text {
            font-size: 20px;
            line-height: 1.4;
        }
        .highlight {
            color: #7c3aed;
            font-weight: 700;
        }
        .logo-placeholder {
            position: absolute;
            top: 30px;
            right: 70px;
            font-size: 20px;
            font-weight: 700;
            color: #7c3aed;
            display: flex;
            align-items: center;
        }
        .logo-placeholder i {
            margin-right: 8px;
        }
        .keyword {
            display: inline-block;
            background-color: rgba(124, 58, 237, 0.15);
            padding: 4px 10px;
            border-radius: 6px;
            margin: 2px;
            font-weight: 600;
            font-size: 18px;
        }
        .accent-circle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.15) 0%, rgba(124, 58, 237, 0) 70%);
            z-index: 0;
        }
        .accent-circle-1 {
            width: 400px;
            height: 400px;
            top: -150px;
            right: -100px;
        }
        .accent-circle-2 {
            width: 300px;
            height: 300px;
            bottom: -100px;
            left: -100px;
        }
        /* Mobile responsive breakpoints */
        @media (max-width: 768px) {
            .slide {
                padding: 3vh 4vw;
            }
            .content {
                flex-direction: column;
                gap: clamp(1.5rem, 3vh, 2rem);
            }
        }

        @media (max-width: 480px) {
            .slide {
                padding: 2vh 3vw;
            }
            .title {
                font-size: clamp(1.8rem, 6vw, 2.2rem);
            }
        }
    </style>
</head>
<body>
    <div class="slide">
        <div class="accent-circle accent-circle-1"></div>
        <div class="accent-circle accent-circle-2"></div>
        
        <div class="logo-placeholder">
            <i class="fas fa-cube"></i>
            KNIRV
        </div>
        
        <div class="header">
            <h1 class="title">Market Opportunity</h1>
        </div>
        
        <div class="content">
            <div class="left-section">
                <div class="market-box">
                    <div class="section-title">
                        <i class="fas fa-chart-line"></i>
                        Market Size & Growth
                    </div>
                    
                    <div class="market-item">
                        <div class="market-icon">
                            <i class="fab fa-bitcoin"></i>
                        </div>
                        <div class="market-details">
                            <div class="market-name">Blockchain AI Market</div>
                            <div class="market-value">$335.8B</div>
                            <div class="market-growth">58.9% CAGR</div>
                        </div>
                    </div>
                    
                    <div class="market-item">
                        <div class="market-icon">
                            <i class="fas fa-network-wired"></i>
                        </div>
                        <div class="market-details">
                            <div class="market-name">Decentralized AI Infrastructure</div>
                            <div class="market-value">$59.8B</div>
                            <div class="market-growth">19.3% CAGR</div>
                        </div>
                    </div>
                    
                    <div class="market-item">
                        <div class="market-icon">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div class="market-details">
                            <div class="market-name">AI Agent Platforms</div>
                            <div class="market-value">$50B+</div>
                            <div class="market-growth">Explosive growth</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="right-section">
                <div class="chart-container">
                    <canvas id="marketGrowthChart"></canvas>
                </div>
                
                <div class="drivers-box">
                    <div class="section-title">
                        <i class="fas fa-rocket"></i>
                        Market Drivers
                    </div>
                    
                    <div class="driver-item">
                        <div class="driver-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div class="driver-text">
                            <span class="keyword">Privacy concerns</span> 
                            <span class="keyword">centralization risks</span>
                        </div>
                    </div>
                    
                    <div class="driver-item">
                        <div class="driver-icon">
                            <i class="fas fa-building"></i>
                        </div>
                        <div class="driver-text">
                            <span class="keyword">Enterprise adoption</span> 
                            <span class="keyword">accelerating</span>
                        </div>
                    </div>
                    
                    <div class="driver-item">
                        <div class="driver-icon">
                            <i class="fas fa-hand-holding-usd"></i>
                        </div>
                        <div class="driver-text">
                            <span class="keyword">$1.39B</span> 
                            raised in 2025 alone
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('marketGrowthChart').getContext('2d');
            
            const gradientFill = ctx.createLinearGradient(0, 0, 0, 400);
            gradientFill.addColorStop(0, 'rgba(124, 58, 237, 0.4)');
            gradientFill.addColorStop(1, 'rgba(124, 58, 237, 0.05)');
            
            const marketGrowthChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['2025', '2026', '2027', '2028', '2029', '2030'],
                    datasets: [{
                        label: 'Blockchain AI Market ($B)',
                        data: [25, 40, 65, 105, 190, 335.8],
                        borderColor: '#7c3aed',
                        backgroundColor: gradientFill,
                        borderWidth: 3,
                        pointBackgroundColor: '#7c3aed',
                        pointRadius: 4,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            labels: {
                                color: '#e0e0e0',
                                font: {
                                    size: 14,
                                    family: "'Montserrat', sans-serif"
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(10, 25, 47, 0.8)',
                            titleColor: '#7c3aed',
                            bodyColor: '#ffffff',
                            titleFont: {
                                size: 16,
                                family: "'Montserrat', sans-serif"
                            },
                            bodyFont: {
                                size: 14,
                                family: "'Montserrat', sans-serif"
                            },
                            padding: 12,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return `$${context.parsed.y}B`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)',
                                drawBorder: false
                            },
                            ticks: {
                                color: '#e0e0e0',
                                font: {
                                    family: "'Montserrat', sans-serif"
                                }
                            }
                        },
                        y: {
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)',
                                drawBorder: false
                            },
                            ticks: {
                                color: '#e0e0e0',
                                font: {
                                    family: "'Montserrat', sans-serif"
                                },
                                callback: function(value) {
                                    return '$' + value + 'B';
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>