<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KNIRV Network: Business Model & Revenue</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Montserrat', sans-serif;
            color: #ffffff;
            overflow: hidden;
            background-color: #0a192f;
        }
        .slide {
            width: 1280px;
            min-height: 720px;
            max-height: 720px;
            position: relative;
            background: linear-gradient(135deg, rgba(10, 25, 47, 0.95), rgba(10, 25, 47, 0.9));
            display: flex;
            flex-direction: column;
        }
        .header {
            padding: 40px 70px 20px;
        }
        .title {
            font-size: 56px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 10px;
            position: relative;
            letter-spacing: -1px;
        }
        .title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 80px;
            height: 4px;
            background-color: #7c3aed;
        }
        .content {
            flex-grow: 1;
            display: flex;
            padding: 20px 70px 40px;
        }
        .left-section {
            width: 60%;
            padding-right: 30px;
            display: flex;
            flex-direction: column;
        }
        .right-section {
            width: 40%;
            display: flex;
            flex-direction: column;
        }
        .revenue-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            backdrop-filter: blur(5px);
            margin-bottom: 20px;
            flex-grow: 1;
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .revenue-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .section-title {
            font-size: 32px;
            font-weight: 700;
            color: #7c3aed;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }
        .section-title i {
            margin-right: 12px;
            font-size: 28px;
        }
        .chart-container {
            height: 220px;
            margin-bottom: 20px;
        }
        .revenue-streams {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            flex-grow: 1;
        }
        .revenue-item {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 15px;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .revenue-item:hover {
            background-color: rgba(124, 58, 237, 0.15);
            transform: translateY(-3px);
        }
        .revenue-header {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }
        .revenue-icon {
            background-color: rgba(124, 58, 237, 0.2);
            color: #7c3aed;
            border-radius: 50%;
            width: 48px;
            height: 48px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 12px;
            flex-shrink: 0;
            font-size: 20px;
        }
        .revenue-title {
            font-size: 20px;
            font-weight: 700;
        }
        .revenue-percentage {
            margin-left: auto;
            font-size: 24px;
            font-weight: 800;
            color: #7c3aed;
        }
        .revenue-details {
            font-size: 16px;
            color: #e0e0e0;
            line-height: 1.4;
            flex-grow: 1;
        }
        .token-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            backdrop-filter: blur(5px);
            margin-bottom: 20px;
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
        }
        .token-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .token-distribution {
            height: 200px;
            margin-bottom: 20px;
        }
        .utility-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            backdrop-filter: blur(5px);
            flex-grow: 1;
            border-left: 4px solid #7c3aed;
            transition: all 0.3s ease;
        }
        .utility-box:hover {
            background-color: rgba(124, 58, 237, 0.1);
            transform: translateY(-3px);
        }
        .utility-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .utility-item {
            display: flex;
            align-items: center;
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 15px;
            transition: all 0.3s ease;
        }
        .utility-item:hover {
            background-color: rgba(124, 58, 237, 0.15);
            transform: translateX(5px);
        }
        .utility-icon {
            color: #7c3aed;
            margin-right: 15px;
            font-size: 24px;
            flex-shrink: 0;
        }
        .utility-text {
            font-size: 18px;
            font-weight: 600;
        }
        .logo-placeholder {
            position: absolute;
            top: 30px;
            right: 70px;
            font-size: 20px;
            font-weight: 700;
            color: #7c3aed;
            display: flex;
            align-items: center;
        }
        .logo-placeholder i {
            margin-right: 8px;
        }
        .keyword {
            display: inline-block;
            background-color: rgba(124, 58, 237, 0.15);
            padding: 3px 8px;
            border-radius: 6px;
            margin: 2px;
            font-weight: 600;
            font-size: 16px;
        }
        .accent-circle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.15) 0%, rgba(124, 58, 237, 0) 70%);
            z-index: 0;
        }
        .accent-circle-1 {
            width: 400px;
            height: 400px;
            top: -150px;
            right: -100px;
        }
        .accent-circle-2 {
            width: 300px;
            height: 300px;
            bottom: -100px;
            left: -100px;
        }
        /* Mobile responsive breakpoints */
        @media (max-width: 768px) {
            .slide {
                padding: 3vh 4vw;
            }
            .content {
                flex-direction: column;
                gap: clamp(1.5rem, 3vh, 2rem);
            }
        }

        @media (max-width: 480px) {
            .slide {
                padding: 2vh 3vw;
            }
            .title {
                font-size: clamp(1.8rem, 6vw, 2.2rem);
            }
        }
    </style>
</head>
<body>
    <div class="slide">
        <div class="accent-circle accent-circle-1"></div>
        <div class="accent-circle accent-circle-2"></div>
        
        <div class="logo-placeholder">
            <i class="fas fa-cube"></i>
            KNIRV
        </div>
        
        <div class="header">
            <h1 class="title">Business Model & Revenue</h1>
        </div>
        
        <div class="content">
            <div class="left-section">
                <div class="revenue-box">
                    <div class="section-title">
                        <i class="fas fa-coins"></i>
                        Revenue Distribution
                    </div>
                    <div class="chart-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                    <div class="revenue-streams">
                        <div class="revenue-item">
                            <div class="revenue-header">
                                <div class="revenue-icon">
                                    <i class="fas fa-exchange-alt"></i>
                                </div>
                                <div class="revenue-title">Transaction Fees</div>
                                <div class="revenue-percentage">40%</div>
                            </div>
                            <div class="revenue-details">
                                <span class="keyword">Agent certification</span> 
                                <span class="keyword">Skill minting</span> 
                                <span class="keyword">Network usage</span>
                            </div>
                        </div>
                        <div class="revenue-item">
                            <div class="revenue-header">
                                <div class="revenue-icon">
                                    <i class="fas fa-code"></i>
                                </div>
                                <div class="revenue-title">API & SDK Licensing</div>
                                <div class="revenue-percentage">25%</div>
                            </div>
                            <div class="revenue-details">
                                <span class="keyword">Developer tier</span> 
                                <span class="keyword">Professional</span> 
                                <span class="keyword">Enterprise</span>
                            </div>
                        </div>
                        <div class="revenue-item">
                            <div class="revenue-header">
                                <div class="revenue-icon">
                                    <i class="fas fa-coins"></i>
                                </div>
                                <div class="revenue-title">Token Economy</div>
                                <div class="revenue-percentage">20%</div>
                            </div>
                            <div class="revenue-details">
                                <span class="keyword">Staking rewards</span> 
                                <span class="keyword">Liquidity mining</span> 
                                <span class="keyword">Governance</span>
                            </div>
                        </div>
                        <div class="revenue-item">
                            <div class="revenue-header">
                                <div class="revenue-icon">
                                    <i class="fas fa-building"></i>
                                </div>
                                <div class="revenue-title">Enterprise Services</div>
                                <div class="revenue-percentage">15%</div>
                            </div>
                            <div class="revenue-details">
                                <span class="keyword">Consulting</span> 
                                <span class="keyword">Custom dev</span> 
                                <span class="keyword">Training</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="right-section">
                <div class="token-box">
                    <div class="section-title">
                        <i class="fas fa-chart-pie"></i>
                        Token Distribution
                    </div>
                    <div class="token-distribution">
                        <canvas id="tokenChart"></canvas>
                    </div>
                </div>
                
                <div class="utility-box">
                    <div class="section-title">
                        <i class="fas fa-star"></i>
                        Token Utility Functions
                    </div>
                    <div class="utility-list">
                        <div class="utility-item">
                            <i class="fas fa-money-bill-wave utility-icon"></i>
                            <div class="utility-text">
                                <span class="keyword">Transaction Fees</span> - Primary medium of exchange
                            </div>
                        </div>
                        <div class="utility-item">
                            <i class="fas fa-piggy-bank utility-icon"></i>
                            <div class="utility-text">
                                <span class="keyword">Staking</span> - Network security & governance
                            </div>
                        </div>
                        <div class="utility-item">
                            <i class="fas fa-shopping-cart utility-icon"></i>
                            <div class="utility-text">
                                <span class="keyword">Skill Purchasing</span> - Access to AI capabilities
                            </div>
                        </div>
                        <div class="utility-item">
                            <i class="fas fa-server utility-icon"></i>
                            <div class="utility-text">
                                <span class="keyword">Node Operation</span> - Validator collateral
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Revenue Distribution Chart
            const revenueCtx = document.getElementById('revenueChart').getContext('2d');
            const revenueChart = new Chart(revenueCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Transaction Fees', 'API & SDK Licensing', 'Token Economy', 'Enterprise Services'],
                    datasets: [{
                        data: [40, 25, 20, 15],
                        backgroundColor: [
                            '#7c3aed',
                            '#6d28d9',
                            '#5b21b6',
                            '#4c1d95'
                        ],
                        borderColor: 'rgba(10, 25, 47, 0.8)',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                color: '#e0e0e0',
                                font: {
                                    size: 14,
                                    family: "'Montserrat', sans-serif"
                                },
                                padding: 15
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(10, 25, 47, 0.8)',
                            titleColor: '#7c3aed',
                            bodyColor: '#ffffff',
                            titleFont: {
                                size: 16,
                                family: "'Montserrat', sans-serif"
                            },
                            bodyFont: {
                                size: 14,
                                family: "'Montserrat', sans-serif"
                            },
                            padding: 12,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.raw + '%';
                                }
                            }
                        }
                    },
                    cutout: '60%'
                }
            });

            // Token Distribution Chart
            const tokenCtx = document.getElementById('tokenChart').getContext('2d');
            const tokenChart = new Chart(tokenCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Public Sale', 'Team & Advisors', 'Development Fund', 'Ecosystem Incentives', 'Strategic Partners'],
                    datasets: [{
                        data: [30, 20, 25, 15, 10],
                        backgroundColor: [
                            '#7c3aed',
                            '#6d28d9',
                            '#5b21b6',
                            '#4c1d95',
                            '#3b0764'
                        ],
                        borderColor: 'rgba(10, 25, 47, 0.8)',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                color: '#e0e0e0',
                                font: {
                                    size: 14,
                                    family: "'Montserrat', sans-serif"
                                },
                                padding: 10
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(10, 25, 47, 0.8)',
                            titleColor: '#7c3aed',
                            bodyColor: '#ffffff',
                            titleFont: {
                                size: 16,
                                family: "'Montserrat', sans-serif"
                            },
                            bodyFont: {
                                size: 14,
                                family: "'Montserrat', sans-serif"
                            },
                            padding: 12,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.raw + '%';
                                }
                            }
                        }
                    },
                    cutout: '60%'
                }
            });
        });
    </script>
</body>
</html>