<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KNIRV Network: Strategic Roadmap</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Montserrat', sans-serif;
            color: #ffffff;
            overflow: hidden;
            background-color: #0a192f;
        }
        .slide {
            width: 1280px;
            min-height: 720px;
            max-height: 720px;
            position: relative;
            background: linear-gradient(135deg, rgba(10, 25, 47, 0.95), rgba(10, 25, 47, 0.9));
            display: flex;
            flex-direction: column;
        }
        .header {
            padding: 40px 70px 20px;
        }
        .title {
            font-size: 56px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 10px;
            position: relative;
            letter-spacing: -1px;
        }
        .title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 80px;
            height: 4px;
            background-color: #7c3aed;
        }
        .content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            padding: 20px 70px 40px;
        }
        .phases-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            flex-grow: 1;
        }
        .phase-box {
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 25px;
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
            border-left: 4px solid #7c3aed;
            height: 100%;
        }
        .phase-box:hover {
            background-color: rgba(255, 255, 255, 0.08);
            transform: translateY(-5px);
        }
        .phase-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        .phase-number {
            font-size: 36px;
            font-weight: 800;
            color: #7c3aed;
            margin-right: 15px;
            background-color: rgba(124, 58, 237, 0.1);
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-shrink: 0;
        }
        .phase-title-container {
            flex-grow: 1;
        }
        .phase-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
        }
        .phase-subtitle {
            font-size: 18px;
            color: #e0e0e0;
        }
        .phase-milestones {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .milestone-item {
            display: flex;
            align-items: flex-start;
        }
        .milestone-icon {
            color: #7c3aed;
            margin-right: 12px;
            flex-shrink: 0;
            font-size: 20px;
            margin-top: 2px;
        }
        .milestone-text {
            font-size: 18px;
            line-height: 1.4;
        }
        .highlight {
            color: #7c3aed;
            font-weight: 700;
        }
        .logo-placeholder {
            position: absolute;
            top: 30px;
            right: 70px;
            font-size: 20px;
            font-weight: 700;
            color: #7c3aed;
            display: flex;
            align-items: center;
        }
        .logo-placeholder i {
            margin-right: 8px;
        }
        .keyword {
            display: inline-block;
            background-color: rgba(124, 58, 237, 0.15);
            padding: 3px 8px;
            border-radius: 6px;
            margin: 2px;
            font-weight: 600;
            font-size: 16px;
        }
        .accent-circle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.15) 0%, rgba(124, 58, 237, 0) 70%);
            z-index: 0;
        }
        .accent-circle-1 {
            width: 400px;
            height: 400px;
            top: -150px;
            right: -100px;
        }
        .accent-circle-2 {
            width: 300px;
            height: 300px;
            bottom: -100px;
            left: -100px;
        }
        /* Mobile responsive breakpoints */
        @media (max-width: 768px) {
            .slide {
                padding: 3vh 4vw;
            }
            .content {
                flex-direction: column;
                gap: clamp(1.5rem, 3vh, 2rem);
            }
        }

        @media (max-width: 480px) {
            .slide {
                padding: 2vh 3vw;
            }
            .title {
                font-size: clamp(1.8rem, 6vw, 2.2rem);
            }
        }
    </style>
</head>
<body>
    <div class="slide">
        <div class="accent-circle accent-circle-1"></div>
        <div class="accent-circle accent-circle-2"></div>
        
        <div class="logo-placeholder">
            <i class="fas fa-cube"></i>
            KNIRV
        </div>
        
        <div class="header">
            <h1 class="title">Strategic Roadmap</h1>
        </div>
        
        <div class="content">
            <div class="phases-container">
                <div class="phase-box">
                    <div class="phase-header">
                        <div class="phase-number">1</div>
                        <div class="phase-title-container">
                            <div class="phase-title">Foundation</div>
                            <div class="phase-subtitle">Months 1-12</div>
                        </div>
                    </div>
                    <div class="phase-milestones">
                        <div class="milestone-item">
                            <i class="fas fa-shield-alt milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">KNIRV-ROOT</span> security audit
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-bug milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">KNIRV-TESNET</span> with 1,000+ testers
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-code milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">KNIRV-SDK</span> developer preview
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-handshake milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">5+</span> cloud provider partnerships
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-coins milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">$75M</span> Series B funding
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="phase-box">
                    <div class="phase-header">
                        <div class="phase-number">2</div>
                        <div class="phase-title-container">
                            <div class="phase-title">Launch</div>
                            <div class="phase-subtitle">Months 13-24</div>
                        </div>
                    </div>
                    <div class="phase-milestones">
                        <div class="milestone-item">
                            <i class="fas fa-rocket milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">Mainnet</span> with full architecture
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-wallet milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">KNIRV-WALLET</span> public release
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-robot milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">100+</span> certified AI agents
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-coins milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">Token</span> generation event
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-building milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">10+</span> Fortune 500 pilots
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="phase-box">
                    <div class="phase-header">
                        <div class="phase-number">3</div>
                        <div class="phase-title-container">
                            <div class="phase-title">Scale</div>
                            <div class="phase-subtitle">Months 25-36</div>
                        </div>
                    </div>
                    <div class="phase-milestones">
                        <div class="milestone-item">
                            <i class="fas fa-globe milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">Europe & Asia</span> expansion
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-project-diagram milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">KNIRV-GRAPH</span> with 10,000+ skills
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-mobile-alt milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">iOS & Android</span> applications
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-plus-circle milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">Strategic</span> acquisitions
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="phase-box">
                    <div class="phase-header">
                        <div class="phase-number">4</div>
                        <div class="phase-title-container">
                            <div class="phase-title">Dominance</div>
                            <div class="phase-subtitle">Years 4-5</div>
                        </div>
                    </div>
                    <div class="phase-milestones">
                        <div class="milestone-item">
                            <i class="fas fa-users milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">100,000+</span> certified AI agents
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-balance-scale milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">Global</span> compliance framework
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-certificate milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">99.99%</span> SLA guarantees
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-cogs milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">Autonomous</span> network governance
                            </div>
                        </div>
                        <div class="milestone-item">
                            <i class="fas fa-chart-line milestone-icon"></i>
                            <div class="milestone-text">
                                <span class="keyword">$10B+</span> ecosystem valuation
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>