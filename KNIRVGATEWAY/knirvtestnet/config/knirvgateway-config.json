{
  "server": {
    "host": "0.0.0.0",
    "port": 8087,
    "cors": {
      "enabled": true,
      "origins": ["*"]
    }
  },
  "services": {
    "knirvroot": {
      "endpoint": "http://localhost:1317",
      "timeout": "30s"
    },
    "knirvchain": {
      "endpoint": "http://localhost:8080", 
      "timeout": "30s"
    },
    "knirvgraph": {
      "endpoint": "http://localhost:8081",
      "timeout": "30s"
    },
    "knirvnexus": {
      "endpoints": [
        "http://localhost:8082",
        "http://localhost:8083"
      ],
      "load_balancer": "round_robin",
      "timeout": "60s"
    },
    "knirvrouter": {
      "endpoint": "http://localhost:8086",
      "timeout": "30s"
    }
  },
  "authentication": {
    "enabled": true,
    "jwt_secret": "testnet-secret-key",
    "token_expiry": "24h"
  },
  "rate_limiting": {
    "enabled": true,
    "requests_per_minute": 100
  },
  "monitoring": {
    "metrics_enabled": true,
    "health_checks": true,
    "prometheus_endpoint": "/metrics"
  }
}
