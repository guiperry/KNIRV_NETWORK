# KNIRVGATEWAY Podman Containerfile
# Equivalent to Dockerfile with Podman-specific optimizations
FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS builder

# Switch to root for package installation
USER root

# Install build dependencies
RUN dnf install -y python3 make gcc-c++ git curl && \
    dnf clean all

# Switch back to default user
USER 1001

# Set working directory
WORKDIR /app

# Copy package files
COPY --chown=1001:1001 package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source code
COPY --chown=1001:1001 . .

# Load endpoints and build
RUN npm run load-endpoints && \
    npm run check-function-deps && \
    echo 'KNIRV Gateway built with Netlify Functions support'

# Production stage
FROM registry.access.redhat.com/ubi9/nodejs-20-minimal:latest AS production

# Switch to root for package installation
USER root

# Install runtime dependencies
RUN microdnf install -y nginx curl && \
    microdnf clean all

# Create application user
RUN useradd -r -u 1001 -g 0 knirvgateway

# Set working directory
WORKDIR /app

# Copy package files and install production dependencies
COPY --chown=1001:0 package*.json ./
RUN npm ci --only=production --legacy-peer-deps && \
    npm cache clean --force

# Copy built application from builder stage
COPY --from=builder --chown=1001:0 /app .

# Create necessary directories
RUN mkdir -p /app/logs /app/data && \
    chown -R 1001:0 /app && \
    chmod -R g+rwX /app

# Configure nginx for static file serving
COPY --chown=1001:0 <<EOF /etc/nginx/nginx.conf
events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    
    server {
        listen 8080;
        server_name localhost;
        root /app;
        index index.html;
        
        location / {
            try_files \$uri \$uri/ /index.html;
        }
        
        location /api/ {
            proxy_pass http://localhost:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade \$http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host \$host;
            proxy_cache_bypass \$http_upgrade;
        }
        
        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }
    }
}
EOF

# Switch to non-root user
USER 1001

# Expose ports
EXPOSE 8080 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Volume for persistent data
VOLUME ["/app/data", "/app/logs"]

# Start script
COPY --chown=1001:0 <<EOF /app/start.sh
#!/bin/bash
# Start nginx in background
nginx &

# Start Node.js application
npm start
EOF

RUN chmod +x /app/start.sh

# Start command
CMD ["/app/start.sh"]
