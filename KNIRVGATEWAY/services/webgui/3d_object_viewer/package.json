{
  "name": "viewport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:server": "ts-node --project tsconfig.server.json server/index.ts",
    "dev": "concurrently \"npm:dev:next\" \"npm:dev:server\"",
    "build:server": "tsc --project tsconfig.server.json",
    "build:next": "next build",
    "build": "npm run build:next && npm run build:server",
    "start:server": "node dist/server/index.js",
    "start:next": "next start",
    "start": "concurrently \"npm:start:next\" \"npm:start:server\"",
    "lint": "next lint",
    "compile": "tsc --project tsconfig.json --noEmitOnError"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.5",
    "@react-three/fiber": "^9.1.0",
    "@types/express": "^5.0.1",
    "@types/three": "^0.175.0",
    "axios": "^1.8.4",
    "dotenv": "^16.4.7",
    "export": "^0.1.337",
    "express": "^5.1.0",
    "next": "^15.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.175.0",
    "three-stdlib": "^2.35.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.17.30",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
