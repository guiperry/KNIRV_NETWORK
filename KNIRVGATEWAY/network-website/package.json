{
  "name": "knirv-com-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm install && tsc --noEmit",
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "type-check": "tsc --noEmit",
    "docs:serve": "cd public/documentation && npm run serve",
    "docs:start": "cd public/documentation && npm start",
    "docs:generate-static": "cd public/documentation && npm install && cd ../.. && node scripts/simple-static-generator.js && node scripts/update-docsify-links.js",
    "docs:test-static": "node scripts/test-static-generation.js"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.22.4",
    "glob": "^10.3.10"
  }
}