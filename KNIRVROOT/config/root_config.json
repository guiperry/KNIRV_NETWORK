{
  "IsRoot": true,
  "installComplete": true,
  "httpPort": 9999,
  "p2pPort": 19999,
  "walletPort": 0,
  "noWalletServer": true,
  "chainID": "agent-root-9999",
  "sharedDatabasePath": "root_data/agent_root.db",
  "minersAddress": "YOUR_CREATOR_WALLET_ADDRESS_HERE",
  "masterAddress": "YOUR_CREATOR_WALLET_ADDRESS_HERE",
  "paymentProcessor": {
    "enabled": true,
    "nodeRPC": "http://localhost:9999"
  },
  "useGUI": false,
  "data_engine": {
    "enabled": true,
    "kafka_brokers": ["localhost:9092"],
    "kafka_client_id": "KNIRVROOT-root",
    "chromadb_url": "http://localhost:8000",
    "chroma_collection": "KNIRVROOT-events",
    "enable_kafka": false,
    "enable_chromadb": false,
    "enable_websocket": true,
    "enable_restapi": true,
    "websocket_port": 8080,
    "restapi_port": 7080,
    "window_size": "5m",
    "metrics_interval": "10s"
  }
}
