// Compatibility layer for capability invocation
router.HandleFunc("/mcp/capability/invoke", func(w http.ResponseWriter, r *http.Request) {
    // Parse request
    var request struct {
        CapabilityID string                 `json:"capability_id"`
        Input        map[string]interface{} `json:"input"`
    }
    
    if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
        http.Error(w, "Invalid request: "+err.Error(), http.StatusBadRequest)
        return
    }
    
    // Look up Agent and capability from original capability ID
    agentID, capabilityID, err := getAgentAndCapabilityFromOriginalID(request.CapabilityID)
    if err != nil {
        // If not found, try using the ID directly (might be a new capability ID)
        capabilityID = request.CapabilityID
        // Find an Agent that has this capability
        agentID, err = findAgentWithCapability(capabilityID)
        if err != nil {
            http.Error(w, "Capability not found: "+err.Error(), http.StatusNotFound)
            return
        }
    }
    
    // Get the Agent with this capability
    agent, err := agentManager.GetAgent(agentID)
    if err != nil {
        http.Error(w, "Agent not found: "+err.Error(), http.StatusNotFound)
        return
    }
    
    // Verify the capability exists on this Agent
    var targetCapability *Capability
    for _, cap := range agent.Capabilities {
        if cap.ID == capabilityID {
            targetCapability = &cap
            break
        }
    }
    
    if targetCapability == nil {
        http.Error(w, "Capability not found on Agent", http.StatusNotFound)
        return
    }
    
    // Invoke the Agent capability
    contextRecord, err := mcpProcessor.InvokeAgentCapability(agentID, capabilityID, request.Input, nil)
    if err != nil {
        http.Error(w, "Failed to invoke capability: "+err.Error(), http.StatusInternalServerError)
        return
    }
    
    // Return the result
    w.Header().Set("Content-Type", "application/json")
    json.NewEncoder(w).Encode(map[string]interface{}{
        "context_record_id": contextRecord.ID,
        "status":            contextRecord.Status,
        "details":           contextRecord.Details,
    })
})
