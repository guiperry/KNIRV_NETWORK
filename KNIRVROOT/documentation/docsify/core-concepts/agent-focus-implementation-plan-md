#### 2.2 Capability Invocation Update

Update the capability invocation process to work with Badge-based capabilities:

```go
// InvokeCapabilityBadge invokes a capability Badge attached to an NFT
func (mcp *MCPProcessor) InvokeCapabilityBadge(nftId string, badgeId string, input map[string]interface{}) (*ContextRecord, error) {
    // Get the NFT
    nft, err := mcp.nftManager.GetNFT(nftId)
    if err != nil {
        return nil, fmt.Errorf("NFT not found: %v", err)
    }
    
    // Get the Badge
    badge, err := mcp.nftManager.GetBadge(badgeId)
    if err != nil {
        return nil, fmt.Errorf("Badge not found: %v", err)
    }
    
    // Check if the Badge is a capability
    if badge.BadgeType != "capability" {
        return nil, fmt.Errorf("Badge is not a capability")
    }
    
    // Check if the Badge is attached to the NFT
    attachment, err := mcp.nftManager.GetBadgeAttachment(nftId, badgeId)
    if err != nil || attachment == nil || attachment.Status != "active" {
        return nil, fmt.Errorf("Capability Badge is not attached to this NFT")
    }
    
    // Check access control for both NFT and Badge
    if !mcp.nftManager.HasAccess(nft.ID, mcp.wallet.GetAddress(), []string{"execute"}) {
        return nil, fmt.Errorf("No permission to execute capabilities on this NFT")
    }
    
    if !mcp.nftManager.HasAccess(badge.ID, mcp.wallet.GetAddress(), []string{"execute"}) {
        return nil, fmt.Errorf("No permission to execute this capability Badge")
    }
    
    // Extract capability metadata
    capabilityType := badge.Metadata["capability_type"].(string)
    schema := badge.Metadata["schema"].(map[string]interface{})
    locationHints := badge.Metadata["location_hints"].([]string)
    gasFeeNRN := badge.Metadata["gas_fee_nrn"].(float64)
    
    // Merge with attachment parameters
    mergedInput := input
    if attachment.Parameters != nil {
        // Apply attachment-specific parameters to the input
        for k, v := range attachment.Parameters {
            if _, exists := mergedInput[k]; !exists {
                mergedInput[k] = v
            }
        }
    }
    
    // Create a context record
    contextRecord := &ContextRecord{
        ID:              generateUniqueID(),
        NFTId:           nft.ID,
        BadgeId:         badge.ID,
        AttachmentId:    attachment.ID,
        InteractionType: "CAPABILITY_EXECUTION",
        Initiator:       mcp.wallet.GetAddress(),
        Timestamp:       time.Now(),
        InputHash:       hashInput(mergedInput),
        Details:         map[string]interface{}{
            "capability_type":   capabilityType,
            "execution_context": "client",
            "nft_entity_type":   nft.EntityType,
        },
    }
    
    // Execute the capability (implementation depends on capability type)
    output, err := mcp.executeCapability(capabilityType, schema, locationHints, mergedInput)
    if err != nil {
        contextRecord.Status = "failed"
        contextRecord.Details["error"] = err.Error()
        mcp.storeContextRecord(contextRecord)
        return contextRecord, err
    }
    
    // Update the context record with output
    contextRecord.OutputHash = hashOutput(output)
    contextRecord.Status = "completed"
    contextRecord.Details["output_summary"] = summarizeOutput(output)
    
    // Store the context record
    mcp.storeContextRecord(contextRecord)
    
    // Process the NRN fee
    mcp.processNRNFee(badge.Owner, gasFeeNRN)
    
    return contextRecord, nil
}

// InvokeCapabilityBadgeByNFT invokes a capability Badge attached to an NFT by just providing the NFT ID
// This is useful when the NFT has only one capability Badge of a specific type
func (mcp *MCPProcessor) InvokeCapabilityBadgeByNFT(nftId string, capabilityType string, input map[string]interface{}) (*ContextRecord, error) {
    // Get all Badge attachments for the NFT
    attachments, err := mcp.nftManager.GetBadgeAttachments(nftId)
    if err != nil {
        return nil, fmt.Errorf("Failed to get Badge attachments: %v", err)
    }
    
    // Find the first active capability Badge of the specified type
    for _, attachment := range attachments {
        badge, err := mcp.nftManager.GetBadge(attachment.BadgeId)
        if err != nil {
            continue
        }
        
        if badge.BadgeType == "capability" && 
           badge.Metadata["capability_type"] == capabilityType && 
           attachment.Status == "active" {
            // Found a matching capability Badge, invoke it
            return mcp.InvokeCapabilityBadge(nftId, badge.ID, input)
        }
    }
    
    return nil, fmt.Errorf("No active capability Badge of type '%s' found on this NFT", capabilityType)
}
