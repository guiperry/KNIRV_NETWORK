func main() {
    // Define command-line flags
    portFlag := flag.Int("port", 8080, "Port to listen on")
    pluginDirFlag := flag.String("plugins", "./plugins", "Directory containing Agent plugins")
    serverNameFlag := flag.String("name", "KNIRVROOT Plugin Server", "Name of this server instance")
    registerFlag := flag.Bool("register", false, "Register this server with the KNIRVROOT system")
    apiUrlFlag := flag.String("api", "http://localhost:3000", "URL of the KNIRVROOT API")
    
    // Parse command-line flags
    flag.Parse()
    
    // Ensure plugin directory exists
    if err := os.MkdirAll(*pluginDirFlag, 0755); err != nil {
        log.Fatalf("Error creating plugin directory: %v", err)
    }
    
    // Register the server if requested
    if *registerFlag {
        fmt.Printf("Registering server %s with API at %s...\n", *serverNameFlag, *apiUrlFlag)
        
        // Call the API to register the server
        // This is a placeholder for the actual API call
        fmt.Printf("Server registered successfully\n")
    }
    
    // Set up HTTP handlers
    
    // Handler for serving plugin files
    http.HandleFunc("/plugins/", func(w http.ResponseWriter, r *http.Request) {
        // Extract the plugin name from the URL
        pluginName := strings.TrimPrefix(r.URL.Path, "/plugins/")
        if pluginName == "" {
            http.Error(w, "Plugin name is required", http.StatusBadRequest)
            return
        }
        
        // Construct the full path to the plugin file
        pluginPath := filepath.Join(*pluginDirFlag, pluginName)
        
        // Check if the file exists
        if _, err := os.Stat(pluginPath); os.IsNotExist(err) {
            http.Error(w, "Plugin not found", http.StatusNotFound)
            return
        }
        
        // Open the plugin file
        file, err := os.Open(pluginPath)
        if err != nil {
            http.Error(w, fmt.Sprintf("Error opening plugin file: %v", err), http.StatusInternalServerError)
            return
        }
        defer file.Close()
        
        // Set the content type
        w.Header().Set("Content-Type", "application/octet-stream")
        
        // Copy the file to the response
        if _, err := io.Copy(w, file); err != nil {
            http.Error(w, fmt.Sprintf("Error serving plugin file: %v", err), http.StatusInternalServerError)
            return
        }
        
        // Log the download
        log.Printf("Served plugin %s to %s", pluginName, r.RemoteAddr)
    })
    
    // Handler for uploading plugin files
    http.HandleFunc("/upload", func(w http.ResponseWriter, r *http.Request) {
        if r.Method != http.MethodPost {
            http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
            return
        }
        
        // Parse the multipart form
        if err := r.ParseMultipartForm(100 << 20); err != nil { // 100 MB max
            http.Error(w, fmt.Sprintf("Error parsing form: %v", err), http.StatusBadRequest)
            return
        }
        
        // Get the file from the form
        file, header, err := r.FormFile("plugin")
        if err != nil {
            http.Error(w, fmt.Sprintf("Error getting file: %v", err), http.StatusBadRequest)
            return
        }
        defer file.Close()
        
        // Create the destination file
        dst, err := os.Create(filepath.Join(*pluginDirFlag, header.Filename))
        if err != nil {
            http.Error(w, fmt.Sprintf("Error creating file: %v", err), http.StatusInternalServerError)
            return
        }
        defer dst.Close()
        
        // Copy the uploaded file to the destination file
        if _, err := io.Copy(dst, file); err != nil {
            http.Error(w, fmt.Sprintf("Error saving file: %v", err), http.StatusInternalServerError)
            return
        }
        
        // Return success response
        w.Header().Set("Content-Type", "application/json")
        fmt.Fprintf(w, `{"success": true, "filename": "%s"}`, header.Filename)
        
        // Log the upload
        log.Printf("Uploaded plugin %s from %s", header.Filename, r.RemoteAddr)
    })
    
    // Handler for listing available plugins
    http.HandleFunc("/list", func(w http.ResponseWriter, r *http.Request) {
        // Get all files in the plugin directory
        files, err := os.ReadDir(*pluginDirFlag)
        if err != nil {
            http.Error(w, fmt.Sprintf("Error reading plugin directory: %v", err), http.StatusInternalServerError)
            return
        }
        
        // Build the response
        var plugins []string
        for _, file := range files {
            if !file.IsDir() && strings.HasSuffix(file.Name(), ".so") {
                plugins = append(plugins, file.Name())
            }
        }
        
        // Return the list of plugins
        w.Header().Set("Content-Type", "application/json")
        fmt.Fprintf(w, `{"plugins": ["%s"]}`, strings.Join(plugins, `", "`))
    })
    
    // Start the server
    addr := fmt.Sprintf(":%d", *portFlag)
    fmt.Printf("Starting KNIRVROOT Plugin Server on %s...\n", addr)
    log.Fatal(http.ListenAndServe(addr, nil))
}
