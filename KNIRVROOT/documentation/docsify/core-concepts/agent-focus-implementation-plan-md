// Migration function to convert existing capabilities to Agent capabilities
func migrateCapabilitiesToAgentCapabilities(agentManager *AgentManager) error {
    // Get all existing capabilities
    capabilities, err := mcpProcessor.getAllCapabilities()
    if err != nil {
        return fmt.Errorf("Failed to get capabilities: %v", err)
    }
    
    // Convert each capability to an Agent capability
    for _, capability := range capabilities {
        // Create a new capability for the Agent
        newCapability := Capability{
            ID:             generateUniqueID(),
            Name:           capability.Name,
            Description:    capability.Description,
            CapabilityType: capability.CapabilityType,
            MCPServerURL:   capability.ServerURL,
            Schema:         capability.Schema,
            LocationHints:  capability.LocationHints,
            Metadata: map[string]interface{}{
                "gas_fee_nrn": capability.GasFeeNRN,
                "original_id": capability.ID, // Store original ID for reference
            },
            CreatedAt:      time.Now(),
            Status:         "active",
        }
        
        // Find or create an Agent for this capability
        agentType := determineAgentTypeForCapability(capability.CapabilityType)
        agent, err := findOrCreateAgentForCapability(
            agentManager,
            capability.Owner,
            capability.Name + " Agent",
            "Agent for " + capability.Description,
            agentType,
        )
        
        if err != nil {
            fmt.Printf("Warning: Failed to find or create Agent for capability %s: %v\n", capability.ID, err)
            continue
        }
        
        // Add the capability to the Agent
        err = agentManager.AddCapabilityToAgent(
            agent.ID,
            newCapability.Name,
            newCapability.Description,
            newCapability.CapabilityType,
            newCapability.MCPServerURL,
            newCapability.Schema,
            newCapability.LocationHints,
            newCapability.Metadata,
        )
        
        if err != nil {
            fmt.Printf("Warning: Failed to add capability %s to Agent %s: %v\n", capability.ID, agent.ID, err)
            continue
        }
        
        fmt.Printf("Migrated capability %s to Agent %s\n", capability.ID, agent.ID)
        
        // Store mapping for reference
        storeCapabilityToAgentMapping(capability.ID, agent.ID)
    }
    
    return nil
}

// Migration function to create Agents and configure capabilities
func createAgentsAndConfigureCapabilities(agentManager *AgentManager) error {
    // Get all existing workflows (which will become Agents)
    workflows, err := mcpProcessor.getAllWorkflows()
    if err != nil {
        return fmt.Errorf("Failed to get workflows: %v", err)
    }
    
    // Convert each workflow to an Agent
    for _, workflow := range workflows {
        // Create metadata for the Agent
        metadata := map[string]interface{}{
            "workflow_type": workflow.WorkflowType,
            "original_id":   workflow.ID,
            "version":       workflow.Version,
        }
        
        // Generate or use existing image URL
        imageURL := workflow.ImageURL
        if imageURL == "" {
            imageURL = generateDefaultAgentImage(string(workflow.WorkflowType))
        }
        
        // Create the Agent
        agent, err := agentManager.CreateAgent(
            workflow.Name,
            workflow.Description,
            imageURL,
            workflow.Owner,
            "workflow",
            metadata,
        )
        
        if err != nil {
            fmt.Printf("Warning: Failed to migrate workflow %s: %v\n", workflow.ID, err)
