// Enhanced BadgeAttachment with immutability guarantees
type BadgeAttachment struct {
    ID            string                 `json:"id"`
    AgentId       string                 `json:"agent_id"`
    BadgeId       string                 `json:"badge_id"`
    AttachedAt    time.Time              `json:"attached_at"`
    AttachedBy    string                 `json:"attached_by"`
    Parameters    map[string]interface{} `json:"parameters,omitempty"` // Configuration parameters for this attachment
    Status        string                 `json:"status"`               // "active", "inactive", "detached"
    Signature     string                 `json:"signature"`            // Cryptographic signature ensuring immutability
    TxHash        string                 `json:"tx_hash"`              // Blockchain transaction hash for verification
}

// AttachBadgeToAgent attaches a Badge to an Agent (immutable relationship)
func (am *AgentManager) AttachBadgeToAgent(badgeId, agentId string, parameters map[string]interface{}) (*BadgeAttachment, error) {
    // Verify the Agent and Badge exist
    agent, err := am.GetAgent(agentId)
    if err != nil {
        return nil, fmt.Errorf("agent not found: %v", err)
    }
    
    badge, err := am.GetBadge(badgeId)
    if err != nil {
        return nil, fmt.Errorf("badge not found: %v", err)
    }
    
    // Create attachment data
    attachment := &BadgeAttachment{
        ID:         generateUniqueID(),
        AgentId:    agentId,
        BadgeId:    badgeId,
        AttachedAt: time.Now(),
        AttachedBy: am.wallet.GetAddress(),
        Parameters: parameters,
        Status:     "active",
    }
    
    // Generate cryptographic signature to ensure immutability
    attachmentData, err := json.Marshal(map[string]interface{}{
        "agent_id":    agentId,
        "badge_id":    badgeId,
        "attached_at": attachment.AttachedAt,
        "attached_by": attachment.AttachedBy,
        "parameters":  parameters,
    })
    if err != nil {
        return nil, fmt.Errorf("failed to marshal attachment data: %v", err)
    }
    
    // Sign the attachment data
    signature, err := am.wallet.Sign(attachmentData)
    if err != nil {
        return nil, fmt.Errorf("failed to sign attachment: %v", err)
    }
    attachment.Signature = hex.EncodeToString(signature)
    
    // Record on blockchain for immutability
    txHash, err := am.blockchain.RecordBadgeAttachment(attachment)
    if err != nil {
        return nil, fmt.Errorf("failed to record attachment on blockchain: %v", err)
    }
    attachment.TxHash = txHash
    
    // Store in database
    err = am.chromeDB.Insert(BadgeAttachmentCollection, attachment)
    if err != nil {
        return nil, fmt.Errorf("failed to store attachment: %v", err)
    }
    
    // Update Agent to reference this Badge
    agent.AttachedBadges = append(agent.AttachedBadges, badgeId)
    err = am.chromeDB.Update(AgentCollection, agent.ID, agent)
    if err != nil {
        return nil, fmt.Errorf("failed to update agent: %v", err)
    }
    
    // Update Badge to reference this Agent
    badge.AttachedToAgents = append(badge.AttachedToAgents, agentId)
    err = am.chromeDB.Update(BadgeCollection, badge.ID, badge)
    if err != nil {
        return nil, fmt.Errorf("failed to update badge: %v", err)
    }
    
    return attachment, nil
}
