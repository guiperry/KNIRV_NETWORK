// RemoveCapabilityFromAgent removes a capability from an Agent
func (am *AgentManager) RemoveCapabilityFromAgent(agentId, capabilityId string) error {
    // Verify the Agent exists
    agent, err := am.GetAgent(agentId)
    if err != nil {
        return fmt.Errorf("agent not found: %v", err)
    }
    
    // Find and remove the capability
    var updatedCapabilities []Capability
    var removedCapability *Capability
    
    for _, cap := range agent.Capabilities {
        if cap.ID != capabilityId {
            updatedCapabilities = append(updatedCapabilities, cap)
        } else {
            removedCapability = &cap
        }
    }
    
    if removedCapability == nil {
        return fmt.Errorf("capability not found in agent")
    }
    
    // Update the agent
    agent.Capabilities = updatedCapabilities
    err = am.chromeDB.Update(AgentCollection, agent.ID, agent)
    if err != nil {
        return fmt.Errorf("failed to update agent: %v", err)
    }
    
    // Create revision
    revision := &Revision{
        ID:         generateUniqueID(),
        AgentId:    agent.ID,
        Timestamp:  time.Now(),
        ChangedBy:  am.wallet.GetAddress(),
        ChangeType: "remove_capability",
        Details: map[string]interface{}{
            "capability_id":   capabilityId,
            "capability_type": removedCapability.CapabilityType,
        },
    }
    
    err = am.chromeDB.Insert(RevisionCollection, revision)
    if err != nil {
        log.Printf("Failed to store revision: %v", err)
    }
    
    return nil
}

// CreateAgentRelationship creates a mutable relationship between two Agents
func (am *AgentManager) CreateAgentRelationship(sourceAgentId, targetAgentId, relationType string, metadata map[string]interface{}, parameters map[string]interface{}) (*AgentRelationship, error) {
    // Verify both Agents exist
    sourceAgent, err := am.GetAgent(sourceAgentId)
