        Status:        "active",
        Parameters:    parameters,
    }
    
    // Store in database
    err = am.chromeDB.Insert(AgentRelationshipCollection, relationship)
    if err != nil {
        return nil, fmt.Errorf("failed to store relationship: %v", err)
    }
    
    // Update both Agents to reference this relationship
    sourceAgent.ChildAgents = append(sourceAgent.ChildAgents, targetAgentId)
    targetAgent.ParentAgents = append(targetAgent.ParentAgents, sourceAgentId)
    
    err = am.chromeDB.Update(AgentCollection, sourceAgent.ID, sourceAgent)
    if err != nil {
        return nil, fmt.Errorf("failed to update source agent: %v", err)
