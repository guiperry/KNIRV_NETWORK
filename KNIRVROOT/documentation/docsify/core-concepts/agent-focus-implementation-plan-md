// RegisterAgentPlugin registers a compiled Go plugin for an Agent
func (am *AgentManager) RegisterAgentPlugin(agentId, filePath, version string, compiledBy string) (*AgentPlugin, error) {
    // Verify the Agent exists
    agent, err := am.GetAgent(agentId)
    if err != nil {
        return nil, fmt.Errorf("agent not found: %v", err)
    }
    
    // Verify the plugin file exists and is valid
    if _, err := os.Stat(filePath); os.IsNotExist(err) {
        return nil, fmt.Errorf("plugin file does not exist: %v", err)
    }
    
    // Calculate hash of the plugin file
    pluginData, err := ioutil.ReadFile(filePath)
    if err != nil {
        return nil, fmt.Errorf("failed to read plugin file: %v", err)
    }
    
    hash := fmt.Sprintf("%x", sha256.Sum256(pluginData))
    
    // Create plugin record
    plugin := &AgentPlugin{
        ID:          generateUniqueID(),
        AgentId:     agentId,
        FilePath:    filePath,
        Hash:        hash,
        Version:     version,
        CompileTime: time.Now(),
        CompiledBy:  compiledBy,
        ServerURLs:  []string{},
        Status:      "active",
    }
    
    // Store plugin information in the database
    err = am.chromeDB.Insert(AgentPluginCollection, plugin)
    if err != nil {
        return nil, fmt.Errorf("failed to store plugin: %v", err)
    }
    
    // Update Agent with plugin path
    agent.PluginPath = filePath
    err = am.chromeDB.Update(AgentCollection, agent.ID, agent)
    if err != nil {
        return nil, fmt.Errorf("failed to update agent: %v", err)
    }
    
    // Create revision
    revision := &Revision{
        ID:         generateUniqueID(),
        AgentId:    agent.ID,
        Timestamp:  time.Now(),
        ChangedBy:  am.wallet.GetAddress(),
        ChangeType: "register_plugin",
        Details: map[string]interface{}{
            "plugin_id": plugin.ID,
            "version":   version,
        },
    }
    
    err = am.chromeDB.Insert(RevisionCollection, revision)
    if err != nil {
        log.Printf("Failed to store revision: %v", err)
    }
    
    return plugin, nil
}

// AddCapabilityToAgent adds a capability directly to an Agent
func (am *AgentManager) AddCapabilityToAgent(agentId, name, description, capabilityType, mcpServerURL string, schema map[string]interface{}, locationHints []string, metadata map[string]interface{}) (*Capability, error) {
    // Verify the Agent exists
