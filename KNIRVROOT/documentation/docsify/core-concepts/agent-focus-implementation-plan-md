        }
        
        fmt.Printf("Migrated workflow %s to Agent %s\n", workflow.ID, agent.ID)
        
        // Store mapping for reference
        storeWorkflowToAgentMapping(workflow.ID, agent.ID)
        
        // Get capabilities used by this workflow
        workflowCapabilities, err := mcpProcessor.getWorkflowCapabilities(workflow.ID)
        if err != nil {
            fmt.Printf("Warning: Failed to get capabilities for workflow %s: %v\n", workflow.ID, err)
            continue
        }
        
        // Add each capability to the new Agent
        for _, capability := range workflowCapabilities {
            // Get the capability details from the original capability ID
            capabilityDetails, err := getCapabilityDetailsFromOriginalID(capability.ID)
            if err != nil {
                fmt.Printf("Warning: Failed to find capability details for %s: %v\n", capability.ID, err)
                continue
            }
            
            // Add the capability to the Agent
            err = agentManager.AddCapabilityToAgent(
                agent.ID,
                capabilityDetails.Name,
                capabilityDetails.Description,
                capabilityDetails.CapabilityType,
                capabilityDetails.MCPServerURL,
                capabilityDetails.Schema,
                capabilityDetails.LocationHints,
                capability.Parameters, // Use original parameters
            )
            if err != nil {
                fmt.Printf("Warning: Failed to add capability %s to Agent %s: %v\n", capability.ID, agent.ID, err)
                continue
            }
            
            fmt.Printf("Added capability %s to Agent %s\n", capability.ID, agent.ID)
        }
    }
    
    return nil
}
```

