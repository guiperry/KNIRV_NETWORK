// Add to imports
import (
    "github.com/your_org/KNIRVROOT/internal/realmdb"
)

// Add to BlockchainStruct
type BlockchainStruct struct {
    // Existing fields...
    RealmSync *realmdb.RealmSyncManager // Add RealmDB Sync Manager
}

// Modify NewBlockchain to initialize RealmSyncManager
func NewBlockchain(dbPath string, chainID string, minerAddress string) (*BlockchainStruct, error) {
    // Existing initialization...
    
    // Initialize RealmSyncManager
    realmConfig := &realmdb.Config{
        Path: dbPath + "/realmdb",
    }
    realmSync, err := realmdb.NewRealmSyncManager(realmConfig)
    if err != nil {
        return nil, fmt.Errorf("failed to initialize RealmSyncManager: %w", err)
    }
    
    return &BlockchainStruct{
        // Existing fields...
        RealmSync: realmSync,
    }, nil
}

// Modify AddBlock to notify RealmSyncManager
func (bc *BlockchainStruct) AddBlock(block *Block) error {
    // Existing block validation and addition to LevelDB...
    
    // Notify RealmSyncManager about the new confirmed block
    if bc.RealmSync != nil {
        go bc.RealmSync.OnNewBlockConfirmed(block) // Run in a goroutine to avoid blocking
    }
    
    return nil
}

// Add HandleChainReorganization to handle chain reorganizations
func (bc *BlockchainStruct) HandleChainReorganization(orphanedBlocks []*Block, newCanonicalBlocks []*Block) error {
    // Existing chain reorganization logic...
    
    // Notify RealmSyncManager about orphaned blocks
    if bc.RealmSync != nil {
        for _, block := range orphanedBlocks {
            go bc.RealmSync.OnBlockOrphaned(block)
        }
        
        // Notify RealmSyncManager about new canonical blocks
        for _, block := range newCanonicalBlocks {
            go bc.RealmSync.OnNewBlockConfirmed(block)
        }
    }
    
    return nil
}
