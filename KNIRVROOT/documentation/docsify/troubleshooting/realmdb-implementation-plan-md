### 5.4 RealmDB Search Implementation

Implement the search functionality in the RealmDB manager:

```go
// File: internal/realmdb/search.go

package realmdb

import (
    "fmt"
    "strings"
    "time"

    realm "github.com/realm/realm-go"
)

// SearchTransactions searches for transactions based on the provided criteria
func (m *Manager) SearchTransactions(req SearchTransactionsRequest) ([]Transaction, int, error) {
    m.mu.RLock()
    defer m.mu.RUnlock()
    
    // Build the query
    query := ""
    args := []interface{}{}
    
    // Add filters
    filters := []string{}
    
    if req.Type != "" {
        filters = append(filters, "type == $0")
        args = append(args, req.Type)
    }
    
    if req.FromAddr != "" {
        filters = append(filters, "from == $" + strconv.Itoa(len(args)))
        args = append(args, req.FromAddr)
    }
    
    if req.ToAddr != "" {
        filters = append(filters, "to == $" + strconv.Itoa(len(args)))
        args = append(args, req.ToAddr)
    }
    
    if !req.StartTime.IsZero() {
        filters = append(filters, "timestamp >= $" + strconv.Itoa(len(args)))
        args = append(args, req.StartTime.Unix())
    }
    
    if !req.EndTime.IsZero() {
        filters = append(filters, "timestamp <= $" + strconv.Itoa(len(args)))
        args = append(args, req.EndTime.Unix())
    }
    
    if req.DataQuery != "" {
        filters = append(filters, "dataJSON CONTAINS[c] $" + strconv.Itoa(len(args)))
        args = append(args, req.DataQuery)
    }
    
    // Combine filters
    if len(filters) > 0 {
        query = strings.Join(filters, " AND ")
    }
    
    // Execute the query
    var txRealms []TransactionRealm
    var err error
    
    if query == "" {
        // No filters, get all transactions
        txRealms = m.db.Objects(TransactionRealm{})
    } else {
        // Apply filters
        txRealms = m.db.Objects(TransactionRealm{}, query, args...)
    }
    
    // Get total count
    totalCount := len(txRealms)
    
    // Apply pagination
    start := (req.Page - 1) * req.PageSize
    end := start + req.PageSize
    if start >= totalCount {
        return []Transaction{}, totalCount, nil
    }
    if end > totalCount {
        end = totalCount
    }
    txRealms = txRealms[start:end]
    
    // Convert RealmDB objects to Transaction objects
    transactions := make([]Transaction, len(txRealms))
    for i, txRealm := range txRealms {
        // Convert RealmDB transaction to Transaction
        tx := Transaction{
            TransactionHash: txRealm.TransactionHash,
            BlockHash:       txRealm.BlockHash,
            BlockNumber:     txRealm.BlockNumber,
            From:            txRealm.From,
            To:              txRealm.To,
            Value:           txRealm.Value,
            Type:            TransactionType(txRealm.Type),
            Timestamp:       txRealm.Timestamp,
            Fee:             txRealm.Fee,
        }
        
        // Parse data JSON if available
        if txRealm.DataJSON != "" {
            var data interface{}
            if err := json.Unmarshal([]byte(txRealm.DataJSON), &data); err == nil {
                tx.Data = data
            }
        }
        
        transactions[i] = tx
    }
    
    return transactions, totalCount, nil
}
```

