## 5. Implementation Plan

### 5.1 RealmDB Integration

#### 5.1.1 RealmDB Manager

Create a RealmDB manager to handle database operations:

```go
// File: internal/realmdb/manager.go

package realmdb

import (
    "context"
    "log"
    "sync"
    "time"

    "go.mongodb.org/mongo-driver/bson/primitive"
    realm "github.com/realm/realm-go"
)

// Manager handles RealmDB operations
type RealmManager struct {
    db          *realm.Realm
    config      *Config
    initialized bool
    mu          sync.RWMutex
}

// RealmConfig contains RealmDB configuration
type RealmConfig struct {
    Path            string
    SyncWithLevelDB bool
    SyncInterval    time.Duration
}

// NewManager creates a new RealmDB manager
func NewRealmManager(config *Config) (*Manager, error) {
    // Initialize RealmDB
    config := realm.Config{
        Path: config.Path,
        Schema: []interface{}{
            TransactionRealm{},
            ContextRecordRealm{},
            CapabilityDescriptorRealm{},
        },
    }
    
    db, err := realm.Open(config)
    if err != nil {
        return nil, err
    }
    
    return &RealmManager{
        db:     db,
        config: config,
    }, nil
}

// Close closes the RealmDB connection
func (m *RealmManager) Close() error {
    m.mu.Lock()
    defer m.mu.Unlock()
    
    if m.db != nil {
        m.db.Close()
        m.db = nil
    }
    
    return nil
}

// RealmTransaction indexes a transaction in RealmDB
func (m *RealmManager) RealmTransaction(tx *Transaction) error {
    m.mu.Lock()
    defer m.mu.Unlock()
    
    // Create RealmDB transaction
    txRealm := &TransactionRealm{
        RealmID:         primitive.NewObjectID(),
        TransactionHash: tx.TransactionHash,
        BlockHash:       tx.BlockHash,
        BlockNumber:     tx.BlockNumber,
        From:            tx.From,
        To:              tx.To,
        Value:           tx.Value,
        Type:            string(tx.Type),
        Timestamp:       tx.Timestamp,
        Fee:             tx.Fee,
        Status:          "confirmed", // Assuming it's confirmed if we're indexing it
        CreatedAt:       time.Now(),
    }
    
    // Extract and index Transaction.Data based on type
    if tx.Data != nil {
        // Determine data type based on transaction type
        switch tx.Type {
        case TransactionTypeMCPRegisterCapability:
            txRealm.DataType = "MCPRegisterCapabilityData"
        case TransactionTypeMCPInvokeCapability:
            txRealm.DataType = "MCPInvokeCapabilityData"
        case TransactionTypeMCPUpdateCapability:
            txRealm.DataType = "MCPUpdateCapabilityData"
        }
        
        // Store JSON representation of data
        dataJSON, err := json.Marshal(tx.Data)
        if err == nil {
            txRealm.DataJSON = string(dataJSON)
        }
    }
    
    // Write to RealmDB
    err := m.db.Write(func(r *realm.Realm) error {
        r.Add(txRealm)
        return nil
    })
    
    return err
}

// Similar methods for ContextRecord and CapabilityDescriptor...
```

### 5.2 Event Listeners for Blockchain Synchronization

Implement event listeners to keep RealmDB synchronized with LevelDB. This is a critical component that ensures the RealmDB secondary index stays in sync with the blockchain's source of truth.

#### 5.2.1 RealmSyncManager Implementation

```go
// File: internal/realmdb/sync_manager.go

package realmdb

import (
    "context"
    "encoding/json"
    "fmt"
    "log"
    "sync"

    "go.mongodb.org/mongo-driver/bson/primitive"
    realm "github.com/realm/realm-go"

    bctypes "github.com/your_org/KNIRVROOT/internal/blockchain/structs"
    mcptypes "github.com/your_org/KNIRVROOT/internal/mcp/types"
)

// RealmSyncManager handles synchronization between LevelDB and RealmDB
type RealmSyncManager struct {
    db          *realm.Realm
    config      *Config
    initialized bool
    mu          sync.RWMutex
}

// NewRealmSyncManager creates a new RealmDB sync manager
func NewRealmSyncManager(config *Config) (*RealmSyncManager, error) {
    // Initialize RealmDB
    realmConfig := realm.Configuration{
        Path: config.Path,
        Schema: []interface{}{
            ContextRecordRealm{},
            CapabilityDescriptorRealm{},
            TransactionRealm{},
        },
    }
    
    db, err := realm.Open(realmConfig)
    if err != nil {
        return nil, fmt.Errorf("failed to open realm: %w", err)
    }
    
    return &RealmSyncManager{
        db:     db,
        config: config,
    }, nil
}

// Close closes the RealmDB connection
func (rsm *RealmSyncManager) Close() error {
    rsm.mu.Lock()
    defer rsm.mu.Unlock()
    
    if rsm.db != nil {
        rsm.db.Close()
        rsm.db = nil
    }
    
    return nil
}

// OnNewBlockConfirmed is called when a new block is added to the canonical chain
func (rsm *RealmSyncManager) OnNewBlockConfirmed(block *bctypes.Block) error {
    rsm.mu.Lock()
    defer rsm.mu.Unlock()
    
    // Process each transaction in the block
    for _, tx := range block.Transactions {
        switch tx.Type {
        case bctypes.TransactionTypeMCPInvokeCapability:
            // Extract and index context record
            var invokeData mcptypes.MCPInvokeCapabilityData
            if err := json.Unmarshal(tx.Data, &invokeData); err != nil {
                log.Printf("Error unmarshalling MCPInvokeCapabilityData for tx %s: %v", tx.TransactionHash, err)
                continue
            }
            
            // Convert to RealmDB object
            realmRecord := ToContextRecordRealm(&invokeData.ContextRecord, tx.TransactionHash, block.Header.Height, block.Header.Timestamp)
            
            // Write to RealmDB
            err := rsm.db.Write(func(r *realm.Realm) error {
                r.Add(realmRecord)
                return nil
            })
            
            if err != nil {
                log.Printf("Error writing ContextRecord to RealmDB: %v", err)
                continue
            }
            
            log.Printf("RealmDB: Added ContextRecord %s from tx %s", realmRecord.ID, tx.TransactionHash)
            
        case bctypes.TransactionTypeMCPRegisterCapability:
            // Extract and index capability descriptor
            var registerData mcptypes.MCPRegisterCapabilityData
            if err := json.Unmarshal(tx.Data, &registerData); err != nil {
                log.Printf("Error unmarshalling MCPRegisterCapabilityData for tx %s: %v", tx.TransactionHash, err)
                continue
            }
            
            // Convert to RealmDB object
            realmCap := ToCapabilityDescriptorRealmFromRegister(&registerData, tx.TransactionHash, block.Header.Height, block.Header.Timestamp)
            realmCap.IsLatest = true
            
            // Write to RealmDB
            err := rsm.db.Write(func(r *realm.Realm) error {
                r.Add(realmCap)
                return nil
            })
            
            if err != nil {
                log.Printf("Error writing CapabilityDescriptor to RealmDB: %v", err)
                continue
            }
            
            log.Printf("RealmDB: Added CapabilityDescriptor %s from tx %s", realmCap.ID, tx.TransactionHash)
            
        case bctypes.TransactionTypeMCPUpdateCapability:
            // Extract and index updated capability descriptor
            var updateData mcptypes.MCPUpdateCapabilityData
            if err := json.Unmarshal(tx.Data, &updateData); err != nil {
                log.Printf("Error unmarshalling MCPUpdateCapabilityData for tx %s: %v", tx.TransactionHash, err)
                continue
            }
            
            // Update existing capability descriptor
            err := rsm.db.Write(func(r *realm.Realm) error {
                // Find existing capability descriptor
                existingCaps := r.Objects(CapabilityDescriptorRealm{}, "id == $0 AND isLatest == true", updateData.CapabilityID)
                if len(existingCaps) > 0 {
                    // Mark existing capability as not latest
                    existingCap := existingCaps[0]
                    existingCap.IsLatest = false
                    r.Add(existingCap, true) // Update existing object
                }
                
                // Create new capability descriptor
                newCap := ToCapabilityDescriptorRealmFromUpdate(&updateData, tx.TransactionHash, block.Header.Height, block.Header.Timestamp)
                newCap.IsLatest = true
                r.Add(newCap)
                
                return nil
            })
            
            if err != nil {
                log.Printf("Error updating CapabilityDescriptor in RealmDB: %v", err)
                continue
            }
            
            log.Printf("RealmDB: Updated CapabilityDescriptor %s from tx %s", updateData.CapabilityID, tx.TransactionHash)
        }
        
        // Also index the transaction itself
        txRealm := ToTransactionRealm(tx, block.Header.Height, block.Header.Timestamp)
        err := rsm.db.Write(func(r *realm.Realm) error {
            r.Add(txRealm)
            return nil
        })
        
        if err != nil {
            log.Printf("Error writing Transaction to RealmDB: %v", err)
        }
    }
    
    return nil
}

// OnBlockOrphaned is called when a block is removed due to a chain reorganization
func (rsm *RealmSyncManager) OnBlockOrphaned(block *bctypes.Block) error {
    rsm.mu.Lock()
    defer rsm.mu.Unlock()
    
    // Delete all records associated with this block
    err := rsm.db.Write(func(r *realm.Realm) error {
        // Delete context records
        contextRecords := r.Objects(ContextRecordRealm{}, "blockHeight == $0", block.Header.Height)
        for _, record := range contextRecords {
            r.Delete(record)
        }
        log.Printf("RealmDB: Deleted %d ContextRecords from orphaned block %d", len(contextRecords), block.Header.Height)
        
        // Handle capability descriptors
        capabilityDescriptors := r.Objects(CapabilityDescriptorRealm{}, "blockHeight == $0", block.Header.Height)
        for _, descriptor := range capabilityDescriptors {
            // If this was an update (IsLatest = true), find the previous version and mark it as latest
            if descriptor.IsLatest {
                // Find previous version
                prevVersions := r.Objects(CapabilityDescriptorRealm{}, "id == $0 AND blockHeight < $1 ORDER BY blockHeight DESC LIMIT 1", descriptor.ID, block.Header.Height)
                if len(prevVersions) > 0 {
                    prevVersion := prevVersions[0]
                    prevVersion.IsLatest = true
                    r.Add(prevVersion, true) // Update existing object
                    log.Printf("RealmDB: Restored previous version of CapabilityDescriptor %s as latest", descriptor.ID)
                }
            }
            
            // Delete the descriptor
            r.Delete(descriptor)
        }
        log.Printf("RealmDB: Deleted %d CapabilityDescriptors from orphaned block %d", len(capabilityDescriptors), block.Header.Height)
        
        // Delete transactions
        transactions := r.Objects(TransactionRealm{}, "blockHeight == $0", block.Header.Height)
        for _, tx := range transactions {
            r.Delete(tx)
        }
        log.Printf("RealmDB: Deleted %d Transactions from orphaned block %d", len(transactions), block.Header.Height)
        
        return nil
    })
    
    return err
}
```

#### 5.2.2 Integration with Blockchain Core

To integrate the RealmSyncManager with the blockchain core, we need to modify the blockchain struct to include the RealmSyncManager and call its methods at the appropriate times:

```go
