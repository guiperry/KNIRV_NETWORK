// UpdateHostURLFromEnv attempts to load HOST_URL from root-data/env.local
// and assign it to ROOTCHAIN_URL. This should be called after env.local is potentially updated.
func UpdateHostURLFromEnv() {
	log.Println("Attempting to update ROOTCHAIN_URL from env.local...")
	// Try to determine a sensible path for root-data/env.local
	// This is a simplified approach for init(); a more robust solution might involve
	// a shared configuration utility that's initialized earlier.
	var envPath string
	exePath, err := os.Executable()
	if err == nil {
		envPath = filepath.Join(filepath.Dir(exePath), "env.local")
	} else {
		// Fallback to current working directory if executable path fails
		cwd, err := os.Getwd()
		if err == nil {
			envPath = filepath.Join(cwd, "env.local")
		}
	}

	if envPath != "" {
		file, err := os.Open(envPath)
		if err == nil {
			defer file.Close()
			scanner := bufio.NewScanner(file)
			for scanner.Scan() {
				line := scanner.Text()
				if strings.HasPrefix(line, "HOST_URL=") {
					ROOTCHAIN_URL = strings.TrimPrefix(line, "HOST_URL=")
					log.Printf("Successfully loaded ROOTCHAIN_URL from %s: %s", envPath, ROOTCHAIN_URL)
					return
				}
			}
		}
	}
	// If not updated, ROOTCHAIN_URL retains its current value (either default or previously set)
	// Log the final state of ROOTCHAIN_URL after attempting the update.
	log.Printf("ROOTCHAIN_URL is now: %s (after attempting update from env.local at %s)", ROOTCHAIN_URL, envPath)
}
// SetRootchainURL allows updating the ROOTCHAIN_URL global variable.
// This should be called by main after the public IP for the root node is determined.
func SetRootchainURL(newURL string) {
	if newURL != "" {
		ROOTCHAIN_URL = newURL
		log.Printf("ROOTCHAIN_URL has been updated to: %s", ROOTCHAIN_URL)
	}
}
