{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "knirv-network-registry",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "REGISTRY", "class_name": "RegistryStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegistryStore"] }],
  "vars": {
    "REGISTRY_VERSION": "3.0.0",
    "NODE_TTL_SECONDS": "3600",
    "HEARTBEAT_TTL_SECONDS": "45",
    "STUN_HOST": "",
    "STUN_PORT": "3478",
    "TURN_TCP_PORT": "3479",
    "ROOT_PUBLIC_KEY": "",
    "BOOTNODE_VALIDATION": "enforce",
    "VALIDATION_TTL_SECONDS": "3600",
    "VALIDATION_FAIL_COOLDOWN_SECONDS": "60",
    "VALIDATION_MAX_LATENCY_MS": "1500",
    "VALIDATION_FQDN_SUFFIXES": ".knirv.com"
  }
}
