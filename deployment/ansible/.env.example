# KNIRV Network Infrastructure Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# CLOUD PROVIDER CREDENTIALS
# =============================================================================

# AWS Credentials (required for AWS deployment)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# Google Cloud Platform (optional, for GCP deployment)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_PROJECT_ID=your-gcp-project-id

# Microsoft Azure (optional, for Azure deployment)
# AZURE_CLIENT_ID=your-azure-client-id
# AZURE_CLIENT_SECRET=your-azure-client-secret
# AZURE_TENANT_ID=your-azure-tenant-id
# AZURE_SUBSCRIPTION_ID=your-azure-subscription-id

# DigitalOcean (optional, for DO deployment)
# DO_API_TOKEN=your-digitalocean-api-token

# =============================================================================
# DNS MANAGEMENT (CLOUDFLARE)
# =============================================================================

# Cloudflare API credentials for DNS management
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# Domain configuration
DOMAIN_NAME=knirv.com

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Default deployment environment
ENVIRONMENT=production

# Cloud provider to use
CLOUD_PROVIDER=aws

# Instance configuration
INSTANCE_TYPE=t3.medium
KEY_PAIR_NAME=knirv-network-key

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# SSH key path (adjust to your actual key location)
SSH_PRIVATE_KEY_PATH=~/.ssh/knirv-network-key.pem

# SSL/TLS configuration
SSL_EMAIL=admin@knirv.com

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================

# Slack webhook for alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email for alerts
ALERT_EMAIL=admin@knirv.com

# PagerDuty integration key (optional)
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# DataDog API key for monitoring (optional)
DATADOG_API_KEY=your-datadog-api-key

# New Relic license key (optional)
NEWRELIC_LICENSE_KEY=your-newrelic-license-key

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# S3 bucket for backups
BACKUP_S3_BUCKET=knirv-backups

# Backup encryption key (optional)
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database credentials (for application deployment)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=knirv
DB_USER=knirv
DB_PASSWORD=your-secure-database-password

# =============================================================================
# BLOCKCHAIN INTEGRATION
# =============================================================================

# XION RPC endpoint
XION_RPC_URL=https://rpc.xion.burnt.com:443

# Blockchain configuration
ENABLE_BLOCKCHAIN_BRIDGE=true

# =============================================================================
# AI SERVICES CONFIGURATION
# =============================================================================

# AI service API keys (optional)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
CEREBRAS_API_KEY=your-cerebras-api-key

# =============================================================================
# DEVELOPMENT/TESTING
# =============================================================================

# Enable debug mode (true/false)
DEBUG_MODE=false

# Enable verbose logging (true/false)
VERBOSE_LOGGING=false

# Test mode (true/false)
TEST_MODE=false
