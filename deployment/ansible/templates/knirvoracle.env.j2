# KNIRVORACLE Environment Configuration
# Generated by Ansible for {{ env_name }} environment

# Basic configuration
NODE_ENV={{ env_name }}
KNIRV_ENV={{ env_name }}
KNIRV_HOME={{ knirvoracle_home }}
KNIRV_CONFIG={{ knirvoracle_home }}/config/config.toml

# Server configuration
KNIRVORACLE_PORT={{ oracle_main_port }}
KNIRVORACLE_HOST=0.0.0.0

# Service ports
BOOTNODE_REGISTRY_PORT={{ bootnode_registry_port }}
TUNNEL_REGISTRY_PORT={{ tunnel_registry_port }}
NOTARY_SYSTEM_PORT={{ notary_system_port }}
NETWORK_MONITOR_PORT={{ network_monitor_port }}
NANDA_ANS_PORT={{ nanda_ans_port }}

# Database configuration
DATABASE_PATH={{ knirvoracle_home }}/data/knirvoracle.db

# Logging configuration
LOG_LEVEL={{ knirvoracle_log_level | default('info') }}
LOG_FILE={{ knirvoracle_home }}/logs/knirvoracle.log

# CloudFlare configuration (secrets)
{% if cloudflare_api_token is defined and cloudflare_api_token != '' %}
CLOUDFLARE_API_TOKEN={{ cloudflare_api_token }}
{% endif %}
{% if cloudflare_zone_id is defined and cloudflare_zone_id != '' %}
CLOUDFLARE_ZONE_ID={{ cloudflare_zone_id }}
{% endif %}

# Security configuration
{% if knirvoracle_api_key is defined and knirvoracle_api_key != '' %}
KNIRVORACLE_API_KEY={{ knirvoracle_api_key }}
{% endif %}

# Network configuration
PUBLIC_IP={{ ansible_default_ipv4.address | default('localhost') }}
DOMAIN_NAME={{ zone_name }}

# Blockchain configuration
CHAIN_ID={{ knirv_chain_id | default('knirv-1') }}
TENDERMINT_RPC_PORT={{ tendermint_rpc_port | default('26657') }}
TENDERMINT_P2P_PORT={{ tendermint_p2p_port | default('26656') }}

# Node.js configuration for embedded services
NODE_PATH={{ knirvoracle_home }}/nodejs-services/node_modules
PM2_HOME={{ knirvoracle_home }}/.pm2

# Development settings
{% if env_name == 'development' %}
DEBUG=knirv:*
DEVELOPMENT_MODE=true
HOT_RELOAD=true
{% endif %}

# Performance tuning
UV_THREADPOOL_SIZE=16
NODE_OPTIONS="--max-old-space-size=2048"
