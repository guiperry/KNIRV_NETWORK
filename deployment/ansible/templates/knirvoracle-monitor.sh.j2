#!/bin/bash
# KNIRVORACLE Health Monitoring Script
# Generated by Ansible for {{ env_name }} environment

set -euo pipefail

# Configuration
KNIRVORACLE_HOME="{{ knirvoracle_home }}"
LOG_FILE="${KNIRVORACLE_HOME}/logs/health-check.log"
ALERT_LOG="${KNIRVORACLE_HOME}/logs/alerts.log"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Service endpoints
SERVICES=(
    "oracle:{{ oracle_main_port }}:/health"
    "bootnode-registry:{{ bootnode_registry_port }}:/health"
    "tunnel-registry:{{ tunnel_registry_port }}:/health"
    "notary-system:{{ notary_system_port }}:/health"
    "network-monitor:{{ network_monitor_port }}:/health"
)

# Static file services (no health endpoint)
STATIC_SERVICES=(
    "nanda-ans:{{ nanda_ans_port }}:/"
)

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Logging function
log() {
    echo "[$TIMESTAMP] $1" | tee -a "$LOG_FILE"
}

# Alert function
alert() {
    echo "[$TIMESTAMP] ALERT: $1" | tee -a "$ALERT_LOG"
}

# Check service health
check_service() {
    local service_name="$1"
    local port="$2"
    local endpoint="$3"
    local url="http://localhost:${port}${endpoint}"
    
    if curl -s -f --max-time 10 "$url" > /dev/null 2>&1; then
        echo -e "${GREEN}✅ ${service_name} (${port}): HEALTHY${NC}"
        return 0
    else
        echo -e "${RED}❌ ${service_name} (${port}): UNHEALTHY${NC}"
        alert "${service_name} service is unhealthy (port ${port})"
        return 1
    fi
}

# Check systemd service status
check_systemd_service() {
    if systemctl is-active --quiet knirvoracle; then
        echo -e "${GREEN}✅ KNIRVORACLE systemd service: RUNNING${NC}"
        return 0
    else
        echo -e "${RED}❌ KNIRVORACLE systemd service: NOT RUNNING${NC}"
        alert "KNIRVORACLE systemd service is not running"
        return 1
    fi
}

# Check disk space
check_disk_space() {
    local usage=$(df -h "${KNIRVORACLE_HOME}" | awk 'NR==2{print $5}' | sed 's/%//')
    if [ "$usage" -lt 80 ]; then
        echo -e "${GREEN}✅ Disk space: ${usage}% used${NC}"
        return 0
    elif [ "$usage" -lt 90 ]; then
        echo -e "${YELLOW}⚠️  Disk space: ${usage}% used (WARNING)${NC}"
        return 0
    else
        echo -e "${RED}❌ Disk space: ${usage}% used (CRITICAL)${NC}"
        alert "Disk space critical: ${usage}% used"
        return 1
    fi
}

# Check memory usage
check_memory() {
    local mem_usage=$(free | grep Mem | awk '{printf("%.1f", $3/$2 * 100.0)}')
    local mem_usage_int=${mem_usage%.*}
    
    if [ "$mem_usage_int" -lt 80 ]; then
        echo -e "${GREEN}✅ Memory usage: ${mem_usage}%${NC}"
        return 0
    elif [ "$mem_usage_int" -lt 90 ]; then
        echo -e "${YELLOW}⚠️  Memory usage: ${mem_usage}% (WARNING)${NC}"
        return 0
    else
        echo -e "${RED}❌ Memory usage: ${mem_usage}% (CRITICAL)${NC}"
        alert "Memory usage critical: ${mem_usage}%"
        return 1
    fi
}

# Check log file sizes
check_log_sizes() {
    local log_dir="${KNIRVORACLE_HOME}/logs"
    local large_logs=$(find "$log_dir" -name "*.log" -size +100M 2>/dev/null || true)
    
    if [ -z "$large_logs" ]; then
        echo -e "${GREEN}✅ Log file sizes: OK${NC}"
        return 0
    else
        echo -e "${YELLOW}⚠️  Large log files detected:${NC}"
        echo "$large_logs" | while read -r logfile; do
            local size=$(du -h "$logfile" | cut -f1)
            echo "  - $(basename "$logfile"): $size"
        done
        return 0
    fi
}

# Main health check
main() {
    echo "KNIRVORACLE Health Check - $TIMESTAMP"
    echo "=========================================="
    
    local failed_checks=0
    
    # Check systemd service
    check_systemd_service || ((failed_checks++))
    
    # Check service endpoints
    for service in "${SERVICES[@]}"; do
        IFS=':' read -r name port endpoint <<< "$service"
        check_service "$name" "$port" "$endpoint" || ((failed_checks++))
    done
    
    # Check static services
    for service in "${STATIC_SERVICES[@]}"; do
        IFS=':' read -r name port endpoint <<< "$service"
        check_service "$name" "$port" "$endpoint" || ((failed_checks++))
    done
    
    echo ""
    echo "System Resources:"
    echo "=================="
    
    # System checks
    check_disk_space || ((failed_checks++))
    check_memory || ((failed_checks++))
    check_log_sizes
    
    # CPU usage
    local cpu_usage=$(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1)
    echo -e "${GREEN}📊 CPU usage: ${cpu_usage}%${NC}"
    
    # Load average
    local load_avg=$(uptime | awk -F'load average:' '{print $2}')
    echo -e "${GREEN}📈 Load average:${load_avg}${NC}"
    
    # Network connectivity
    if ping -c 1 8.8.8.8 > /dev/null 2>&1; then
        echo -e "${GREEN}🌐 Network connectivity: OK${NC}"
    else
        echo -e "${RED}❌ Network connectivity: FAILED${NC}"
        alert "Network connectivity check failed"
        ((failed_checks++))
    fi
    
    echo ""
    echo "Summary:"
    echo "========"
    
    if [ $failed_checks -eq 0 ]; then
        echo -e "${GREEN}✅ All checks passed! KNIRVORACLE is healthy.${NC}"
        log "Health check passed - all services healthy"
    else
        echo -e "${RED}❌ $failed_checks check(s) failed! KNIRVORACLE needs attention.${NC}"
        log "Health check failed - $failed_checks issues detected"
    fi
    
    echo ""
    echo "Quick Commands:"
    echo "==============="
    echo "📋 View logs: journalctl -u knirvoracle -f"
    echo "🔄 Restart service: sudo systemctl restart knirvoracle"
    echo "📊 Service status: sudo systemctl status knirvoracle"
    echo "🔍 Check config: cat ${KNIRVORACLE_HOME}/config/config.toml"
    
    return $failed_checks
}

# Run main function
main "$@"
