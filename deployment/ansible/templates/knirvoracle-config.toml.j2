# KNIRVORACLE Configuration Template
# Generated by Ansible for {{ env_name }} environment

[server]
# Main server configuration
port = {{ oracle_main_port }}
host = "0.0.0.0"
environment = "{{ env_name }}"

# Logging configuration
log_level = "{{ knirvoracle_log_level | default('info') }}"
log_file = "{{ knirvoracle_home }}/logs/knirvoracle.log"

[database]
# Database configuration
type = "buntdb"
path = "{{ knirvoracle_home }}/data/knirvoracle.db"

[blockchain]
# Blockchain configuration
chain_id = "{{ knirv_chain_id | default('knirv-1') }}"
genesis_file = "{{ knirvoracle_home }}/config/genesis.json"

# Tendermint configuration
tendermint_rpc_port = {{ tendermint_rpc_port | default('26657') }}
tendermint_p2p_port = {{ tendermint_p2p_port | default('26656') }}

[network_monitor]
# Network Monitor configuration
enabled = true
port = {{ network_monitor_port }}
check_interval = "30s"
timeout = "10s"

[nodejs_services]
# Node.js Services Configuration

[nodejs_services.bootnode_registry]
enabled = true
script_path = "operator-registry/registry-service.js"
http_port = {{ bootnode_registry_port }}

[nodejs_services.tunnel_registry]
enabled = true
script_path = "agent-tunnel-registry/server.js"
http_port = {{ tunnel_registry_port }}
stun_port = {{ tunnel_registry_stun_port | default('3478') }}
server_public_host = "{{ ansible_default_ipv4.address | default('localhost') }}"

[nodejs_services.notary_system]
enabled = true
script_path = "agent-notary-system/server.js"
http_port = {{ notary_system_port }}

[nodejs_services.network_monitor]
enabled = true
script_path = "agent-network-monitor/server.js"
http_port = {{ network_monitor_port }}

[nodejs_services.nanda_ans]
enabled = true
http_port = 0  # Use main HTTP server port (served as static files)

[tunnel_client]
# Tunnel Client configuration (disabled by default for root nodes)
enabled = false
server_address = ""
control_port = 0
ping_interval = "30s"
reconnect_delay = "5s"

[cors]
# CORS configuration
allowed_origins = [
  "https://{{ zone_name }}",
  "https://*.{{ zone_name }}",
  "http://localhost:*",
  "http://127.0.0.1:*"
]
allowed_methods = ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
allowed_headers = ["*"]
allow_credentials = true

[security]
# Security configuration
api_key = "{{ knirvoracle_api_key | default('') }}"
rate_limit_enabled = true
rate_limit_requests_per_minute = {{ rate_limit_rpm | default('100') }}

[metrics]
# Metrics and monitoring
enabled = true
port = {{ metrics_port | default('9090') }}
path = "/metrics"

[cloudflare]
# CloudFlare integration
api_token = "{{ cloudflare_api_token | default('') }}"
zone_id = "{{ cloudflare_zone_id | default('') }}"
domain = "{{ zone_name }}"

# Service endpoints for CloudFlare DNS updates
[cloudflare.services]
oracle = "oracle.{{ zone_name }}"
bootnode_registry = "bootnode-registry.{{ zone_name }}"
tunnel_registry = "tunnel-registry.{{ zone_name }}"
notary_system = "notary-system.{{ zone_name }}"
network_monitor = "network-monitor.{{ zone_name }}"
nanda_ans = "nanda-ans.{{ zone_name }}"

[ipfs]
# IPFS configuration
enabled = {{ ipfs_enabled | default('false') }}
api_port = {{ ipfs_api_port | default('5001') }}
gateway_port = {{ ipfs_gateway_port | default('8888') }}

[p2p]
# P2P networking configuration
enabled = true
listen_port = {{ p2p_listen_port | default('4001') }}
bootstrap_peers = {{ p2p_bootstrap_peers | default('[]') | to_json }}

[development]
# Development mode settings
debug = {{ development_debug | default('false') }}
hot_reload = {{ development_hot_reload | default('false') }}
mock_services = {{ development_mock_services | default('false') }}
