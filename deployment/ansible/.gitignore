# KNIRV Network Ansible .gitignore

# Environment files (contain sensitive information)
.env
.env.local
.env.production
.env.staging
.env.development

# Ansible logs and temporary files
ansible.log
*.log
*.retry
.ansible/
*.csv


# SSH keys and certificates
*.pem
*.key
*.crt
*.p12
id_rsa*
id_ed25519*

# Terraform state files (if using Terraform with Ansible)
*.tfstate
*.tfstate.backup
.terraform/
terraform.tfvars

# Vault files (if using Ansible Vault)
vault_pass.txt
.vault_pass

# Temporary files
*.tmp
*.temp
.tmp/
temp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Python cache (if using Python scripts)
__pycache__/
*.pyc
*.pyo

# Node.js (for documentation generation)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backup files
*.bak
*.backup
*.old

# Local configuration overrides
local.yml
local.yaml
override.yml
override.yaml
