# KNIRVANA Podman Containerfile
# Multi-client build with Rust and TypeScript support
FROM registry.fedoraproject.org/fedora:39 AS rust-builder

# Install Rust and build dependencies
RUN dnf install -y rust cargo gcc openssl-devel pkgconfig && \
    dnf clean all

# Set working directory for Rust client
WORKDIR /app/rust-client

# Copy Rust client files
COPY rust-client/Cargo.toml rust-client/Cargo.lock ./
COPY rust-client/src ./src
COPY rust-client/examples ./examples
COPY rust-client/benches ./benches
COPY rust-client/build.rs ./

# Build Rust client
RUN cargo build --release --features desktop

# Node.js builder stage for TypeScript client
FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS ts-builder

# Switch to root for package installation
USER root

# Install build dependencies
RUN dnf install -y python3 make gcc-c++ git && \
    dnf clean all

# Switch back to default user
USER 1001

# Set working directory for TypeScript client
WORKDIR /app/ts-client

# Copy TypeScript client package files
COPY --chown=1001:1001 ts-client/package*.json ./
COPY --chown=1001:1001 ts-client/tsconfig.json ./
COPY --chown=1001:1001 ts-client/vite.config.ts ./
COPY --chown=1001:1001 ts-client/tailwind.config.ts ./
COPY --chown=1001:1001 ts-client/postcss.config.js ./
COPY --chown=1001:1001 ts-client/drizzle.config.ts ./

# Install dependencies
RUN npm ci

# Copy TypeScript client source
COPY --chown=1001:1001 ts-client/src ./src
COPY --chown=1001:1001 ts-client/server ./server
COPY --chown=1001:1001 ts-client/shared ./shared
COPY --chown=1001:1001 ts-client/client ./client

# Build TypeScript client
RUN npm run build

# Production stage
FROM registry.access.redhat.com/ubi9/nodejs-20-minimal:latest AS production

# Switch to root for setup
USER root

# Install runtime dependencies
RUN microdnf install -y curl && \
    microdnf clean all

# Create application user
RUN useradd -r -u 1001 -g 0 knirvana

# Set working directory
WORKDIR /app

# Copy built Rust binary
COPY --from=rust-builder --chown=1001:0 /app/rust-client/target/release/knirvana_game ./bin/knirvana-game

# Copy built TypeScript application
COPY --from=ts-builder --chown=1001:0 /app/ts-client/dist ./web
COPY --from=ts-builder --chown=1001:0 /app/ts-client/package*.json ./

# Install production dependencies for TypeScript client
RUN npm ci --only=production && \
    npm cache clean --force

# Create data directories
RUN mkdir -p /app/data /app/logs && \
    chown -R 1001:0 /app && \
    chmod -R g+rwX /app

# Switch to non-root user
USER 1001

# Expose ports
EXPOSE 3000 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Set environment variables
ENV NODE_ENV=production
ENV RUST_LOG=info
ENV KNIRVANA_MODE=web

# Volume for persistent data
VOLUME ["/app/data"]

# Default command (starts TypeScript web client)
CMD ["npm", "start"]
