     // CreateWallet creates a new wallet file
     func CreateWallet(filePath string, password string) (string, error) {
         // Generate key pair
         privateKey, err := GenerateKeyPair()
         if err != nil {
             return "", fmt.Errorf("failed to generate key pair: %w", err)
         }
         
         // Encrypt private key
         encryptedKey, err := EncryptPrivateKey(privateKey, password)
         if err != nil {
             return "", fmt.Errorf("failed to encrypt private key: %w", err)
         }
         
         // Create wallet file
         wallet := Wallet{
             Address:      crypto.PubkeyToAddress(privateKey.PublicKey).Hex(),
             EncryptedKey: encryptedKey,
             Version:      "1.0.0",
             Timestamp:    time.Now().Unix(),
         }
         
         // Marshal to JSON
         walletJSON, err := json.MarshalIndent(wallet, "", "  ")
         if err != nil {
             return "", fmt.Errorf("failed to marshal wallet to JSON: %w", err)
         }
         
         // Write to file
         if err := ioutil.WriteFile(filePath, walletJSON, 0600); err != nil {
             return "", fmt.Errorf("failed to write wallet file: %w", err)
         }
         
         return wallet.Address, nil
     }
