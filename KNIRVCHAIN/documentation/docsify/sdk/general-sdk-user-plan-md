     // ListWallets lists all wallets in the specified directory
     func ListWallets(directory string) ([]WalletInfo, error) {
         // Get all files in directory
         files, err := ioutil.ReadDir(directory)
         if err != nil {
             return nil, fmt.Errorf("failed to read directory: %w", err)
         }
         
         // Filter wallet files
         var walletInfos []WalletInfo
         for _, file := range files {
             if file.IsDir() || !strings.HasSuffix(file.Name(), ".json") {
                 continue
             }
             
             // Read wallet file
             filePath := filepath.Join(directory, file.Name())
             walletData, err := ioutil.ReadFile(filePath)
             if err != nil {
                 continue
             }
             
             // Parse wallet
             var wallet Wallet
             if err := json.Unmarshal(walletData, &wallet); err != nil {
                 continue
             }
             
             // Add to list
             walletInfos = append(walletInfos, WalletInfo{
                 Address:  wallet.Address,
                 FilePath: filePath,
             })
         }
         
         return walletInfos, nil
     }
