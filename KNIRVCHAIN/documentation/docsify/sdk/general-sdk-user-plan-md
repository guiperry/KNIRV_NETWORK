     ```go
     // agentUri represents a parsed agent URI
     type agentUri struct {
         Scheme       string            // Always "agent"
         ResourceType string            // "capability", "transaction", "address", etc.
         Identifier   string            // Resource identifier (capability ID, transaction hash, address)
         Action       string            // Optional action to perform ("invoke", "query", "transfer", etc.)
         Parameters   map[string]string // Optional parameters
     }
     
     // ParseagentUri parses a agent URI string into a structured object
     func ParseagentUri(uriString string) (*agentUri, error) {
         // Validate URI format
         if !strings.HasPrefix(uriString, "agent://") {
             return nil, fmt.Errorf("invalid agent URI: must start with 'agent://'")
         }
         
         // Parse URI
         parsedUrl, err := url.Parse(uriString)
         if err != nil {
             return nil, fmt.Errorf("failed to parse URI: %w", err)
         }
         
         // Extract components
         pathParts := strings.Split(strings.TrimPrefix(parsedUrl.Path, "/"), "/")
         if len(pathParts) < 2 {
             return nil, fmt.Errorf("invalid agent URI: must contain resource type and identifier")
         }
         
         // Create result
         result := &agentUri{
             Scheme:       "agent",
             ResourceType: pathParts[0],
             Identifier:   pathParts[1],
             Parameters:   make(map[string]string),
         }
         
         // Extract action if present
         if len(pathParts) > 2 {
             result.Action = pathParts[2]
         }
         
         // Extract query parameters
         queryParams := parsedUrl.Query()
         for key, values := range queryParams {
             if len(values) > 0 {
                 result.Parameters[key] = values[0]
             }
         }
         
         return result, nil
     }
     
     // ToUriString converts a agentUri object back to a string
     func (uri *agentUri) ToUriString() string {
         // Build base URI
         var builder strings.Builder
         builder.WriteString("agent://")
         builder.WriteString(uri.ResourceType)
         builder.WriteString("/")
         builder.WriteString(uri.Identifier)
         
         // Add action if present
         if uri.Action != "" {
             builder.WriteString("/")
             builder.WriteString(uri.Action)
         }
         
         // Add query parameters if present
         if len(uri.Parameters) > 0 {
             builder.WriteString("?")
             first := true
             for key, value := range uri.Parameters {
                 if !first {
                     builder.WriteString("&")
                 }
                 builder.WriteString(url.QueryEscape(key))
                 builder.WriteString("=")
                 builder.WriteString(url.QueryEscape(value))
                 first = false
             }
         }
         
         return builder.String()
     }
     ```

