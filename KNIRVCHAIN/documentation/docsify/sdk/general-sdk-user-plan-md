     ```go
     // APIClient represents a client for the AGENTCHAIN API
     type APIClient struct {
         BaseURL    string
         HTTPClient *http.Client
         MaxRetries int
         Logger     *log.Logger
     }
     
     // NewAPIClient creates a new API client
     func NewAPIClient(baseURL string, timeout time.Duration, maxRetries int, logger *log.Logger) *APIClient {
         return &APIClient{
             BaseURL: baseURL,
             HTTPClient: &http.Client{
                 Timeout: timeout,
             },
             MaxRetries: maxRetries,
             Logger:     logger,
         }
     }
     
     // Do performs an HTTP request with retry logic
     func (c *APIClient) Do(req *http.Request) (*http.Response, error) {
         var resp *http.Response
         var err error
         
         for i := 0; i <= c.MaxRetries; i++ {
             resp, err = c.HTTPClient.Do(req)
             if err == nil {
                 return resp, nil
             }
             
             // Log error
             c.Logger.Printf("Request failed (attempt %d/%d): %v", i+1, c.MaxRetries+1, err)
             
             // Check if we should retry
             if i < c.MaxRetries {
                 // Wait with exponential backoff
                 backoff := time.Duration(math.Pow(2, float64(i))) * time.Second
                 time.Sleep(backoff)
                 
                 // Create a new request (the old one may have been consumed)
                 req = copyRequest(req)
             }
         }
         
         return nil, fmt.Errorf("request failed after %d attempts: %w", c.MaxRetries+1, err)
     }
     ```

