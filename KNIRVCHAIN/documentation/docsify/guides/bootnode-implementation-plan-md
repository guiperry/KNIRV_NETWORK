    // Set service description
    cmd = exec.Command("sc", "description", serviceName, description)
    if err := cmd.Run(); err != nil {
        log.Printf("Warning: Failed to set service description: %v", err)
        // Continue anyway as this is not critical
    }
    
    // Configure service recovery options (restart on failure)
    cmd = exec.Command("sc", "failure", serviceName, 
        "reset=", "86400", // Reset failure count after 1 day
        "actions=", "restart/60000/restart/60000/restart/60000") // Restart after 1 minute, up to 3 times
    if err := cmd.Run(); err != nil {
        log.Printf("Warning: Failed to set service recovery options: %v", err)
        // Continue anyway as this is not critical
    }
    
    // Start the service
    cmd = exec.Command("sc", "start", serviceName)
    if err := cmd.Run(); err != nil {
        return fmt.Errorf("failed to start Windows service: %w", err)
    }
    
    log.Printf("Windows service '%s' installed and started successfully", serviceName)
    return nil
}

