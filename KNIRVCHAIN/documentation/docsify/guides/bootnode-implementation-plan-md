func configureWindowsService(configPath string, cfg *config.Config, serviceType string) error {
    // Determine installation directory
    installDir := os.Getenv("ProgramFiles") + `\KNIRVCHAIN`
    
    // Determine service name and settings based on service type
    var serviceName string
    var displayName string
    var description string
    var binPath string
    var logPath string
    
    if serviceType == "bootnode" {
        serviceName = "KNIRVORACLEBootnode"
        
        // Use bootnode-specific settings if available
        if cfg.Bootnode.ServiceDisplayName != "" {
            displayName = cfg.Bootnode.ServiceDisplayName
        } else {
            displayName = fmt.Sprintf("KNIRVCHAIN Bootnode Service (%s)", cfg.ChainID)
        }
        
        if cfg.Bootnode.ServiceDescription != "" {
            description = cfg.Bootnode.ServiceDescription
        } else {
            description = fmt.Sprintf("KNIRVCHAIN network bootnode service for chain %s", cfg.ChainID)
        }
        
        if cfg.Bootnode.ServiceLogPath != "" {
            logPath = cfg.Bootnode.ServiceLogPath
        } else {
            logPath = os.Getenv("ProgramData") + `\KNIRVCHAIN\logs\bootnode.log`
        }
        
        binPath = fmt.Sprintf(`"%s\KNIRVCHAIN.exe" -bootnode -config "%s"`, installDir, configPath)
    } else {
        serviceName = "KNIRVORACLEPeer"
        displayName = fmt.Sprintf("KNIRVCHAIN Peer Node Service (%s)", cfg.ChainID)
        description = fmt.Sprintf("KNIRVCHAIN network dev node service for chain %s", cfg.ChainID)
        logPath = os.Getenv("ProgramData") + `\KNIRVCHAIN\logs\dev.log`
        binPath = fmt.Sprintf(`"%s\KNIRVCHAIN.exe" -dev -config "%s"`, installDir, configPath)
    }
    
    // Create log directory if it doesn't exist
    logDir := filepath.Dir(logPath)
    if err := os.MkdirAll(logDir, 0755); err != nil {
        return fmt.Errorf("failed to create log directory: %w", err)
    }
    
    // Redirect output to log file
    binPath += fmt.Sprintf(` > "%s" 2>&1`, logPath)
    
    // Check if running as administrator
