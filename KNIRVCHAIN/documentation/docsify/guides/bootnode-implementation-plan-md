## Detailed Component Implementations

### 1. STUN Client Implementation

The STUN client will use a Go STUN library to discover the node's public IP address:

```go
import (
    "fmt"
    "net"
    "time"
    
    "github.com/pion/stun"
)

// DiscoverPublicIP uses STUN to discover the node's public IP address
func DiscoverPublicIP(stunServer string) (string, error) {
    // Create a STUN client
    c, err := stun.Dial("udp", stunServer)
    if err != nil {
        return "", fmt.Errorf("failed to connect to STUN server: %w", err)
    }
    defer c.Close()
    
    // Set request timeout
    c.SetRTO(time.Second * 5)
    
    // Create message
    message := stun.MustBuild(stun.TransactionID, stun.BindingRequest)
    
    // Send request and get response
    var xorAddr stun.XORMappedAddress
    if err := c.Do(message, func(res stun.Event) {
        if res.Error != nil {
            err = res.Error
            return
        }
        
        if err = xorAddr.GetFrom(res.Message); err != nil {
            return
        }
    }); err != nil {
        return "", fmt.Errorf("failed to get STUN response: %w", err)
    }
    
    if err != nil {
        return "", err
    }
    
    return xorAddr.IP.String(), nil
}
```

### 2. Registry Client Implementation

The registry client will handle communication with the bootnode registry service:

```go
import (
    "bytes"
    "encoding/json"
    "fmt"
    "net/http"
    "time"
)

// RegistryClient handles communication with the bootnode registry service
type RegistryClient struct {
    baseURL    string
    httpClient *http.Client
}

// NewRegistryClient creates a new registry client
func NewRegistryClient(baseURL string) *RegistryClient {
    return &RegistryClient{
        baseURL: baseURL,
        httpClient: &http.Client{
            Timeout: 10 * time.Second,
        },
    }
}

// RegisterBootnode registers this node as a bootnode with the registry service
func (rc *RegistryClient) RegisterBootnode(chainID string, ip string, port int) error {
    // Prepare request body
    reqBody, err := json.Marshal(map[string]interface{}{
        "chainID": chainID,
        "ip":      ip,
        "port":    port,
    })
    if err != nil {
        return fmt.Errorf("failed to marshal request body: %w", err)
    }
    
    // Send request
    resp, err := rc.httpClient.Post(
        fmt.Sprintf("%s/register", rc.baseURL),
        "application/json",
        bytes.NewBuffer(reqBody),
    )
    if err != nil {
        return fmt.Errorf("failed to send registration request: %w", err)
    }
    defer resp.Body.Close()
    
    // Check response status
    if resp.StatusCode != http.StatusOK {
        return fmt.Errorf("registry service returned non-OK status: %d", resp.StatusCode)
    }
    
    return nil
}

// IsRegistryAvailable checks if the registry service is available
func (rc *RegistryClient) IsRegistryAvailable() bool {
    resp, err := rc.httpClient.Get(rc.baseURL)
    if err != nil {
        return false
    }
    defer resp.Body.Close()
    
    return resp.StatusCode == http.StatusOK
}
```

### 3. Bootnode Manager Implementation

The bootnode manager will coordinate bootnode operations:

```go
import (
    "context"
    "log"
    "sync"
    "time"
    
    "KNIRVORACLE_GO_ROOT/config"
)

// BootnodeManager handles bootnode operations
type BootnodeManager struct {
    config         *config.BootnodeConfig
    discoveryMgr   *DiscoveryManager
    registryClient *RegistryClient
    chainID        string
    p2pPort        int
    publicIP       string
    stopChan       chan struct{}
    wg             sync.WaitGroup
}

// NewBootnodeManager creates a new bootnode manager
func NewBootnodeManager(cfg *config.BootnodeConfig, discoveryMgr *DiscoveryManager, chainID string, p2pPort int) (*BootnodeManager, error) {
    // Create registry client
    registryClient := NewRegistryClient(cfg.RegistryURL)
    
    // Discover public IP
    publicIP, err := DiscoverPublicIP(cfg.StunServer)
    if err != nil {
        log.Printf("Warning: Failed to discover public IP via STUN: %v", err)
        // Continue with empty IP, registry will use request source IP
    }
    
    return &BootnodeManager{
        config:         cfg,
        discoveryMgr:   discoveryMgr,
        registryClient: registryClient,
        chainID:        chainID,
        p2pPort:        p2pPort,
        publicIP:       publicIP,
        stopChan:       make(chan struct{}),
    }, nil
}

// Start starts the bootnode manager
func (bm *BootnodeManager) Start() error {
    // First, try to register with the registry service
    if bm.registryClient.IsRegistryAvailable() {
        if err := bm.registryClient.RegisterBootnode(bm.chainID, bm.publicIP, bm.p2pPort); err != nil {
            log.Printf("Warning: Failed to register with registry service: %v", err)
            // Continue with DHT fallback
        } else {
            log.Printf("Successfully registered with registry service as bootnode for chain %s", bm.chainID)
        }
    } else {
        log.Printf("Registry service unavailable, falling back to DHT discovery")
    }
    
    // Start DHT discovery manager
    if err := bm.discoveryMgr.Bootstrap(); err != nil {
        return fmt.Errorf("failed to bootstrap discovery manager: %w", err)
    }
    
    // Announce this node as a provider for the chain
    if err := bm.discoveryMgr.AnnounceGenericResource(bm.chainID, DiscoveryResourceTypeChain); err != nil {
        log.Printf("Warning: Failed to announce chain resource: %v", err)
    }
    
    // Start periodic re-registration
    bm.wg.Add(1)
    go bm.periodicRegistration()
    
    return nil
}

// periodicRegistration periodically re-registers with the registry service
func (bm *BootnodeManager) periodicRegistration() {
    defer bm.wg.Done()
    
    ticker := time.NewTicker(bm.config.RegistrationInterval)
    defer ticker.Stop()
    
    for {
        select {
        case <-ticker.C:
            // Re-register with registry service
            if bm.registryClient.IsRegistryAvailable() {
                if err := bm.registryClient.RegisterBootnode(bm.chainID, bm.publicIP, bm.p2pPort); err != nil {
                    log.Printf("Warning: Failed to re-register with registry service: %v", err)
                }
            }
            
            // Re-announce in DHT
            if err := bm.discoveryMgr.AnnounceGenericResource(bm.chainID, DiscoveryResourceTypeChain); err != nil {
                log.Printf("Warning: Failed to re-announce chain resource: %v", err)
            }
        case <-bm.stopChan:
            return
        }
    }
}

// Stop stops the bootnode manager
func (bm *BootnodeManager) Stop() {
    close(bm.stopChan)
    bm.wg.Wait()
}
