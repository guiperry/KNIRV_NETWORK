// startNodeJSService starts a Node.js service as a child process
func startNodeJSService(scriptPath string, serviceName string, env []string) (*exec.Cmd, error) {
    if scriptPath == "" {
        return nil, fmt.Errorf("no script path provided for %s service", serviceName)
    }

    // Check if the script exists
    if _, err := os.Stat(scriptPath); os.IsNotExist(err) {
        return nil, fmt.Errorf("script not found for %s service: %s", serviceName, scriptPath)
    }

    // Prepare the command
    cmd := exec.Command("node", scriptPath)
    
    // Set environment variables
    cmd.Env = append(os.Environ(), env...)
    
    // Capture stdout and stderr
    stdout, err := cmd.StdoutPipe()
    if err != nil {
        return nil, fmt.Errorf("failed to capture stdout for %s service: %v", serviceName, err)
    }
    
    stderr, err := cmd.StderrPipe()
    if err != nil {
        return nil, fmt.Errorf("failed to capture stderr for %s service: %v", serviceName, err)
    }
    
    // Start the process
    if err := cmd.Start(); err != nil {
        return nil, fmt.Errorf("failed to start %s service: %v", serviceName, err)
    }
    
    log.Printf("Started %s service (PID: %d)", serviceName, cmd.Process.Pid)
    
    // Handle stdout in a goroutine
    go func() {
        scanner := bufio.NewScanner(stdout)
        for scanner.Scan() {
            log.Printf("[%s] %s", serviceName, scanner.Text())
        }
    }()
    
    // Handle stderr in a goroutine
    go func() {
        scanner := bufio.NewScanner(stderr)
        for scanner.Scan() {
            log.Printf("[%s ERROR] %s", serviceName, scanner.Text())
        }
    }()
    
    return cmd, nil
}

