## Phase 2: Node.js Tunnel Service Implementation

### 2.0 Client-Side Ping Implementation (Go)

Add the following code to tunnel_client.go to implement periodic pings to the tunnel server:

```go
// TunnelClient manages the connection to the central relay/tunnel server
type TunnelClient struct {
    conn           net.Conn
    serverAddress  string
    serverPort     int
    devId         string
    chainId        string
    nodeType       string
    internalIp     string
    internalP2pPort int
    isConnected    bool
    reconnectTimer *time.Timer
    pingTicker     *time.Ticker
    mutex          sync.Mutex
}

// NewTunnelClient creates a new tunnel client
func NewTunnelClient(serverAddress string, serverPort int, devId, chainId, nodeType string, internalIp string, internalP2pPort int, pingInterval, reconnectDelay int) *TunnelClient {
    // Use defaults if values are invalid
    if pingInterval <= 0 {
        pingInterval = 30 // Default: 30 seconds
    }
    if reconnectDelay <= 0 {
        reconnectDelay = 5 // Default: 5 seconds
    }
    
    return &TunnelClient{
        serverAddress:  serverAddress,
        serverPort:     serverPort,
        devId:         devId,
        chainId:        chainId,
        nodeType:       nodeType,
        internalIp:     internalIp,
        internalP2pPort: internalP2pPort,
        reconnectTimer: time.NewTimer(time.Duration(reconnectDelay) * time.Second),
        pingTicker:     time.NewTicker(time.Duration(pingInterval) * time.Second),
    }
}

// Connect establishes a connection to the tunnel server
func (c *TunnelClient) Connect() error {
    c.mutex.Lock()
    defer c.mutex.Unlock()
    
    if c.isConnected {
        return nil
    }
    
    addr := fmt.Sprintf("%s:%d", c.serverAddress, c.serverPort)
    log.Printf("[TunnelClient] Connecting to tunnel server at %s", addr)
    
    var err error
    c.conn, err = net.Dial("tcp", addr)
    if err != nil {
        log.Printf("[TunnelClient] Failed to connect to tunnel server: %v", err)
        c.scheduleReconnect()
        return err
    }
    
    // Send identification message
    identMsg := map[string]interface{}{
        "action":         "IDENTIFY",
        "devId":         c.devId,
        "chainId":        c.chainId,
        "internalIp":     c.internalIp,
        "internalP2pPort": c.internalP2pPort,
        "type":           c.nodeType,
    }
    
    jsonData, err := json.Marshal(identMsg)
    if err != nil {
        log.Printf("[TunnelClient] Failed to marshal identification message: %v", err)
        c.conn.Close()
        c.scheduleReconnect()
        return err
    }
    
    _, err = c.conn.Write(append(jsonData, '\n'))
    if err != nil {
        log.Printf("[TunnelClient] Failed to send identification message: %v", err)
        c.conn.Close()
        c.scheduleReconnect()
        return err
    }
    
    c.isConnected = true
    log.Printf("[TunnelClient] Connected to tunnel server and sent identification")
    
    // Start reading responses in a goroutine
    go c.readResponses()
    
    // Start sending periodic pings
    go c.startPinging()
    
    return nil
}

// readResponses reads and processes responses from the tunnel server
func (c *TunnelClient) readResponses() {
    reader := bufio.NewReader(c.conn)
    
    for {
        line, err := reader.ReadString('\n')
        if err != nil {
            if err == io.EOF || strings.Contains(err.Error(), "use of closed network connection") {
                log.Printf("[TunnelClient] Connection closed by server")
            } else {
                log.Printf("[TunnelClient] Error reading from server: %v", err)
            }
            
            c.mutex.Lock()
            c.isConnected = false
            if c.conn != nil {
                c.conn.Close()
                c.conn = nil
            }
            c.scheduleReconnect()
            c.mutex.Unlock()
            return
        }
        
        // Process the response
        var response map[string]interface{}
        if err := json.Unmarshal([]byte(line), &response); err != nil {
            log.Printf("[TunnelClient] Failed to parse server response: %v", err)
            continue
        }
        
        action, ok := response["action"].(string)
        if !ok {
            log.Printf("[TunnelClient] Server response missing 'action' field: %v", response)
            continue
        }
        
        switch action {
        case "PONG":
            log.Printf("[TunnelClient] Received PONG from server")
        case "PING_CHECK":
            // Server is checking if we're still alive, respond with a PING
            c.sendPing()
        default:
            log.Printf("[TunnelClient] Received unknown action from server: %s", action)
        }
    }
}

// startPinging starts the periodic ping process
func (c *TunnelClient) startPinging() {
    for range c.pingTicker.C {
        c.sendPing()
    }
}

// sendPing sends a ping message to the server
func (c *TunnelClient) sendPing() {
    c.mutex.Lock()
    defer c.mutex.Unlock()
    
    if !c.isConnected || c.conn == nil {
        return
    }
    
    pingMsg := map[string]interface{}{
        "action":    "PING",
        "timestamp": time.Now().UnixNano() / int64(time.Millisecond),
        "devId":    c.devId,
    }
    
    jsonData, err := json.Marshal(pingMsg)
    if err != nil {
        log.Printf("[TunnelClient] Failed to marshal ping message: %v", err)
        return
    }
    
    _, err = c.conn.Write(append(jsonData, '\n'))
    if err != nil {
        log.Printf("[TunnelClient] Failed to send ping: %v", err)
        c.isConnected = false
        c.conn.Close()
        c.conn = nil
        c.scheduleReconnect()
        return
    }
    
    log.Printf("[TunnelClient] Sent ping to server")
}

// scheduleReconnect schedules a reconnection attempt
func (c *TunnelClient) scheduleReconnect() {
    c.reconnectTimer.Reset(5 * time.Second)
    go func() {
        <-c.reconnectTimer.C
        if err := c.Connect(); err != nil {
            log.Printf("[TunnelClient] Reconnection failed: %v", err)
        }
    }()
}

// Close closes the connection to the tunnel server
func (c *TunnelClient) Close() {
    c.mutex.Lock()
    defer c.mutex.Unlock()
    
    c.pingTicker.Stop()
    c.reconnectTimer.Stop()
    
    if c.conn != nil {
        c.conn.Close()
        c.conn = nil
    }
    
    c.isConnected = false
}
```

