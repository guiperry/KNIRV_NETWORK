// Example Go client code for resolving and connecting to agent:// URIs
package agenturi

import (
    "context"
    "encoding/json"
    "fmt"
    "io/ioutil"
    "net/http"
    "net/url"
    
    "github.com/libp2p/go-libp2p/core/dev"
    "github.com/multiformats/go-multiaddr"
)

// URIResolver handles resolution of agent:// URIs
type URIResolver struct {
    RegistryURL string // Base URL of the registry service, e.g., "https://registry.knirv.com"
}

// ResolveResponse represents the response from the /api/uri/resolve endpoint
type ResolveResponse struct {
    OriginalURI        string `json:"originalUri"`
    ResolvedIdentifier string `json:"resolvedIdentifier"`
    ResourceType       string `json:"resourceType"`
    SubPathWithQuery   string `json:"subPathWithQuery"`
    ConnectionType     string `json:"connectionType"`
    TargetPeerID       string `json:"targetPeerId"`
    Multiaddress       string `json:"multiaddress"`
    // For TUNNELED type
    TunnelServerHost   string `json:"tunnelServerHost,omitempty"`
    TunnelServerPort   int    `json:"tunnelServerPort,omitempty"`
    RelayProtocolInfo  string `json:"relayProtocolInfo,omitempty"`
}

// ResolveURI resolves a agent:// URI to connection details
func (r *URIResolver) ResolveURI(ctx context.Context, uri string) (*ResolveResponse, error) {
    // Construct the request URL
    reqURL := fmt.Sprintf("%s/api/uri/resolve?uri=%s", r.RegistryURL, url.QueryEscape(uri))
    
    // Create HTTP request
    req, err := http.NewRequestWithContext(ctx, "GET", reqURL, nil)
    if err != nil {
        return nil, fmt.Errorf("failed to create request: %w", err)
    }
    
    // Send the request
    resp, err := http.DefaultClient.Do(req)
    if err != nil {
        return nil, fmt.Errorf("failed to send request: %w", err)
    }
    defer resp.Body.Close()
    
    // Read and parse the response
    body, err := ioutil.ReadAll(resp.Body)
    if err != nil {
        return nil, fmt.Errorf("failed to read response body: %w", err)
    }
    
    if resp.StatusCode != http.StatusOK {
        return nil, fmt.Errorf("registry returned non-OK status: %d, body: %s", resp.StatusCode, string(body))
    }
    
    var resolveResp ResolveResponse
    if err := json.Unmarshal(body, &resolveResp); err != nil {
        return nil, fmt.Errorf("failed to parse response JSON: %w", err)
    }
    
    return &resolveResp, nil
}

// GetPeerAddrInfo converts the resolved response to a libp2p dev.AddrInfo
func (r *ResolveResponse) GetPeerAddrInfo() (*dev.AddrInfo, error) {
    if r.Multiaddress == "" {
        return nil, fmt.Errorf("response does not contain a multiaddress")
    }
    
    ma, err := multiaddr.NewMultiaddr(r.Multiaddress)
    if err != nil {
        return nil, fmt.Errorf("invalid multiaddress: %w", err)
    }
    
    addrInfo, err := dev.AddrInfoFromP2pAddr(ma)
    if err != nil {
        return nil, fmt.Errorf("failed to extract dev info from multiaddress: %w", err)
    }
    
    return addrInfo, nil
}
