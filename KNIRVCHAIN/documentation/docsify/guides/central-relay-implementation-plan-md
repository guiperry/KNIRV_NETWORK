// Add these functions to main.go
// startNodeJSServices starts the configured Node.js services as child processes.
func startNodeJSServices(cfg *config.Config, logger *logrus.Logger) map[string]*nodeService {
    services := make(map[string]*nodeService)

    if !cfg.NodeJSServices.Enabled {
        logger.Info("Node.js services are disabled in configuration.")
        return services
    }

    logger.Info("Starting Node.js services...")

    // Start Registry Service
    if cfg.NodeJSServices.Registry.Enabled && cfg.NodeJSServices.Registry.ScriptPath != "" {
        logger.Infof("Starting Registry Service from: %s", cfg.NodeJSServices.Registry.ScriptPath)
        cmd := exec.Command("node", cfg.NodeJSServices.Registry.ScriptPath)
        // Pipe Node.js stdout/stderr to Go logs
        cmd.Stdout = logger.WriterFor(logrus.InfoLevel)
        cmd.Stderr = logger.WriterFor(logrus.ErrorLevel)
        if err := cmd.Start(); err != nil {
            logger.Errorf("Failed to start Registry Service: %v", err)
        } else {
            services["registry"] = &nodeService{cmd: cmd}
            logger.Info("Registry Service started.")
        }
    }

    // Start Tunnel Service
    if cfg.NodeJSServices.Tunnel.Enabled && cfg.NodeJSServices.Tunnel.ScriptPath != "" {
        logger.Infof("Starting Tunnel Service from: %s", cfg.NodeJSServices.Tunnel.ScriptPath)
        cmd := exec.Command("node", cfg.NodeJSServices.Tunnel.ScriptPath)
        // Pass configuration via environment variables
        cmd.Env = os.Environ() // Inherit existing env vars
        cmd.Env = append(cmd.Env, fmt.Sprintf("HTTP_API_PORT=%d", cfg.NodeJSServices.Registry.HTTPPort))
        cmd.Env = append(cmd.Env, fmt.Sprintf("CONTROL_PORT=%d", cfg.NodeJSServices.Tunnel.ControlPort))
        cmd.Env = append(cmd.Env, fmt.Sprintf("PUBLIC_RELAY_PORT=%d", cfg.NodeJSServices.Tunnel.PublicRelayPort))
        cmd.Env = append(cmd.Env, fmt.Sprintf("PUBLIC_HOST=%s", cfg.NodeJSServices.Tunnel.ServerPublicHost))
        cmd.Env = append(cmd.Env, fmt.Sprintf("RELAY_SERVER_PEER_ID=%s", cfg.PeerID)) // Use the Go node's PeerID

        // Pipe Node.js stdout/stderr to Go logs
        cmd.Stdout = logger.WriterFor(logrus.InfoLevel)
        cmd.Stderr = logger.WriterFor(logrus.ErrorLevel)
        if err := cmd.Start(); err != nil {
            logger.Errorf("Failed to start Tunnel Service: %v", err)
        } else {
            services["tunnel"] = &nodeService{cmd: cmd}
            logger.Info("Tunnel Service started.")
        }
    }

    // Start Payment Gateway Service
    if cfg.NodeJSServices.PaymentGateway.Enabled && cfg.NodeJSServices.PaymentGateway.ScriptPath != "" {
        logger.Infof("Starting Payment Gateway Service from: %s", cfg.NodeJSServices.PaymentGateway.ScriptPath)
        cmd := exec.Command("node", cfg.NodeJSServices.PaymentGateway.ScriptPath)
        // Pass configuration via environment variables
        cmd.Env = os.Environ() // Inherit existing env vars
        cmd.Env = append(cmd.Env, fmt.Sprintf("HTTP_API_PORT=%d", cfg.NodeJSServices.PaymentGateway.HTTPPort))
        cmd.Env = append(cmd.Env, fmt.Sprintf("API_KEY=%s", cfg.NodeJSServices.PaymentGateway.APIKey))
        
        // Pipe Node.js stdout/stderr to Go logs
        cmd.Stdout = logger.WriterFor(logrus.InfoLevel)
        cmd.Stderr = logger.WriterFor(logrus.ErrorLevel)
        if err := cmd.Start(); err != nil {
            logger.Errorf("Failed to start Payment Gateway Service: %v", err)
        } else {
            services["payment_gateway"] = &nodeService{cmd: cmd}
            logger.Info("Payment Gateway Service started.")
        }
    }

    return services
}

// shutdownNodeJSServices sends termination signals to Node.js child processes.
func shutdownNodeJSServices(services map[string]*nodeService, logger *logrus.Logger) {
    logger.Info("Shutting down Node.js services...")
    for name, service := range services {
        if service.cmd != nil && service.cmd.Process != nil {
            logger.Infof("Sending SIGTERM to %s service (PID: %d)...", name, service.cmd.Process.Pid)
            // Send SIGTERM for graceful shutdown
            if err := service.cmd.Process.Signal(syscall.SIGTERM); err != nil {
                logger.Errorf("Failed to send SIGTERM to %s service: %v", name, err)
                // If SIGTERM fails, try SIGKILL (force kill) after a delay
                go func(cmd *exec.Cmd, serviceName string) {
                    time.Sleep(5 * time.Second) // Give it a few seconds to shut down gracefully
                    if cmd.ProcessState == nil || !cmd.ProcessState.Exited() {
                        logger.Warnf("%s service did not exit after SIGTERM, sending SIGKILL...", serviceName)
                        if killErr := cmd.Process.Kill(); killErr != nil {
                            logger.Errorf("Failed to send SIGKILL to %s service: %v", serviceName, killErr)
                        }
                    }
                }(service.cmd, name)
            }
        }
    }
}
