#### Usage Example (TypeScript)

```typescript
import { agentClient, agentClientConfig, agentClientError } from 'agent-uri-sdk'; // Adjust import path

const uriStrings: string[] = [
    "agent://mychain-alpha.chain/block?number=123&validator=node1",
    "agent://content-xyz-123.nrn/data?version=1.2&format=json",
    "agent://another-id.chain/",
    "agent://short.nrn",
    "invalid://mychain.chain/",
    "agent://nonexistent.resource",
];

(async () => {
    const config: agentClientConfig = {
        bootstrapPeers: ["/ip4/127.0.0.1/tcp/6000/p2p/QmBoot1..."], // Example
    };
    const client = new agentClient(config);

    for (const uriString of uriStrings) {
        console.log(`Fetching URI: ${uriString}`);
        try {
            const data: ArrayBuffer = await client.fetchResource(uriString);
            const textDecoder = new TextDecoder('utf-8');
            console.log(`  Fetched Data (first 50 bytes): ${textDecoder.decode(data.slice(0, Math.min(50, data.byteLength)))}...`);
        } catch (e) {
            if (e instanceof agentClientError) {
                console.error(`  Error fetching resource: ${e.message}`);
            } else if (e instanceof Error) {
                console.error(`  Unexpected Error: ${e.message}`);
            } else {
                console.error(`  An unknown error occurred`);
            }
        }
        console.log("---");
    }
    await client.stop();
})();
```

