#### Usage Example

```go
package main

import (
	"fmt"
	"log"

	"github.com/AGENTCHAIN/agent-uri-sdk-go/parser"  // Adjust import path
	agentclient "github.com/AGENTCHAIN/agent-uri-sdk-go/client" // Adjust import path
)

func main() {
	uriStrings := []string{
		"agent://mychain-alpha.chain/block?number=123&validator=node1",
		"agent://content-xyz-123.nrn/data?version=1.2&format=json",
		"agent://another-id.chain/",  // Path defaults to /
		"agent://short.nrn",          // Path defaults to /
		"invalid://mychain.chain/",   // Invalid scheme
		"agent://mychainchain",       // Invalid authority
		"agent://nonexistent.resource", // Valid URI, but resource might not be found
	}

	// SDK Client Initialization (one-time setup)
	config := agentclient.ClientConfig{
		BootstrapPeers: []string{"/ip4/127.0.0.1/tcp/6000/p2p/QmBoot1..."}, // Example
	}

	client, err := agentclient.New(config)
	if err != nil {
		log.Fatalf("Failed to initialize AGENTCHAIN client: %v", err)
	}
	defer client.Close() // Assuming the client needs to be closed

	for _, uriString := range uriStrings {
		fmt.Printf("Fetching URI: %s\n", uriString)
		resource, err := client.FetchResource(uriString)
		if err != nil {
			log.Printf("  Error fetching resource: %v\n", err)
			continue
		}

		parsedURI, err := parser.Parse(uriString)
		if err != nil {
			log.Printf("  Error: %v\n", err)
			continue
		}

		fmt.Printf("  ID:           %s\n", parsedURI.ID)
		fmt.Printf("  ResourceType: %s\n", parsedURI.ResourceType)
		fmt.Printf("  Path:         %s\n", parsedURI.Path)
		fmt.Printf("  Raw URI:      %s\n", parsedURI.Raw)
		fmt.Println("  Query Parameters:")
		for key, values := range parsedURI.Query {
			for _, value := range values {
				fmt.Printf("    %s: %s\n", key, value)
			}
		}
		if parsedURI.Query.Has("number") {
			fmt.Printf("  Extracted 'number': %s\n", parsedURI.Query.Get("number"))
		}
		fmt.Printf("  Fetched Data (first 50 bytes): %s...\n", string(resource.Bytes()[:min(50, len(resource.Bytes()))]))
		fmt.Println("---")
	}
}
```

