### 7. Update the Navigation Hook to Handle Role-Based Redirects

```jsx
// src/hooks/useNavigation.js
import { useRouter } from 'next/router';
import { useState, useEffect } from 'react';
import { useRole } from '../contexts/RoleContext';

export function useNavigation(initialPage) {
  const router = useRouter();
  const { canAccess } = useRole();
  
  // Function to get the current page from the URL
  const getCurrentPage = () => {
    if (!router.isReady) return initialPage;
    const path = router.pathname.substring(1);
    return !path ? initialPage : path;
  };
  
  const [activePage, setActivePage] = useState(initialPage);
  
  useEffect(() => {
    if (!router.isReady) return;
    const currentPage = getCurrentPage();
    setActivePage(currentPage);
  }, [router.isReady, router.pathname]);
  
  // Function to handle navigation between pages
  const handleNavigation = (page) => {
    // Check if the user can access this page
    if (canAccess(page)) {
      setActivePage(page);
      router.push(`/${page}`);
    } else {
      console.warn(`Access to ${page} is not allowed for your role.`);
      // Optionally show a notification to the user
    }
  };
  
  return { activePage, handleNavigation };
}
```

