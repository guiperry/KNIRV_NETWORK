// CerebrasConfig contains configuration for Cerebras embedding function
type CerebrasConfig struct {
    APIKey         string // Direct API key (optional if using environment variables)
    APIKeyEnvName  string // Name of environment variable for API key (default: "DEFAULT_CEREBRAS_API_KEY")
    BaseURL        string // Direct base URL (optional if using environment variables)
    BaseURLEnvName string // Name of environment variable for base URL (default: "DEFAULT_CEREBRAS_BASE_URL")
    Model          string // Model to use (default: "llama3.1-8b")
    TaskType       string // Task type for embedding (default: "retrieval_document")
    Instruction    string // Instruction for embedding (default: "Generate a dense vector representation of the text suitable for semantic search.")
    NormalizeOutput bool  // Whether to normalize output vectors (default: false)
}

// createCerebrasEmbeddingFunction creates a Cerebras embedding function from the configuration
func createCerebrasEmbeddingFunction(cfg *CerebrasConfig) (embeddings.EmbeddingFunction, error) {
    if cfg == nil {
        return nil, fmt.Errorf("Cerebras configuration is nil")
    }
    
    // Prepare client options
    clientOpts := []cerebras.Option{}
    
    // Configure API key (either direct or from environment)
    if cfg.APIKey != "" {
        // Direct API key takes precedence
        clientOpts = append(clientOpts, cerebras.WithBaseURL(cfg.APIKey))
    } else if cfg.APIKeyEnvName != "" {
        // Use environment variable
        clientOpts = append(clientOpts, cerebras.WithAPIKeyFromEnv(cfg.APIKeyEnvName))
    } else {
        // Default to standard environment variable
        clientOpts = append(clientOpts, cerebras.WithAPIKeyFromEnv(cerebras.DefaultAPIKeyEnvVarName))
    }
    
    // Configure base URL (either direct or from environment)
    if cfg.BaseURL != "" {
        // Direct base URL takes precedence
        clientOpts = append(clientOpts, cerebras.WithBaseURL(cfg.BaseURL))
    } else if cfg.BaseURLEnvName != "" {
        // Use environment variable
        clientOpts = append(clientOpts, cerebras.WithBaseURLFromEnv(cfg.BaseURLEnvName))
    } else {
        // Default to standard environment variable
        clientOpts = append(clientOpts, cerebras.WithBaseURLFromEnv(cerebras.DefaultBaseURLEnvVarName))
    }
    
    // Configure model if specified
    if cfg.Model != "" {
        var model cerebras.CerebrasModel
        switch cfg.Model {
        case "llama-4-scout-17b-16e-instruct":
            model = cerebras.Llama4Scout17B16EInstruct
        case "llama3.1-8b":
            model = cerebras.Llama3_1_8B
        case "llama-3.3-70b":
            model = cerebras.Llama3_3_70B
        case "qwen-3-32b":
            model = cerebras.Qwen3_32B
        default:
            // Use the string value directly
            model = cerebras.CerebrasModel(cfg.Model)
        }
        clientOpts = append(clientOpts, cerebras.WithDefaultModel(model))
    }
    
    // Prepare embedding function options
    efOpts := []cerebras.EmbeddingFunctionOption{}
    
    // Configure task type if specified
    if cfg.TaskType != "" {
        efOpts = append(efOpts, cerebras.WithTaskType(cfg.TaskType))
    }
    
    // Configure instruction if specified
    if cfg.Instruction != "" {
        efOpts = append(efOpts, cerebras.WithInstruction(cfg.Instruction))
    }
    
    // Configure normalization
    efOpts = append(efOpts, cerebras.WithNormalizeOutput(cfg.NormalizeOutput))
    
    // Create the embedding function
    return cerebras.NewEmbeddingFunction("", clientOpts, efOpts...)
}

// NewChromemManager creates a new ChromemDB manager
func NewChromemManager(cfg *ChromemConfig) (*ChromemManager, error) {
    client := chromem.NewClient(cfg.URL)
    
    // Determine which embedding function to use
    var ef embeddings.EmbeddingFunction
    var err error
    
    if cfg.DefaultEmbeddingFunction != nil {
        // Use the provided embedding function
        ef = cfg.DefaultEmbeddingFunction
    } else if cfg.CerebrasConfig != nil {
        // Create a Cerebras embedding function from the configuration
        ef, err = createCerebrasEmbeddingFunction(cfg.CerebrasConfig)
        if err != nil {
            return nil, fmt.Errorf("failed to create Cerebras embedding function: %w", err)
        }
    }
    // If both are nil, ef will be nil and ChromemDB will use its default embedding function

    // Get or create collections
    txColl, err := client.GetOrCreateCollection(
        context.Background(),
        "transactions",
        nil, // metadata for collection itself
        ef,  // embedding function
    )
    if err != nil {
        return nil, fmt.Errorf("failed to get/create transactions collection: %w", err)
    }

    ctxRecColl, err := client.GetOrCreateCollection(
        context.Background(),
        "context_records",
        nil,
        ef,
    )
    if err != nil {
        return nil, fmt.Errorf("failed to get/create context_records collection: %w", err)
    }

    capDescColl, err := client.GetOrCreateCollection(
        context.Background(),
        "capability_descriptors",
        nil,
        ef,
    )
    if err != nil {
        return nil, fmt.Errorf("failed to get/create capability_descriptors collection: %w", err)
    }

    return &ChromemManager{
        client:              client,
        transactionCollection: txColl,
        contextRecordCollection: ctxRecColl,
        capabilityDescriptorCollection: capDescColl,
        config:              cfg,
    }, nil
}

