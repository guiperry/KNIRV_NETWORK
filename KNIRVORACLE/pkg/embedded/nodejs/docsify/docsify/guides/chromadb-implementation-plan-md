// AddTransaction indexes a transaction in ChromemDB
// Assuming 'tx' is your internal transaction struct, and 'txDataJSON' is the string form of tx.Data
func (m *ChromemManager) AddTransaction(
    txHash, blockHash string,
    blockNumber, value, fee uint64,
    from, to, txType, status, dataType, txDataJSON string,
    timestamp int64,
) error {
    m.mu.Lock()
    defer m.mu.Unlock()

    docID := txHash
    documentContent := txDataJSON // Document for semantic search

    metadata := map[string]interface{}{
        "TransactionHash": txHash, // For metadata filtering
        "BlockHash":       blockHash,
        "BlockNumber":     blockNumber,
        "From":            from,
        "To":              to,
        "Value":           value,
        "Type":            txType,
        "Timestamp":       timestamp,
        "Fee":             fee,
        "Status":          status,
        "DataType":        dataType,
        "CreatedAt":       time.Now().Unix(),
    }

    _, err := m.transactionCollection.Add(
        context.Background(),
        nil, // embeddings - will be generated by ChromemDB if EF is set
        []map[string]interface{}{metadata},
        []string{documentContent},
        []string{docID},
    )
    return err
}

