            ctxRecordIDsToAdd = append(ctxRecordIDsToAdd, id)
            ctxRecordDocsToAdd = append(ctxRecordDocsToAdd, doc)
            ctxRecordMetadatasToAdd = append(ctxRecordMetadatasToAdd, meta)
            log.Printf("ChromemDB: Prepared ContextRecord %s from tx %s", id, tx.TransactionHash)

        case bctypes.TransactionTypeMCPRegisterCapability:
            var registerData mcptypes.MCPRegisterCapabilityData
            if err := json.Unmarshal(tx.Data, &registerData); err != nil {
