// OnBlockOrphaned is called when a block is removed due to a chain reorganization
func (csm *ChromemSyncManager) OnBlockOrphaned(block *bctypes.Block) error {
    csm.mu.Lock()
    defer csm.mu.Unlock()

    blockHeight := block.Header.Height
    log.Printf("ChromemDB: Handling orphaned block %d", blockHeight)

    // Delete records associated with this block using a 'where' filter
    // Note: ChromemDB's Delete method takes IDs or where/whereDocument filters.
    // Deleting by blockHeight is a common pattern.

    // Delete context records
    // Construct where filter for deletion
    whereFilterContext := map[string]interface{}{"BlockHeight": blockHeight}
    deletedCtxCount, err := csm.contextRecordCollection.Delete(context.Background(), nil, whereFilterContext, nil)
    if err != nil {
        log.Printf("Error deleting ContextRecords from orphaned block %d: %v", blockHeight, err)
    } else {
        log.Printf("ChromemDB: Deleted %d ContextRecords from orphaned block %d", deletedCtxCount, blockHeight)
    }

    // Handle capability descriptors
    // First, get all descriptors from the orphaned block
    whereFilterCaps := map[string]interface{}{"BlockHeight": blockHeight}
    orphanedCaps, err := csm.capabilityDescriptorCollection.Get(context.Background(), nil, whereFilterCaps, nil)
    if err != nil {
        log.Printf("Error fetching CapabilityDescriptors from orphaned block %d: %v", blockHeight, err)
    } else {
        var capIDsToDelete []string
        var capIDsToUpdateToLatest []string
        var capMetadatasToUpdateToLatest []map[string]interface{}

        for i, orphanedCapID := range orphanedCaps.IDs {
            capIDsToDelete = append(capIDsToDelete, orphanedCapID)
            metadata := orphanedCaps.Metadatas[i]
            isLatest, ok := metadata["IsLatest"].(bool)
            if ok && isLatest {
                // This was the latest version. We need to find the previous version and mark it as latest.
                capabilityID, _ := metadata["ID"].(string)
                // Query for the most recent version of this capability *before* the orphaned block
                // This requires a more complex query if not using simple IsLatest flags or if versions are embedded in IDs.
                // Assuming we query for ID, IsLatest=false, and sort by BlockTimestamp DESC, LIMIT 1
                // ChromemDB query doesn't directly support sorting in Get or general Query for this update.
                // This part is complex and might require iterating or a more sophisticated state management.
                // A simpler approach: when adding a new "latest", the old one was already marked IsLatest=false.
                // If an "add" of a new latest is orphaned, we need to find the one that *was* latest before it.
                // This means querying for `ID == capabilityID` and `BlockHeight < orphanedBlockHeight`,
                // then finding the one with the max `BlockHeight` (or `BlockTimestamp`) among those.
                
                // Simplified: find the highest blockHeight for this capID that is not the orphaned one
                prevVersions, err := csm.capabilityDescriptorCollection.Query(
                    context.Background(),
                    []string{""}, // No semantic query text, just metadata filter
                    1, // We want the top one
                    map[string]interface{}{
                        "ID": capabilityID,
                        "$and": []map[string]interface{}{ // Ensure not the one we are about to delete
                            {"BlockHeight": map[string]interface{}{"$ne": blockHeight}},
                            // Add other conditions if necessary to ensure it's a valid previous version
                        },
                    },
                    nil, // No where document
                    []string{chromem.ID, chromem.Metadatas}, // Include IDs and Metadatas
                    // ChromemDB Go client Query does not have explicit sort by metadata field.
                    // This logic might need adjustment or multiple steps.
                    // For now, we assume we can find it. If not, this capability might have no prior "latest".
                )
                if err == nil && prevVersions.IDs != nil && len(prevVersions.IDs) > 0 {
                     // Assuming the first result is the one to make latest if sorted properly by Chromem (or post-process)
                    prevCapID := prevVersions.IDs[0]
                    prevMetadata := prevVersions.Metadatas[0]
                    prevMetadata["IsLatest"] = true
                    capIDsToUpdateToLatest = append(capIDsToUpdateToLatest, prevCapID)
                    capMetadatasToUpdateToLatest = append(capMetadatasToUpdateToLatest, prevMetadata)
                } else if err != nil {
                    log.Printf("ChromemDB: Error finding previous version for CapabilityDescriptor %s: %v", capabilityID, err)
                }
            }
        }
        
        if len(capIDsToDelete) > 0 {
            deletedCapCount, err := csm.capabilityDescriptorCollection.Delete(context.Background(), capIDsToDelete, nil, nil)
            if err != nil {
                log.Printf("Error deleting CapabilityDescriptors from orphaned block %d: %v", blockHeight, err)
            } else {
                log.Printf("ChromemDB: Deleted %d CapabilityDescriptors from orphaned block %d", deletedCapCount, blockHeight)
            }
        }

        if len(capIDsToUpdateToLatest) > 0 {
             _, err := csm.capabilityDescriptorCollection.Update(context.Background(), nil, capMetadatasToUpdateToLatest, nil, capIDsToUpdateToLatest)
             if err != nil {
                 log.Printf("ChromemDB: Error restoring IsLatest for %d CapabilityDescriptors: %v", len(capIDsToUpdateToLatest), err)
             } else {
                 log.Printf("ChromemDB: Restored %d CapabilityDescriptors as IsLatest", len(capIDsToUpdateToLatest))
             }
        }
    }


    // Delete transactions
    whereFilterTx := map[string]interface{}{"BlockHeight": blockHeight}
    deletedTxCount, err := csm.transactionCollection.Delete(context.Background(), nil, whereFilterTx, nil)
    if err != nil {
        log.Printf("Error deleting Transactions from orphaned block %d: %v", blockHeight, err)
    } else {
        log.Printf("ChromemDB: Deleted %d Transactions from orphaned block %d", deletedTxCount, blockHeight)
    }

    return nil
}

