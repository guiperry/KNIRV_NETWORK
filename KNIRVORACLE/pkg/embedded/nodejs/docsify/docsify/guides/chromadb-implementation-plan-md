            id, doc, meta := PrepareCapabilityDescriptorForChromemFromRegister(&registerData, tx.TransactionHash, block.Header.Height, block.Header.Timestamp) // Implement this
            meta["IsLatest"] = true
            capDescIDsToAdd = append(capDescIDsToAdd, id)
            capDescDocsToAdd = append(capDescDocsToAdd, doc)
            capDescMetadatasToAdd = append(capDescMetadatasToAdd, meta)
            log.Printf("ChromemDB: Prepared CapabilityDescriptor %s from tx %s", id, tx.TransactionHash)

        case bctypes.TransactionTypeMCPUpdateCapability:
            var updateData mcptypes.MCPUpdateCapabilityData
            if err := json.Unmarshal(tx.Data, &updateData); err != nil {
                log.Printf("Error unmarshalling MCPUpdateCapabilityData for tx %s: %v", tx.TransactionHash, err)
                continue
            }
            
            // Find existing latest capability descriptor to mark as not latest
            // This requires a query then update, or careful ID management.
            // For simplicity, we'll assume an update means adding a new one and marking old one.
            // This part is tricky with batched adds and needs careful thought on atomicity or multi-step processing.
            // A simpler approach for Chromem might be to just add the new one as IsLatest=true.
            // And rely on queries with sorting by BlockHeight/Timestamp and filtering by ID to find the "actual" latest.
            // Or, perform a separate update for the old one.
            
            // Find the current "latest" version of this capability ID
            queryResult, err := csm.capabilityDescriptorCollection.Get(
                context.Background(),
                nil, // no ids
                map[string]interface{}{"ID": updateData.CapabilityID, "IsLatest": true}, // where
                nil, // no whereDocument
            )
            if err == nil && len(queryResult.IDs) > 0 {
                for i := range queryResult.IDs {
                    oldID := queryResult.IDs[i]
                    oldMetadata := queryResult.Metadatas[i]
                    oldMetadata["IsLatest"] = false
                    capDescIDsToUpdateOld = append(capDescIDsToUpdateOld, oldID)
                    capDescMetadatasToUpdateOld = append(capDescMetadatasToUpdateOld, oldMetadata)
                }
            } else if err != nil {
                 log.Printf("Error querying for old capability %s to update IsLatest: %v", updateData.CapabilityID, err)
            }


            id, doc, meta := PrepareCapabilityDescriptorForChromemFromUpdate(&updateData, tx.TransactionHash, block.Header.Height, block.Header.Timestamp) // Implement this
            meta["IsLatest"] = true
            capDescIDsToAdd = append(capDescIDsToAdd, id)
            capDescDocsToAdd = append(capDescDocsToAdd, doc)
            capDescMetadatasToAdd = append(capDescMetadatasToAdd, meta)
            log.Printf("ChromemDB: Prepared updated CapabilityDescriptor %s from tx %s", id, tx.TransactionHash)
        }
    }

    // Batch add to ChromemDB
    if len(txIDsToAdd) > 0 {
        _, err := csm.transactionCollection.Add(context.Background(), nil, txMetadatasToAdd, txDocsToAdd, txIDsToAdd)
        if err != nil {
            log.Printf("Error batch writing Transactions to ChromemDB: %v", err)
            // Consider error handling strategy: retry, log and skip, etc.
        } else {
            log.Printf("ChromemDB: Added %d transactions.", len(txIDsToAdd))
        }
    }
    if len(ctxRecordIDsToAdd) > 0 {
        _, err := csm.contextRecordCollection.Add(context.Background(), nil, ctxRecordMetadatasToAdd, ctxRecordDocsToAdd, ctxRecordIDsToAdd)
