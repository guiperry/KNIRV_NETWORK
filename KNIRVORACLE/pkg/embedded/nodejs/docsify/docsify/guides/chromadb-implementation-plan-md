// Example for ContextRecord
// (Assuming mcptypes.ContextRecord is your Go struct)

func PrepareContextRecordForChromem(cr *mcptypes.ContextRecord, txHash string, blockHeight int64, blockTimestamp int64) (
    id string,
    documentForEmbedding string, // Renamed for clarity
    metadata map[string]interface{},
) {
    id = cr.ID
    
    // Document for semantic search (natural language representation)
    // This is what gets embedded - a coherent text description rather than JSON
    documentForEmbedding = fmt.Sprintf("Context record for capability %s. Status: %s. Invoked by %s, provided by %s. Error: %s. Initiated at %s, completed at %s.",
        cr.CapabilityID, 
        string(cr.Status), 
        cr.InvokerNRN, 
        cr.ProviderNRN, 
        cr.Error,
        time.Unix(cr.TimestampInitiated, 0).Format(time.RFC3339),
        time.Unix(cr.TimestampCompleted, 0).Format(time.RFC3339)) // Added timestamps for more context
    
    // Create full JSON representation for storage/retrieval (optional to store in Chromem metadata)
    documentObj := map[string]interface{}{
        "record_type": "context_record",
        "schema_version": "1.0",
        "capability_id": cr.CapabilityID,
        "status": string(cr.Status),
        "invoker": cr.InvokerNRN,
        "provider": cr.ProviderNRN,
        "error": cr.Error,
    }
    fullRecordJSONBytes, _ := json.MarshalIndent(documentObj, "", "  ")

    // Metadata follows a consistent structure for filtering
    metadata = map[string]interface{}{
        "ID":                 cr.ID, // Storing in metadata for exact matches too
        "CapabilityID":       cr.CapabilityID,
        "InvokerNRN":         cr.InvokerNRN,
        "ProviderNRN":        cr.ProviderNRN,
        "Status":             string(cr.Status),
        "InputDataHash":      cr.InputDataHash,
        "OutputDataHash":     cr.OutputDataHash,
        "Error":              cr.Error,
        "TimestampInitiated": cr.TimestampInitiated,
        "TimestampCompleted": cr.TimestampCompleted,
        "GasFeeNRN":          cr.GasFeeNRN,
        "TransactionHash":    txHash,
        "BlockHeight":        blockHeight,
        "BlockTimestamp":     blockTimestamp,
        "SchemaVersion":      "1.0", // Include schema version in metadata
        "RecordType":         "context_record", // Explicit record type for filtering
        "FullRecordJSON":     string(fullRecordJSONBytes), // Optional: store full JSON in metadata
    }
    return
}

// PrepareTransactionForChromem converts a Transaction to ChromemDB format
func PrepareTransactionForChromem(tx *bctypes.Transaction, blockHeight int64, blockTimestamp int64) (
    id string,
    documentForEmbedding string,
    metadata map[string]interface{},
) {
    id = tx.TransactionHash
    
    // For Transaction.Data, we need to ensure it's properly formatted JSON
    var dataObj interface{}
    var dataType string
    var dataDescription string
    
    // First try to unmarshal the data to get its structure
    if err := json.Unmarshal(tx.Data, &dataObj); err != nil {
        // If not valid JSON, use the raw data as a string
        dataDescription = string(tx.Data)
        dataType = "unknown"
    } else {
        // Try to create a meaningful description of the data
        dataDescription = createDataDescription(dataObj, string(tx.Type))
        dataType = string(tx.Type)
    }
    
    // Create a natural language description for embedding
    // This is what gets embedded - a coherent text description rather than JSON
    documentForEmbedding = fmt.Sprintf("Transaction of type '%s' from '%s'", string(tx.Type), tx.From)
    if tx.To != "" {
        documentForEmbedding += fmt.Sprintf(" to '%s'", tx.To)
    }
    documentForEmbedding += fmt.Sprintf(" with value %d and fee %d. Timestamp: %s. Data: %s", 
        tx.Value, 
        tx.Fee, 
        time.Unix(tx.Timestamp, 0).Format(time.RFC3339),
        dataDescription)
    
    // Store the full enriched data as JSON for retrieval if needed
    enrichedDataObj := map[string]interface{}{
        "transaction_type": string(tx.Type),
        "schema_version": "1.0",
        "data": dataObj,
        "timestamp": tx.Timestamp,
        "from_address": tx.From,
    }
    if tx.To != "" {
        enrichedDataObj["to_address"] = tx.To
    }
    enrichedBytes, _ := json.MarshalIndent(enrichedDataObj, "", "  ")

    // Consistent metadata structure for filtering
    metadata = map[string]interface{}{
        "TransactionHash": tx.TransactionHash,
        "BlockHash":       tx.BlockHash,
        "BlockNumber":     blockHeight,
        "From":            tx.From,
        "To":              tx.To,
        "Value":           tx.Value,
        "Type":            string(tx.Type),
        "Timestamp":       tx.Timestamp,
        "Fee":             tx.Fee,
        "Status":          "confirmed", // Assuming confirmed if in a block
        "DataType":        dataType,
        "CreatedAt":       time.Now().Unix(),
        "BlockHeight":     blockHeight,
        "BlockTimestamp":  blockTimestamp,
        "SchemaVersion":   "1.0",
        "RecordType":      "transaction",
        "FullDataJSON":    string(enrichedBytes), // Store full JSON in metadata
    }
    return
}

// Helper function to create a meaningful description of transaction data
func createDataDescription(dataObj interface{}, txType string) string {
    // This would be implemented based on your transaction types
    // For example, for a capability registration:
    // "Registration of capability 'Image Generator' (version 1.0) of type TOOL owned by nrn:user:alice"
    
    // For now, a simple fallback:
    dataBytes, err := json.Marshal(dataObj)
    if err != nil {
        return "Unknown data format"
    }
    
    // Limit the length to avoid overly long embeddings
    if len(dataBytes) > 500 {
        return fmt.Sprintf("%s... (truncated)", string(dataBytes[:500]))
    }
    return string(dataBytes)
}

// PrepareCapabilityDescriptorForChromemFromRegister converts a capability descriptor from registration data
func PrepareCapabilityDescriptorForChromemFromRegister(data *mcptypes.MCPRegisterCapabilityData, txHash string, blockHeight int64, blockTimestamp int64) (
    id string,
    documentForEmbedding string,
    metadata map[string]interface{},
) {
    // Extract capability ID and other details from the descriptor
    capID := GetCapabilityIDFromDescriptor(data.CapabilityDescriptor)
    capType := GetCapabilityTypeFromDescriptor(data.CapabilityDescriptor)
    name := GetCapabilityNameFromDescriptor(data.CapabilityDescriptor)
    description := GetCapabilityDescriptionFromDescriptor(data.CapabilityDescriptor)
    owner := GetCapabilityOwnerFromDescriptor(data.CapabilityDescriptor)
    version := GetCapabilityVersionFromDescriptor(data.CapabilityDescriptor)
    
    id = capID
    
    // Create a natural language summary for embedding
    // This is what gets embedded - a coherent text description rather than JSON
    documentForEmbedding = fmt.Sprintf("Capability '%s': %s (version %s). Type: %s. Owner: %s. Registered at %s.", 
        name, 
        description, 
        version, 
        capType, 
        owner,
        time.Unix(blockTimestamp, 0).Format(time.RFC3339))
    
    // Create structured document for storage
    documentObj := map[string]interface{}{
        "record_type": "capability_descriptor",
        "schema_version": "1.0",
        "capability_id": capID,
        "capability_type": capType,
        "name": name,
        "description": description,
        "owner": owner,
        "version": version,
    }
    documentBytes, _ := json.MarshalIndent(documentObj, "", "  ")
    
    // Store the full descriptor as JSON for retrieval
    fullDescriptorJSON, _ := json.Marshal(data.CapabilityDescriptor)
    
    // Consistent metadata structure
    metadata = map[string]interface{}{
        "ID":                capID,
        "Name":              name,
        "Owner":             owner,
        "Version":           version,
        "Description":       description,
        "CapabilityType":    capType,
        "RegisteredAt":      blockTimestamp,
        "TransactionHash":   txHash,
        "BlockHeight":       blockHeight,
        "BlockTimestamp":    blockTimestamp,
        "IsLatest":          true,
        "FullDescriptorJSON": string(fullDescriptorJSON),
        "StructuredJSON":    string(documentBytes),
        "SchemaVersion":     "1.0",
        "RecordType":        "capability_descriptor",
    }
    return
}

