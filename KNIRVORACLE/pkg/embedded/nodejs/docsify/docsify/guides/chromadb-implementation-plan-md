            log.Printf("ChromemDB: Added %d context records.", len(ctxRecordIDsToAdd))
        }
    }
    
    // Update old capabilities first
    if len(capDescIDsToUpdateOld) > 0 {
        // ChromemDB's Go client might not have a direct batch update metadata.
        // It has `collection.Update()` which can update documents, metadatas, embeddings by ID.
        // We only want to update metadata.
        // If embeddings and documents are nil, only metadata should be updated for the given IDs.
        _, err := csm.capabilityDescriptorCollection.Update(
            context.Background(),
            nil, // embeddings
            capDescMetadatasToUpdateOld,
            nil, // documents
