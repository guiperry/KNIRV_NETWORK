        // If semanticQuery is empty, we could return an error or default to a non-semantic Get.
        if semanticQuery == "" && len(where) == 0 {
            return nil, fmt.Errorf("search requires a semantic query or at least one filter")
        }
        // If semanticQuery is empty but 'where' is present, we still need a query_text for Query method.
        // A placeholder or a very generic text might be used, or this indicates a different type of query.
        // For simplicity, let's assume semanticQuery is usually present for this "Search" endpoint.
        // If not, the behavior of Query with empty queryTexts and only where clause needs to be tested.
        queryTexts = []string{""} // Placeholder if semanticQuery is empty but filters exist. Behavior depends on EF.
    }
    
    // Calculate offset for pagination
    offset := (page - 1) * nResults

    // Query ChromemDB
    // Note: The Go client's QueryBuilder or direct Query method.
    // The `Query` method in the Go client takes `offset` as part of `QueryOptions`.
    // Let's assume we are using a version or method that supports offset.
    // The current `chroma-go` client's `Query` method takes `nResults` but not directly `offset`.
    // Pagination with `Query` often means fetching `page * nResults` and slicing, or if the API supports offset.
    // For this example, we'll assume `nResults` is the primary control, and `page` implies fetching more and skipping.
    // A more robust pagination would require `collection.Get` with limit & offset if not doing semantic search,
    // or fetching `page * nResults` for semantic search and then taking the desired slice.
    // Let's fetch up to `page * nResults` and then slice.
    
    effectiveNResults := page * nResults // Fetch enough to cover up to the current page

    results, err := m.transactionCollection.Query(
        context.Background(),
        queryTexts,
        int32(effectiveNResults), // Number of results
        where,
        nil, // WhereDocument filter (for filtering on the document text itself)
        []types.QueryEnum{types.Metadatas, types.Distances, types.Documents}, // Include what you need
    )
    if err != nil {
        return nil, fmt.Errorf("chromemdb query failed: %w", err)
    }

    // Apply pagination (manual slicing after fetching enough results)
    startIndex := (page - 1) * nResults
    endIndex := startIndex + nResults
    if startIndex >= len(results.IDs) {
        return []YourApiTransaction{}, nil // Page out of bounds
    }
    if endIndex > len(results.IDs) {
        endIndex = len(results.IDs)
    }

    paginatedIDs := results.IDs[startIndex:endIndex]
    paginatedMetadatas := results.Metadatas[startIndex:endIndex]
    paginatedDistances := results.Distances[startIndex:endIndex]
    // paginatedDocuments := results.Documents[startIndex:endIndex] // If included and needed


    apiResults := make([]YourApiTransaction, len(paginatedIDs))
    for i, id := range paginatedIDs {
        metadata := paginatedMetadatas[i]
        // Convert metadata map to YourApiTransaction struct
        // This requires careful type assertions from map[string]interface{}
        txHash, _ := metadata["TransactionHash"].(string)
        // ... populate other fields ...
        
        apiResults[i] = YourApiTransaction{
            TransactionHash: txHash,
            // ... other fields from metadata ...
        }
        if len(paginatedDistances) > i && semanticQuery != "" {
            score := float32(paginatedDistances[i]) // Chromem distances might need conversion to similarity
            apiResults[i].SimilarityScore = &score
        }
    }

    return apiResults, nil
}



