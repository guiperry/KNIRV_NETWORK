# KNIRV Discourse Forum - Netlify Functions Configuration
# Copy this file to .config in the netlify/functions/ directory and update with your values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Database type: 'json' (default) or 'supabase'
DB_TYPE=json

# JSON Database Configuration (default)
# Data will be stored in JSON files in the data/ directory
# No additional configuration needed for JSON mode

# ===========================================
# SUPABASE CONFIGURATION (optional fallback)
# ===========================================

# Supabase project URL (only needed if DB_TYPE=supabase)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (only needed if DB_TYPE=supabase)
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# AUTHENTICATION CONFIGURATION
# ===========================================

# JWT Secret Key (generate a strong random string)
# You can generate one at: https://www.allkeysgenerator.com/Random/Security-Encryption-Key-Generator.aspx
JWT_SECRET=knirv-discourse-forum-jwt-secret-key-2024-production-secure-random-string-for-authentication-tokens

# JWT Token Expiration (in seconds)
# 86400 = 24 hours, 604800 = 7 days
JWT_EXPIRATION=86400

# Remember me token expiration (in seconds)
# 2592000 = 30 days
JWT_REMEMBER_EXPIRATION=2592000

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email From Address
EMAIL_FROM=forum@knirv.network
EMAIL_FROM_NAME=KNIRV Forum

# Email Templates
EMAIL_TEMPLATE_PATH=./email-templates

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================

# Maximum file size in bytes (10MB = 10485760)
MAX_FILE_SIZE=10485760

# Maximum number of files per post
MAX_FILES_PER_POST=5

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,text/plain,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# File storage configuration
# Options: 'local', 'aws-s3', 'cloudinary'
FILE_STORAGE=local

# Local file storage path (relative to function)
LOCAL_UPLOAD_PATH=../../uploads

# ===========================================
# AWS S3 CONFIGURATION (if using S3)
# ===========================================

AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ===========================================
# CLOUDINARY CONFIGURATION (if using Cloudinary)
# ===========================================

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===========================================
# FORUM CONFIGURATION
# ===========================================

# Forum Settings
FORUM_TITLE=KNIRV Forum
FORUM_DESCRIPTION=KNIRV Network Community Forum
FORUM_URL=https://forum.knirv.network

# Company Information
COMPANY_NAME=KNIRV Network
COMPANY_URL=https://knirv.network
SUPPORT_EMAIL=support@knirv.com

# Default Settings
DEFAULT_TRUST_LEVEL=0
DEFAULT_CATEGORY=general
AUTO_APPROVE_POSTS=false
REQUIRE_EMAIL_VERIFICATION=true

# Posting Limits
MAX_POST_LENGTH=32000
MAX_TOPIC_TITLE_LENGTH=255
MIN_POST_LENGTH=20
MIN_TOPIC_TITLE_LENGTH=15

# User Limits
MAX_USERNAME_LENGTH=20
MIN_USERNAME_LENGTH=3
MAX_NAME_LENGTH=255

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://forum.knirv.network,https://knirv.network

# Enable/disable registration
ALLOW_REGISTRATION=true

# Password requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_SPECIAL_CHARS=false
REQUIRE_UPPERCASE=false
REQUIRE_NUMBERS=true

# Trust levels
TRUST_LEVEL_0_REQUIREMENTS=0
TRUST_LEVEL_1_REQUIREMENTS=5
TRUST_LEVEL_2_REQUIREMENTS=50
TRUST_LEVEL_3_REQUIREMENTS=250

# ===========================================
# NOTIFICATION CONFIGURATION
# ===========================================

# Enable email notifications
ENABLE_EMAIL_NOTIFICATIONS=true

# Admin notification email
ADMIN_EMAIL=admin@knirv.com

# Notification types to send
NOTIFY_NEW_TOPIC=true
NOTIFY_NEW_POST=true
NOTIFY_MENTIONS=true
NOTIFY_REPLIES=true
NOTIFY_LIKES=false

# Digest emails
ENABLE_DIGEST_EMAILS=true
DIGEST_FREQUENCY=weekly

# ===========================================
# MODERATION CONFIGURATION
# ===========================================

# Auto-moderation
AUTO_FLAG_THRESHOLD=5
AUTO_HIDE_THRESHOLD=3
AUTO_SILENCE_THRESHOLD=10

# Spam detection
ENABLE_SPAM_DETECTION=true
SPAM_SCORE_THRESHOLD=0.8

# Content filtering
ENABLE_PROFANITY_FILTER=false
PROFANITY_WORDS=

# ===========================================
# SEARCH CONFIGURATION
# ===========================================

# Search settings
ENABLE_SEARCH=true
SEARCH_MIN_LENGTH=3
SEARCH_MAX_RESULTS=50

# Search indexing
ENABLE_SEARCH_INDEXING=true
SEARCH_INDEX_FREQUENCY=hourly

# ===========================================
# LOGGING CONFIGURATION
# ===========================================

# Log level: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# Log file path (for local development)
LOG_FILE_PATH=./logs/discourse.log

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================

# Environment: 'development', 'staging', 'production'
NODE_ENV=production

# Enable debug mode
DEBUG=false

# Enable detailed error messages (only for development)
DETAILED_ERRORS=false

# Database connection pool settings
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000

# ===========================================
# CACHE CONFIGURATION
# ===========================================

# Enable caching
ENABLE_CACHE=true

# Cache TTL in seconds
CACHE_TTL=300

# Cache provider: 'memory', 'redis'
CACHE_PROVIDER=memory

# Redis configuration (if using Redis)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# ===========================================
# ANALYTICS CONFIGURATION
# ===========================================

# Google Analytics tracking ID
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Enable usage analytics
ENABLE_ANALYTICS=false

# ===========================================
# BACKUP CONFIGURATION
# ===========================================

# Enable automatic backups
ENABLE_BACKUPS=false

# Backup frequency (in hours)
BACKUP_FREQUENCY=24

# Backup retention (in days)
BACKUP_RETENTION=30

# Backup storage location
BACKUP_STORAGE=local
BACKUP_PATH=./backups

# ===========================================
# INTEGRATION CONFIGURATION
# ===========================================

# Slack webhook URL for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Discord webhook URL for notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# Enable webhook notifications
ENABLE_SLACK_NOTIFICATIONS=false
ENABLE_DISCORD_NOTIFICATIONS=false

# ===========================================
# THEME CONFIGURATION
# ===========================================

# Theme settings
PRIMARY_COLOR=#667eea
SECONDARY_COLOR=#764ba2
ACCENT_COLOR=#f093fb

# Logo settings
LOGO_URL=/img/logo.png
FAVICON_URL=/img/favicon.png

# Custom CSS URL (optional)
CUSTOM_CSS_URL=

# Custom JavaScript URL (optional)
CUSTOM_JS_URL=

# ===========================================
# MAINTENANCE MODE
# ===========================================

# Enable maintenance mode
MAINTENANCE_MODE=false

# Maintenance message
MAINTENANCE_MESSAGE=The forum is currently under maintenance. Please try again later.

# Maintenance end time (ISO 8601 format)
MAINTENANCE_END_TIME=2024-12-31T23:59:59Z

# ===========================================
# PERFORMANCE CONFIGURATION
# ===========================================

# Topics per page
TOPICS_PER_PAGE=30

# Posts per page
POSTS_PER_PAGE=20

# Search results per page
SEARCH_RESULTS_PER_PAGE=20

# Maximum concurrent connections
MAX_CONCURRENT_CONNECTIONS=100

# Request timeout (in milliseconds)
REQUEST_TIMEOUT=30000
