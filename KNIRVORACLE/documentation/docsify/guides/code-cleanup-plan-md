5. Update the NodeJSManager to handle the Developer Portal:
   - Add a StartDeveloperPortal method to `nodejsmanager.go`:
   ```go
   // StartDeveloperPortal starts the developer portal service
   func (m *NodeJSManager) StartDeveloperPortal() error {
       m.mutex.Lock()
       defer m.mutex.Unlock()

       if !m.Config.Enabled || !m.Config.DeveloperPortal.Enabled {
           return fmt.Errorf("developer portal service is not enabled in configuration")
       }

       // Check if already running
       if _, exists := m.Processes["developer-portal"]; exists {
           return fmt.Errorf("developer portal service is already running")
       }

       scriptPath := m.Config.DeveloperPortal.ScriptPath
       if scriptPath == "" {
           return fmt.Errorf("no script path provided for developer portal service")
       }

       // Check if the script exists
       if _, err := os.Stat(scriptPath); os.IsNotExist(err) {
           return fmt.Errorf("script not found for developer portal service: %s", scriptPath)
       }

       // Find available port
       actualHTTPPort := utils.FindAvailablePort(uint64(m.Config.DeveloperPortal.HTTPPort))
       if actualHTTPPort != uint64(m.Config.DeveloperPortal.HTTPPort) {
           log.Printf("[DeveloperPortal] HTTP Port %d in use, using %d instead.", 
               m.Config.DeveloperPortal.HTTPPort, actualHTTPPort)
       }

       // Prepare environment variables
       env := []string{
           fmt.Sprintf("HTTP_API_PORT=%d", actualHTTPPort),
           fmt.Sprintf("API_KEY=%s", m.Config.DeveloperPortal.APIKey),
           fmt.Sprintf("NODE_ENV=%s", "production"), // Set to production by default
           fmt.Sprintf("CHAIN_ID=%s", m.PeerID),
       }

       // Prepare the command
       cmd := exec.Command("node", scriptPath)
       cmd.Env = append(os.Environ(), env...)

       // Capture stdout and stderr
       stdout, err := cmd.StdoutPipe()
       if err != nil {
           return fmt.Errorf("failed to get stdout pipe for developer portal: %w", err)
       }
       stderr, err := cmd.StderrPipe()
       if err != nil {
           return fmt.Errorf("failed to get stderr pipe for developer portal: %w", err)
       }

       // Start the process
       if err := cmd.Start(); err != nil {
           return fmt.Errorf("failed to start developer portal: %w", err)
       }

       // Create a process object
       process := &NodeJSProcess{
           Name:       "DeveloperPortal",
           Cmd:        cmd,
           StdoutPipe: bufio.NewScanner(stdout),
           StderrPipe: bufio.NewScanner(stderr),
           StopChan:   make(chan struct{}),
       }

       // Store the process
       m.Processes["developer-portal"] = process

       // Start goroutines to handle stdout and stderr
       go func() {
           for process.StdoutPipe.Scan() {
               log.Printf("[DeveloperPortal] %s", process.StdoutPipe.Text())
           }
       }()

       go func() {
           for process.StderrPipe.Scan() {
               log.Printf("[DeveloperPortal ERROR] %s", process.StderrPipe.Text())
           }
       }()

       // Start a goroutine to wait for the process to exit
       go func() {
           if err := cmd.Wait(); err != nil {
               log.Printf("[DeveloperPortal] Process exited with error: %v", err)
           } else {
               log.Printf("[DeveloperPortal] Process exited successfully")
           }
           m.mutex.Lock()
           delete(m.Processes, "developer-portal")
           m.mutex.Unlock()
       }()

       log.Printf("[DeveloperPortal] Started successfully on port %d", actualHTTPPort)
       return nil
   }
   ```

6. Update the StartServices method to include the Developer Portal:
   ```go
   // StartServices starts all enabled Node.js services
   func (m *NodeJSManager) StartServices() []error {
       var errors []error

       if m.Config.TunnelRegistry.Enabled {
           if err := m.StartTunnelRegistry(); err != nil {
               errors = append(errors, fmt.Errorf("failed to start tunnel registry service: %w", err))
           }
       }

       if m.Config.PaymentGateway.Enabled {
           if err := m.StartPaymentGateway(); err != nil {
               errors = append(errors, fmt.Errorf("failed to start payment gateway service: %w", err))
           }
       }

       if m.Config.DeveloperPortal.Enabled {
           if err := m.StartDeveloperPortal(); err != nil {
               errors = append(errors, fmt.Errorf("failed to start developer portal service: %w", err))
           }
       }

       return errors
   }
   ```

