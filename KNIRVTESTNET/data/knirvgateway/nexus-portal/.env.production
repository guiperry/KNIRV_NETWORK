# NEXUS Portal Production Environment Configuration

# API Configuration
VITE_API_BASE_URL=/.netlify/functions
VITE_SSE_BASE_URL=/.netlify/functions/gateway-sse
VITE_NEXUS_API_URL=/.netlify/functions/gateway-sse

# Real-time Configuration
VITE_ENABLE_REAL_TIME=true
VITE_SSE_RECONNECT_INTERVAL=5000
VITE_SSE_MAX_RECONNECT_ATTEMPTS=10

# Environment Settings
NODE_ENV=production
VITE_TESTNET_MODE=true
VITE_DEBUG_MODE=false

# Authentication Configuration
VITE_AUTH_TOKEN_KEY=nexus_auth_token
VITE_AUTH_REFRESH_INTERVAL=3600000

# UI Configuration
VITE_THEME=knirv
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_NOTIFICATIONS=true

# Feature Flags
VITE_ENABLE_ROLE_BASED_UI=true
VITE_ENABLE_REAL_TIME_METRICS=true
VITE_ENABLE_ADVANCED_MONITORING=true

# Network Configuration
VITE_NETWORK_NAME=KNIRV NEXUS
VITE_CHAIN_ID=knirv-nexus-mainnet
VITE_NETWORK_TYPE=testnet

# Monitoring Configuration
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_LOG_LEVEL=info
