# KNIRV TESTNET Gateway Redirects Configuration
# Optimized for local developer use - minimal, focused routing

# Core Gateway API endpoints for testnet
/gateway/health /.netlify/functions/gateway-health 200
/gateway/services /.netlify/functions/gateway-services 200
/gateway/testnet/status /.netlify/functions/gateway-testnet-status 200

# Testnet Authentication endpoints
/auth/testnet-tokens /.netlify/functions/auth-testnet-tokens 200
/auth/validate /.netlify/functions/auth-testnet-tokens 200

# SSE endpoints for real-time updates
/gateway-sse /.netlify/functions/gateway-sse 200
/testnet-sse /.netlify/functions/testnet-sse 200

# Health monitoring for testnet
/health-monitor /.netlify/functions/health-monitor 200

# GraphChain Explorer (local testnet version)
/graphchain-explorer/* /graphchain-explorer/:splat 200

# NEXUS Portal - redirect to local KNIRVNEXUS instance
/nexus-portal/* http://localhost:8084/:splat 302
/nexus/* http://localhost:8084/:splat 302

# Agent Developer Portal - redirect to main KNIRVGATEWAY
/agent-developer-portal/* https://knirv.com/agent-developer-portal/:splat 302
/agent-portal/* https://knirv.com/agent-developer-portal/:splat 302

# Static assets for testnet-gateway
/assets/* /assets/:splat 200
/js/* /js/:splat 200
/css/* /css/:splat 200
/images/* /images/:splat 200

# Default fallback to testnet landing page
/* /index.html 200
