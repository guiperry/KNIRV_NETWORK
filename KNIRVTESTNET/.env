# KNIRV-TESTNET Environment Configuration
KNIRV_NETWORK=testnet
KNIRV_CHAIN_ID=knirv-testnet-1

# Service Ports
KNIRVROOT_PORT=1317
KNIRVCHAIN_PORT=8080
KNIRVGRAPH_PORT=8081
KNIRVNEXUS_PORT_1=8082
KNIRVNEXUS_PORT_2=8083
KNIRVROUTER_PORT=8086
KNIRVGATEWAY_PORT=8087

# External Services
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080
XION_TESTNET_RPC=https://testnet-rpc.xion.burnt.com

# Security
JWT_SECRET=testnet-secret-key
KEYRING_BACKEND=test

# Development
DEBUG_MODE=true
LOG_LEVEL=info
MOCK_TEE=true

# Mock LLM API Keys for Testnet
GEMINI_API_KEY=mock_gemini_api_key_for_testnet
GEMINI_MODEL_NAME=gemini-1.5-flash-latest
DEEPSEEK_API_KEY=mock_deepseek_api_key_for_testnet
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL_NAME=deepseek-chat
CEREBRAS_API_KEY=mock_cerebras_api_key_for_testnet
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1/chat/completions
CEREBRAS_MODEL_NAME=llama-4-scout-17b-16e-instruct

# Testnet mode settings
TESTNET_MODE=true
MOCK_LLM_PROVIDERS=true
INSTALL_COMPLETE=true
