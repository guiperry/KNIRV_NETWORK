# KNIRV-TESTNET Environment Configuration
# Contains ONLY environment-specific variables and secrets
# All configuration parameters are in config/ folder
# All external service settings are in config/testnet-config.yaml

KNIRV_NETWORK=testnet
KNIRV_CHAIN_ID=knirv-testnet-1

# Security Secrets
JWT_SECRET=testnet-secret-key
KEYRING_BACKEND=test

# Cloudflare DNS configuration
CLOUDFLARE_API_TOKEN=y6MzHS7KiGvQr1WUggHEM53gHAd_-bztr2qCuTZO
CLOUDFLARE_ZONE_ID=6ec647f95e75c97a504c40a5e07e4e52

# AWS Configuration - REPLACE WITH YOUR VALID CREDENTIALS
# Get these from AWS Console → IAM → Users → Your User → Security Credentials
AWS_ACCESS_KEY_ID=AKIAY4MRKMJN7UE2CYNK
AWS_SECRET_ACCESS_KEY=XAYlarDurMXJlvy+BtCdW3xHOvSUoEIS71YJv1So
AWS_DEFAULT_REGION=us-east-2

# Automatic EBS root volume expansion (optional)
# Set to true to allow the deployment script to increase the root EBS volume
# when disk usage is critically high. Requires the AWS credentials above to
# have permissions for ec2:DescribeInstances, ec2:DescribeVolumes,
# ec2:ModifyVolume and ec2:DescribeVolumesModifications. Growth amount (GiB)
# can be adjusted with ROOT_VOLUME_GROW_GB (default 20 GiB).
AUTO_INCREASE_ROOT_VOLUME=false
ROOT_VOLUME_GROW_GB=20



# Development Settings (move to config files if these become configuration parameters)
DEBUG_MODE=true
LOG_LEVEL=info
MOCK_TEE=true

# Runtime Environment
NODE_ENV=testnet
DEPLOYMENT_ENV=testnet

# Security Secrets (environment-specific)
JWT_SECRET=knirv100


# Mock LLM API Keys for Testnet
GEMINI_API_KEY=mock_gemini_api_key_for_testnet
GEMINI_MODEL_NAME=gemini-1.5-flash-latest
DEEPSEEK_API_KEY=mock_deepseek_api_key_for_testnet
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL_NAME=deepseek-chat
CEREBRAS_API_KEY=mock_cerebras_api_key_for_testnet
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1/chat/completions
CEREBRAS_MODEL_NAME=llama-4-scout-17b-16e-instruct

# Testnet mode settings (move to config files if these become configuration parameters)
TESTNET_MODE=true
MOCK_LLM_PROVIDERS=true
INSTALL_COMPLETE=true
