### Phase 5: Page-Specific Implementations

1. **Blockchain Explorer Page (formerly Blockchain page)**
   - Create a blockchain explorer page to display blockchain data:
   ```javascript
   // src/pages/explorer.js
   import { useEffect, useState } from 'react';
   import { useBlockchain } from '../contexts/BlockchainContext';
   import { useBackend } from '../contexts/BackendContext';
   import styles from './explorer.module.css';

   export default function Explorer() {
     const { blocks, isLoading, refreshData } = useBlockchain();
     const { isRunning, serverInfo } = useBackend();
     const [selectedBlock, setSelectedBlock] = useState(null);

     useEffect(() => {
       if (isRunning) {
         refreshData();
       }
     }, [isRunning, refreshData]);

     const handleBlockClick = (block) => {
       setSelectedBlock(block);
     };

     if (!isRunning) {
       return <div className={styles.notRunning}>Backend is not running. Please start the KNIRVORACLE node.</div>;
     }

     if (isLoading) {
       return <div className={styles.loading}>Loading chain data...</div>;
     }

     return (
       <div className={styles.container}>
         <h1>KNIRVORACLE Explorer</h1>
         
         {serverInfo && (
           <div className={styles.serverInfo}>
             <h2>Node Information</h2>
             <div>Chain ID: {serverInfo.chain_id}</div>
             <div>HTTP Port: {serverInfo.http_port}</div>
             <div>P2P Port: {serverInfo.p2p_port}</div>
             <div>Version: {serverInfo.version}</div>
             <div>Connected Peers: {serverInfo.connections}</div>
           </div>
         )}
         
         <div className={styles.blockchainInfo}>
           <div className={styles.blockList}>
             <h2>Blocks</h2>
             {blocks.length === 0 ? (
               <div className={styles.emptyState}>No blocks found</div>
             ) : (
               blocks.map((block) => (
                 <div 
                   key={block.hash} 
                   className={styles.blockItem}
                   onClick={() => handleBlockClick(block)}
                 >
                   <div>Block #{block.index || block.height}</div>
                   <div>Hash: {block.hash.substring(0, 10)}...</div>
                   <div>Timestamp: {new Date(block.timestamp * 1000).toLocaleString()}</div>
                 </div>
               ))
             )}
           </div>
           
           {selectedBlock && (
             <div className={styles.blockDetails}>
               <h2>Block Details</h2>
               <div>Hash: {selectedBlock.hash}</div>
               <div>Previous Hash: {selectedBlock.previous_hash || selectedBlock.prevHash}</div>
               <div>Timestamp: {new Date(selectedBlock.timestamp * 1000).toLocaleString()}</div>
               <div>Nonce: {selectedBlock.nonce}</div>
               
               <h3>Transactions</h3>
               {selectedBlock.data && selectedBlock.data.length === 0 ? (
                 <div className={styles.emptyState}>No transactions in this block</div>
               ) : (
                 (selectedBlock.data || []).map((transaction, index) => (
                   <div key={index} className={styles.transaction}>
                     <div>ID: {transaction.id}</div>
                     <div>
                       <strong>From:</strong> {transaction.input?.address || transaction.sender}
                     </div>
                     <div>
                       <strong>To:</strong> {transaction.output ? 
                         Object.keys(transaction.output).filter(addr => addr !== transaction.input?.address).join(', ') : 
                         transaction.recipient}
                     </div>
                     <div>
                       <strong>Amount:</strong> {transaction.output ? 
                         Object.values(transaction.output).reduce((sum, val) => sum + val, 0) : 
                         transaction.amount}
                     </div>
                   </div>
                 ))
               )}
             </div>
           )}
         </div>
       </div>
     );
   }
   ```

2. **Add Capabilities Page (Redesigned from Inventory Page)**
   - Create a page for adding new capabilities to the blockchain:
   ```javascript
   // src/pages/add-capability.js
   import { useState } from 'react';
   import { useBackend } from '../contexts/BackendContext';
   import api from '../utils/api';
   import styles from './add-capability.module.css';

   export default function AddCapability() {
     const { isRunning } = useBackend();
     const [formData, setFormData] = useState({
       capabilityType: '',
       desiredName: '',
       description: '',
       descriptor: {},
       fee: 10
     });
     const [customFields, setCustomFields] = useState([{ key: '', value: '' }]);
     const [isLoading, setIsLoading] = useState(false);
     const [error, setError] = useState('');
     const [success, setSuccess] = useState('');

     const handleInputChange = (e) => {
       const { name, value } = e.target;
       setFormData({
         ...formData,
         [name]: value
       });
     };

     const handleCustomFieldChange = (index, field, value) => {
       const updatedFields = [...customFields];
       updatedFields[index][field] = value;
       setCustomFields(updatedFields);
     };

     const addCustomField = () => {
       setCustomFields([...customFields, { key: '', value: '' }]);
     };

     const removeCustomField = (index) => {
       const updatedFields = [...customFields];
       updatedFields.splice(index, 1);
       setCustomFields(updatedFields);
     };

     const handleSubmit = async (e) => {
       e.preventDefault();
       setIsLoading(true);
       setError('');
       setSuccess('');

       try {
         // Build descriptor from custom fields
         const descriptor = {};
         customFields.forEach(field => {
           if (field.key && field.value) {
             descriptor[field.key] = field.value;
           }
         });

         const payload = {
           ...formData,
           descriptor,
           fee: parseInt(formData.fee)
         };

         // Call the MCP capability registration endpoint
         const response = await api.post('/mcp/capability/prepare_registration', payload);
         
         setSuccess(`Capability registration prepared successfully! ID: ${response.data.capability_id}`);
         setFormData({
           capabilityType: '',
           desiredName: '',
           description: '',
           descriptor: {},
           fee: 10
         });
         setCustomFields([{ key: '', value: '' }]);
       } catch (error) {
         setError(error.response?.data?.message || 'Failed to register capability');
       } finally {
         setIsLoading(false);
       }
     };

     if (!isRunning) {
       return <div className={styles.notRunning}>Backend is not running. Please start the KNIRVORACLE node.</div>;
     }

     return (
       <div className={styles.container}>
         <h1>Add New Capability</h1>
         
         {error && <div className={styles.error}>{error}</div>}
         {success && <div className={styles.success}>{success}</div>}
         
         <form onSubmit={handleSubmit} className={styles.form}>
           <div className={styles.formGroup}>
             <label htmlFor="capabilityType">Capability Type</label>
             <select
               id="capabilityType"
               name="capabilityType"
               value={formData.capabilityType}
               onChange={handleInputChange}
               required
             >
               <option value="">Select a type</option>
               <option value="NFT">NFT</option>
               <option value="DeFi">DeFi</option>
               <option value="DAO">DAO</option>
               <option value="Custom">Custom</option>
             </select>
           </div>
           
           <div className={styles.formGroup}>
             <label htmlFor="desiredName">Name</label>
             <input
               id="desiredName"
               name="desiredName"
               type="text"
               value={formData.desiredName}
               onChange={handleInputChange}
               placeholder="Enter capability name"
               required
             />
           </div>
           
           <div className={styles.formGroup}>
             <label htmlFor="description">Description</label>
             <textarea
               id="description"
               name="description"
               value={formData.description}
               onChange={handleInputChange}
               placeholder="Describe what this capability does"
               rows={4}
               required
             />
           </div>
           
           <div className={styles.formGroup}>
             <label htmlFor="fee">Registration Fee</label>
             <input
               id="fee"
               name="fee"
               type="number"
               value={formData.fee}
               onChange={handleInputChange}
               min={1}
               required
             />
           </div>
           
           <div className={styles.customFieldsSection}>
             <h3>Custom Properties</h3>
             {customFields.map((field, index) => (
               <div key={index} className={styles.customFieldRow}>
                 <input
                   type="text"
                   placeholder="Property name"
                   value={field.key}
                   onChange={(e) => handleCustomFieldChange(index, 'key', e.target.value)}
                 />
                 <input
                   type="text"
                   placeholder="Value"
                   value={field.value}
                   onChange={(e) => handleCustomFieldChange(index, 'value', e.target.value)}
                 />
                 <button 
                   type="button" 
                   onClick={() => removeCustomField(index)}
                   className={styles.removeButton}
                 >
                   Remove
                 </button>
               </div>
             ))}
             <button 
               type="button" 
               onClick={addCustomField}
               className={styles.addButton}
             >
               Add Property
             </button>
           </div>
           
           <button 
             type="submit" 
             className={styles.submitButton}
             disabled={isLoading}
           >
             {isLoading ? 'Registering...' : 'Register Capability'}
           </button>
         </form>
       </div>
     );
   }
   ```

3. **Capabilities List Page (Redesigned from DAOs Page)**
   - Create a page to list and manage capabilities:
   ```javascript
   // src/pages/capabilities.js
   import { useEffect, useState } from 'react';
   import { useBackend } from '../contexts/BackendContext';
   import api from '../utils/api';
   import styles from './capabilities.module.css';

